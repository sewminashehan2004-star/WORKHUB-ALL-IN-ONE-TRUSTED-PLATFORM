@using Microsoft.AspNetCore.Http
@using System

@{
    var fullName = Context.Session.GetString("FullName");
    var role = Context.Session.GetString("Role") ?? string.Empty;

    var isLoggedIn = !string.IsNullOrWhiteSpace(fullName);

    var firstName =
        !string.IsNullOrWhiteSpace(fullName)
            ? fullName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault()
            : null;

    var userInitial =
        !string.IsNullOrWhiteSpace(firstName)
            ? firstName.Substring(0, 1).ToUpperInvariant()
            : "U";

    var imageVersion = DateTime.UtcNow.Ticks;

    /* =========================================================
       CURRENT PAGE
    ========================================================== */

    var currentPath = Context.Request.Path.Value ?? "/";

    if (currentPath.Length > 1)
    {
        currentPath = currentPath.TrimEnd('/');
    }

    string IsActive(string path)
    {
        var cleanPath = path.TrimEnd('/');

        if (cleanPath == "")
            cleanPath = "/";

        return string.Equals(
            currentPath,
            cleanPath,
            StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

    string IsActiveStartsWith(string path)
    {
        var cleanPath = path.TrimEnd('/');

        if (cleanPath == "")
            cleanPath = "/";

        return currentPath.StartsWith(
            cleanPath,
            StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - WorkHub
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/workhub-final.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/workhub-product.css"
          asp-append-version="true" />


<style>

/* =========================================================
   WORKHUB MODERN ORANGE THEME
   ========================================================= */

:root {

    --orange: #ff5a00;
    --orange-dark: #e64d00;
    --orange-light: #fff3eb;
    --orange-soft: #fff8f4;
    --orange-border: #ffd4bd;

    --dark: #111827;
    --dark-2: #1f2937;

    --gray: #64748b;
    --light-gray: #f8fafc;

    --white: #ffffff;

    --shadow:
        0 10px 30px rgba(15, 23, 42, 0.08);

    --shadow-orange:
        0 10px 25px rgba(255, 90, 0, 0.20);
}


/* =========================================================
   GLOBAL
   ========================================================= */

html {
    scroll-behavior: smooth;
}


body {

    margin: 0;

    padding: 0;

    background: #ffffff;

    color: var(--dark);

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

    min-height: 100vh;

    display: flex;

    flex-direction: column;
}


main {

    flex: 1;
}


/* =========================================================
   HEADER
   ========================================================= */

.main-header {

    position: sticky;

    top: 0;

    z-index: 1000;

    width: 100%;

    background:
        rgba(255, 255, 255, 0.96);

    backdrop-filter: blur(14px);

    -webkit-backdrop-filter: blur(14px);

    border-bottom:
        1px solid rgba(226, 232, 240, 0.85);

    box-shadow:
        0 4px 20px rgba(15, 23, 42, 0.05);
}


/* =========================================================
   NAV WRAPPER
   ========================================================= */

.nav-wrapper {

    width: 100%;

    max-width: 1450px;

    margin: auto;

    min-height: 76px;

    padding:
        0 28px;

    display: flex;

    align-items: center;

    gap: 25px;
}


/* =========================================================
   BRAND
   ========================================================= */

.brand {

    display: inline-flex;

    align-items: center;

    text-decoration: none;

    font-size: 27px;

    font-weight: 850;

    letter-spacing: -1px;

    color: var(--dark);

    white-space: nowrap;

    transition:
        transform 0.25s ease;
}


.brand span {

    color: var(--orange);

    margin-left: 2px;
}


.brand:hover {

    color: var(--dark);

    transform: translateY(-1px);
}


/* =========================================================
   DESKTOP NAVIGATION
   ========================================================= */

.main-nav {

    display: flex;

    align-items: center;

    gap: 4px;

    flex: 1;
}


.main-nav a {

    position: relative;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding:
        11px 14px;

    color: #334155;

    text-decoration: none;

    font-size: 16px;

    font-weight: 650;

    border-radius: 10px;

    white-space: nowrap;

    transition:
        color 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease;
}


/* =========================================================
   NAV HOVER
   ========================================================= */

.main-nav a:hover {

    color: var(--orange);

    background: var(--orange-light);

    transform: translateY(-1px);
}


/* =========================================================
   NAV UNDERLINE
   ========================================================= */

.main-nav a::after {

    content: "";

    position: absolute;

    left: 14px;

    right: 14px;

    bottom: 3px;

    height: 3px;

    background:
        linear-gradient(
            90deg,
            var(--orange),
            #ff7a33
        );

    border-radius: 20px;

    transform:
        scaleX(0);

    transform-origin: center;

    transition:
        transform 0.28s ease;
}


/* =========================================================
   HOVER UNDERLINE
   ========================================================= */

.main-nav a:hover::after {

    transform:
        scaleX(1);
}


/* =========================================================
   ACTIVE PAGE
   ========================================================= */

.main-nav a.active {

    color: var(--orange);

    background:
        var(--orange-soft);

    font-weight: 800;

    box-shadow:
        inset 0 0 0 1px
        rgba(255, 90, 0, 0.04);
}


.main-nav a.active::after {

    transform:
        scaleX(1);
}


/* =========================================================
   ACTIVE PAGE GLOW
   ========================================================= */

.main-nav a.active::before {

    content: "";

    position: absolute;

    left: 50%;

    bottom: -2px;

    width: 28px;

    height: 7px;

    transform:
        translateX(-50%);

    background:
        rgba(255, 90, 0, 0.18);

    filter:
        blur(7px);

    border-radius: 50%;
}


/* =========================================================
   ACCOUNT AREA
   ========================================================= */

.nav-actions {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-left: auto;
}


/* =========================================================
   LOGIN
   ========================================================= */

.login-link {

    color: #334155;

    text-decoration: none;

    font-size: 15px;

    font-weight: 700;

    padding:
        10px 14px;

    border-radius: 9px;

    transition:
        color 0.25s ease,
        background 0.25s ease;
}


.login-link:hover {

    color: var(--orange);

    background:
        var(--orange-light);
}


/* =========================================================
   SIGN UP
   ========================================================= */

.signup-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #ff6508,
            #f04b00
        );

    color: white !important;

    border: none;

    padding:
        11px 20px;

    border-radius: 10px;

    font-size: 15px;

    font-weight: 750;

    text-decoration: none;

    cursor: pointer;

    box-shadow:
        0 7px 18px
        rgba(255, 90, 0, 0.20);

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
}


.signup-button:hover {

    color: white !important;

    background:
        linear-gradient(
            135deg,
            #f45100,
            #d94200
        );

    transform:
        translateY(-2px);

    box-shadow:
        0 12px 25px
        rgba(255, 90, 0, 0.30);
}


/* =========================================================
   PROFILE AREA
   ========================================================= */

.logged-user-area {

    position: relative;
}


.profile-menu-button {

    display: flex;

    align-items: center;

    gap: 10px;

    background: white;

    border:
        1px solid #e2e8f0;

    padding:
        6px 10px 6px 7px;

    border-radius: 13px;

    cursor: pointer;

    transition:
        all 0.25s ease;
}


.profile-menu-button:hover,
.profile-menu-button.active {

    background:
        var(--orange-soft);

    border-color:
        var(--orange-border);

    box-shadow:
        0 8px 22px
        rgba(255, 90, 0, 0.12);
}


/* =========================================================
   PROFILE AVATAR
   ========================================================= */

.nav-profile-avatar {

    position: relative;

    width: 40px;

    height: 40px;

    border-radius: 50%;

    overflow: hidden;

    flex-shrink: 0;

    background:
        linear-gradient(
            135deg,
            #ff6b12,
            #e94800
        );

    box-shadow:
        0 0 0 2px white,
        0 0 0 3px var(--orange-border);
}


.nav-profile-image {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    object-fit: cover;

    z-index: 2;
}


.nav-profile-fallback {

    position: absolute;

    inset: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    font-size: 16px;

    font-weight: 800;

    z-index: 1;
}


/* =========================================================
   PROFILE TEXT
   ========================================================= */

.profile-button-content {

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    min-width: 65px;
}


.profile-small-text {

    font-size: 10px;

    color: #94a3b8;

    font-weight: 650;

    text-transform: uppercase;

    letter-spacing: 0.5px;
}


.profile-user-name {

    font-size: 14px;

    font-weight: 800;

    color: var(--dark);

    max-width: 110px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =========================================================
   PROFILE ARROW
   ========================================================= */

.profile-arrow {

    width: 17px;

    height: 17px;

    color: #64748b;

    transition:
        transform 0.25s ease;
}


.profile-menu-button.active .profile-arrow {

    transform:
        rotate(180deg);

    color: var(--orange);
}


/* =========================================================
   PROFILE DROPDOWN
   ========================================================= */

.profile-dropdown {

    position: absolute;

    top: calc(100% + 12px);

    right: 0;

    width: 250px;

    background: white;

    border:
        1px solid #e2e8f0;

    border-radius: 16px;

    padding: 8px;

    box-shadow:
        0 20px 50px
        rgba(15, 23, 42, 0.15);

    opacity: 0;

    visibility: hidden;

    transform:
        translateY(-8px)
        scale(0.98);

    transition:
        opacity 0.2s ease,
        visibility 0.2s ease,
        transform 0.2s ease;
}


.profile-dropdown.open {

    opacity: 1;

    visibility: visible;

    transform:
        translateY(0)
        scale(1);
}


/* =========================================================
   DROPDOWN HEADER
   ========================================================= */

.dropdown-user-header {

    padding:
        13px 13px 14px;

    border-bottom:
        1px solid #f1f5f9;

    margin-bottom: 5px;
}


.dropdown-welcome {

    color: #94a3b8;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.6px;
}


.dropdown-user-name {

    margin-top: 3px;

    color: var(--dark);

    font-size: 15px;

    font-weight: 800;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =========================================================
   DROPDOWN LINKS
   ========================================================= */

.profile-dropdown-link,
.dropdown-logout-button {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 11px;

    padding:
        11px 12px;

    border-radius: 10px;

    border: none;

    background: transparent;

    text-decoration: none;

    color: #475569;

    font-size: 14px;

    font-weight: 650;

    cursor: pointer;

    transition:
        all 0.2s ease;
}


.profile-dropdown-link svg,
.dropdown-logout-button svg {

    width: 18px;

    height: 18px;

    flex-shrink: 0;
}


.profile-dropdown-link:hover {

    background:
        var(--orange-light);

    color:
        var(--orange);

    transform:
        translateX(2px);
}


.dropdown-logout-button {

    color: #dc2626;
}


.dropdown-logout-button:hover {

    background:
        #fef2f2;

    color:
        #b91c1c;
}


/* =========================================================
   MOBILE MENU BUTTON
   ========================================================= */

.mobile-menu-button {

    display: none;

    border: none;

    background:
        var(--orange-light);

    color:
        var(--orange);

    width: 42px;

    height: 42px;

    border-radius: 10px;

    font-size: 23px;

    cursor: pointer;

    transition:
        all 0.25s ease;
}


.mobile-menu-button:hover {

    background:
        var(--orange);

    color: white;

    transform:
        scale(1.04);
}


/* =========================================================
   MOBILE NAV
   ========================================================= */

.mobile-nav {

    display: none;

    max-width: 1450px;

    margin: auto;

    padding:
        10px 20px 18px;
}


.mobile-nav.open {

    display: block;

    animation:
        mobileMenuOpen
        0.25s ease;
}



}


/* =========================================================
   MOBILE LINKS
   ========================================================= */

.mobile-nav > a {

    position: relative;

    display: block;

    padding:
        13px 15px;

    margin-bottom: 3px;

    color: #334155;

    text-decoration: none;

    font-size: 16px;

    font-weight: 650;

    border-radius: 10px;

    transition:
        all 0.25s ease;
}


.mobile-nav > a:hover {

    background:
        var(--orange-light);

    color:
        var(--orange);

    padding-left: 20px;
}


/* =========================================================
   MOBILE ACTIVE PAGE
   ========================================================= */

.mobile-nav > a.active {

    color:
        var(--orange);

    background:
        var(--orange-light);

    font-weight: 800;

    padding-left: 20px;
}


.mobile-nav > a.active::before {

    content: "";

    position: absolute;

    left: 0;

    top: 8px;

    bottom: 8px;

    width: 4px;

    background:
        var(--orange);

    border-radius:
        0 5px 5px 0;
}


/* =========================================================
   MOBILE USER
   ========================================================= */

.mobile-user-area {

    margin-top: 10px;

    padding-top: 10px;

    border-top:
        1px solid #e2e8f0;
}


.mobile-profile-link {

    display: flex !important;

    align-items: center;

    gap: 12px;
}


.mobile-profile-photo {

    position: relative;

    width: 38px;

    height: 38px;

    border-radius: 50%;

    overflow: hidden;

    background:
        var(--orange);

    flex-shrink: 0;
}


.mobile-profile-photo img {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    object-fit: cover;

    z-index: 2;
}


.mobile-profile-initial {

    position: absolute;

    inset: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    font-weight: 800;

    z-index: 1;
}


.mobile-logout-form {

    margin-top: 5px;
}


.mobile-logout-button {

    width: 100%;

    padding:
        11px 15px;

    border: none;

    border-radius: 9px;

    background:
        #fef2f2;

    color:
        #dc2626;

    font-weight: 700;

    cursor: pointer;
}


.mobile-logout-button:hover {

    background:
        #fee2e2;
}


/* =========================================================
   FOOTER
   ========================================================= */

.workhub-footer {

    margin-top: 70px;

    background:
        linear-gradient(
            135deg,
            #111827,
            #172033
        );

    color: #cbd5e1;

    position: relative;

    overflow: hidden;
}


/* Orange top line */

.workhub-footer::before {

    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 4px;

    background:
        linear-gradient(
            90deg,
            #ff4d00,
            #ff7a33,
            #ff4d00
        );
}


/* =========================================================
   FOOTER CONTAINER
   ========================================================= */

.footer-container {

    max-width: 1450px;

    margin: auto;

    padding:
        55px 28px 30px;

    display: grid;

    grid-template-columns:
        1.5fr 1fr 1fr 1fr;

    gap: 45px;
}


/* =========================================================
   FOOTER BRAND
   ========================================================= */

.footer-brand {

    max-width: 360px;
}


.footer-logo {

    display: inline-block;

    font-size: 27px;

    font-weight: 850;

    color: white;

    text-decoration: none;

    margin-bottom: 15px;
}


.footer-logo span {

    color:
        var(--orange);
}


.footer-description {

    color:
        #94a3b8;

    font-size: 14px;

    line-height: 1.8;

    margin: 0;
}


/* =========================================================
   FOOTER HEADINGS
   ========================================================= */

.footer-column h4 {

    color: white;

    font-size: 15px;

    font-weight: 800;

    margin:
        0 0 18px;

    position: relative;
}


.footer-column h4::after {

    content: "";

    display: block;

    width: 30px;

    height: 3px;

    margin-top: 8px;

    background:
        var(--orange);

    border-radius: 10px;
}


/* =========================================================
   FOOTER LINKS
   ========================================================= */

.footer-column a {

    display: block;

    color:
        #94a3b8;

    text-decoration: none;

    font-size: 14px;

    margin-bottom: 11px;

    transition:
        all 0.2s ease;
}


.footer-column a:hover {

    color:
        var(--orange);

    transform:
        translateX(4px);
}


/* =========================================================
   FOOTER BOTTOM
   ========================================================= */

.footer-bottom {

    border-top:
        1px solid
        rgba(255,255,255,0.08);

    max-width: 1394px;

    margin: auto;

    padding:
        20px 28px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    font-size: 13px;

    color:
        #64748b;
}


.footer-bottom strong {

    color:
        #94a3b8;
}


/* =========================================================
   WHATSAPP BUTTON
   ========================================================= */

.workhub-whatsapp {

    position: fixed;

    right: 25px;

    bottom: 25px;

    width: 58px;

    height: 58px;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        #25D366;

    color: white;

    border-radius: 50%;

    text-decoration: none;

    box-shadow:
        0 10px 25px
        rgba(37, 211, 102, 0.30);

    z-index: 2000;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}


.workhub-whatsapp:hover {

    color: white;

    transform:
        translateY(-5px)
        scale(1.05);

    box-shadow:
        0 15px 30px
        rgba(37, 211, 102, 0.40);
}


.whatsapp-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 31px;

    height: 31px;
}


.whatsapp-icon svg {

    width: 31px;

    height: 31px;
}


/* =========================================================
   WHATSAPP TOOLTIP
   ========================================================= */

.whatsapp-tooltip {

    position: absolute;

    right: 68px;

    top: 50%;

    transform:
        translateY(-50%)
        translateX(8px);

    background:
        #111827;

    color: white;

    padding:
        7px 11px;

    border-radius: 7px;

    font-size: 12px;

    font-weight: 650;

    white-space: nowrap;

    opacity: 0;

    visibility: hidden;

    transition:
        all 0.2s ease;
}


.workhub-whatsapp:hover .whatsapp-tooltip {

    opacity: 1;

    visibility: visible;

    transform:
        translateY(-50%)
        translateX(0);
}


/* =========================================================
   TABLET
   ========================================================= */

@@media (max-width: 1150px) {

    .nav-wrapper {

        padding:
            0 20px;

        gap: 15px;
    }


    .main-nav {

        gap: 0;
    }


    .main-nav a {

        padding:
            10px 9px;

        font-size: 14px;
    }


    .brand {

        font-size: 24px;
    }


    .profile-button-content {

        display: none;
    }


    .profile-menu-button {

        padding: 6px 8px;
    }


    .footer-container {

        grid-template-columns:
            1.5fr 1fr 1fr;

    }

}


/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 900px) {

    .main-nav {

        display: none;
    }


    .mobile-menu-button {

        display: flex;

        align-items: center;

        justify-content: center;

        margin-left: auto;
    }


    .nav-actions {

        margin-left: auto;
    }


    .login-link,
    .signup-button {

        display: none;
    }


    .nav-wrapper {

        min-height: 68px;
    }


    .footer-container {

        grid-template-columns:
            1fr 1fr;

        gap: 35px;
    }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@@media (max-width: 600px) {

    .nav-wrapper {

        padding:
            0 15px;
    }


    .brand {

        font-size: 23px;
    }


    .mobile-nav {

        padding:
            8px 15px 15px;
    }


    .footer-container {

        grid-template-columns:
            1fr;

        padding:
            45px 22px 25px;

        gap: 30px;
    }


    .footer-bottom {

        padding:
            18px 22px;

        flex-direction: column;

        text-align: center;
    }


    .workhub-whatsapp {

        width: 52px;

        height: 52px;

        right: 17px;

        bottom: 17px;
    }


    .whatsapp-tooltip {

        display: none;
    }

}


/* =========================================================
   EXTRA SMALL
   ========================================================= */

@@media (max-width: 400px) {

    .profile-menu-button {

        padding: 5px;
    }


    .nav-profile-avatar {

        width: 37px;

        height: 37px;
    }

}

</style>

</head>


<body>


<!-- =========================================================
     HEADER
========================================================== -->

<header class="main-header">

    <div class="nav-wrapper">


        <!-- LOGO -->

        <a href="/"
           class="brand">

            Work<span>Hub</span>

        </a>


        <!-- =====================================================
             DESKTOP NAVIGATION
        ====================================================== -->

        <nav class="main-nav">


            <a href="/"
               class="@IsActive("/")">

                Home

            </a>


            <a href="/Jobs"
               class="@IsActiveStartsWith("/Jobs")">

                Jobs

            </a>


            <a href="/Services"
               class="@IsActiveStartsWith("/Services")">

                Services

            </a>


            @if (
                isLoggedIn &&
                string.Equals(
                    role,
