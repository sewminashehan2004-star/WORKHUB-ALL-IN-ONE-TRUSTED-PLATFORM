@model WorkHub_Admin.Models.AdminInquiryDetailsViewModel

@{
    Layout = null;
    ViewData["Title"] = "Inquiry Details";

    var isReplied =
        string.Equals(
            Model.Status,
            "Replied",
            StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        WorkHub Admin - Inquiry #@Model.InquiryId
    </title>

    <style>

            /* =========================================================
                       WORKHUB ADMIN - INQUIRY DETAILS
                       PROFESSIONAL UI
                    ========================================================== */

            :root {
                --orange: #FD5000;
                --orange-dark: #D94700;
                --orange-hover: #E94A00;
                --orange-light: #FF7A33;
                --orange-soft: #FFF5F0;
                --orange-soft-2: #FFF9F6;
                --orange-border: #FFD5C2;
                --dark: #101828;
                --dark-2: #1D2939;
                --text: #475467;
                --text-secondary: #667085;
                --text-light: #98A2B3;
                --border: #E4E7EC;
                --border-soft: #F0F2F5;
                --background: #F7F8FA;
                --white: #FFFFFF;
                --green: #067647;
                --green-dark: #05603A;
                --green-soft: #ECFDF3;
                --yellow: #B54708;
                --yellow-soft: #FFFAEB;
                --red: #B42318;
                --red-soft: #FEF3F2;
                --shadow-sm: 0 2px 8px rgba(16, 24, 40, 0.04);
                --shadow: 0 8px 28px rgba(16, 24, 40, 0.07);
                --shadow-hover: 0 14px 38px rgba(16, 24, 40, 0.10);
            }

            * {
                box-sizing: border-box;
            }

            html {
                font-size: 16px;
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                font-size: 16px;
                line-height: 1.6;
                background: linear-gradient(180deg, #FFFFFF 0px, var(--background) 280px);
                color: var(--dark);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            button,
            textarea,
            input,
            select {
                font: inherit;
            }

            a {
                color: inherit;
            }

            /* =========================================================
                       TOP BAR
                    ========================================================== */

            .topbar {
                position: sticky;
                top: 0;
                z-index: 1000;
                min-height: 82px;
                padding: 0 36px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                border-bottom: 1px solid var(--border-soft);
                background: rgba(255, 255, 255, 0.97);
                box-shadow: 0 2px 14px rgba(16, 24, 40, 0.05);
                backdrop-filter: blur(14px);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .logo {
                width: 46px;
                height: 46px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 13px;
                background: linear-gradient(135deg, #FF6A21, var(--orange));
                color: #FFFFFF;
                font-size: 21px;
                font-weight: 900;
                box-shadow: 0 6px 18px rgba(253, 80, 0, 0.25);
            }

            .brand strong {
                display: block;
                color: var(--dark);
                font-size: 20px;
                line-height: 1.2;
                font-weight: 900;
                letter-spacing: -0.4px;
            }

            .brand span {
                display: block;
                margin-top: 3px;
                color: var(--text-secondary);
                font-size: 12px;
                line-height: 1.3;
                font-weight: 600;
            }

            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 9px;
            }

            .back-button,
            .dashboard-button {
                min-height: 43px;
                padding: 0 16px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--border);
                border-radius: 9px;
                background: #FFFFFF;
                color: var(--text);
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                box-shadow: 0 1px 3px rgba(16, 24, 40, 0.03);
                transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
            }

                .back-button:hover,
                .dashboard-button:hover {
                    color: var(--orange);
                    border-color: var(--orange-border);
                    background: var(--orange-soft);
                    transform: translateY(-1px);
                    box-shadow: 0 5px 14px rgba(253, 80, 0, 0.08);
                }

            /* =========================================================
                       CONTENT
                    ========================================================== */

            .content {
                width: calc(100% - 48px);
                max-width: 1250px;
                margin: 0 auto;
                padding: 42px 0 90px;
            }

            .page-title {
                margin-bottom: 30px;
            }

            .page-eyebrow {
                display: block;
                margin-bottom: 8px;
                color: var(--orange);
                font-size: 12px;
                font-weight: 850;
                text-transform: uppercase;
                letter-spacing: 1.25px;
            }

            .page-title-row {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 12px;
            }

            .page-title h1 {
                margin: 0;
                color: var(--dark);
                font-size: clamp(32px, 4vw, 40px);
                line-height: 1.15;
                font-weight: 900;
                letter-spacing: -1px;
            }

            .page-title p {
                margin: 9px 0 0;
                color: var(--text-secondary);
                font-size: 14px;
                font-weight: 500;
            }

            /* =========================================================
                       STATUS
                    ========================================================== */

            .status {
                min-height: 28px;
                padding: 4px 10px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.25px;
                text-transform: uppercase;
                white-space: nowrap;
            }

                .status::before {
                    content: "";
                    width: 7px;
                    height: 7px;
                    flex-shrink: 0;
                    border-radius: 50%;
                }

            .status-new {
                border: 1px solid #FEDF89;
                background: var(--yellow-soft);
                color: var(--yellow);
            }

                .status-new::before {
                    background: #F79009;
                }

            .status-replied {
                border: 1px solid #ABEFC6;
                background: var(--green-soft);
                color: var(--green);
            }

                .status-replied::before {
                    background: #17B26A;
                }

            /* =========================================================
                       MESSAGES
                    ========================================================== */

            .message {
                margin-bottom: 22px;
                padding: 14px 17px;
                border-radius: 10px;
                font-size: 14px;
                line-height: 1.5;
                font-weight: 700;
            }

            .success {
                border: 1px solid #ABEFC6;
                background: var(--green-soft);
                color: var(--green);
            }

            .error {
                border: 1px solid #FECDCA;
                background: var(--red-soft);
                color: var(--red);
            }

            /* =========================================================
                       MAIN GRID
                    ========================================================== */

            .grid {
                display: grid;
                grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.65fr);
                gap: 24px;
                align-items: start;
            }

            /* =========================================================
                       PANELS
                    ========================================================== */

            .panel {
                margin-bottom: 24px;
                padding: 28px;
                border: 1px solid var(--border);
                border-radius: 16px;
                background: #FFFFFF;
                box-shadow: var(--shadow);
                transition: box-shadow 0.25s ease, border-color 0.25s ease;
            }

                .panel:hover {
                    border-color: #DDE1E7;
                    box-shadow: var(--shadow-hover);
                }

            .panel-heading {
                margin-bottom: 22px;
                padding-bottom: 17px;
                border-bottom: 1px solid var(--border-soft);
            }

                .panel-heading h2 {
                    margin: 0 0 6px;
                    color: var(--dark);
                    font-size: 20px;
                    line-height: 1.3;
                    font-weight: 850;
                    letter-spacing: -0.35px;
                }

                .panel-heading p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 14px;
                    line-height: 1.6;
                }

            /* =========================================================
                       META
                    ========================================================== */

            .meta {
                margin-bottom: 23px;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
            }

            .meta-item {
                min-width: 0;
                padding: 15px;
                border: 1px solid #EEF1F4;
                border-radius: 10px;
                background: #F9FAFB;
                transition: border-color 0.2s ease, background 0.2s ease;
            }

                .meta-item:hover {
                    border-color: var(--orange-border);
                    background: var(--orange-soft-2);
                }

                .meta-item > span:first-child {
                    display: block;
                    margin-bottom: 6px;
                    color: var(--text-light);
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                }

                .meta-item strong {
                    display: block;
                    color: var(--dark-2);
                    font-size: 14px;
                    line-height: 1.5;
                    font-weight: 700;
                    overflow-wrap: anywhere;
                }

            /* =========================================================
                       CUSTOMER MESSAGE
                    ========================================================== */

            .customer-message-label {
                margin-bottom: 9px;
                color: var(--dark-2);
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 0.35px;
                text-transform: uppercase;
            }

            .customer-message {
                padding: 20px;
                border: 1px solid #FFE0D1;
                border-left: 4px solid var(--orange);
                border-radius: 0 11px 11px 0;
                background: linear-gradient(135deg, #FFF9F6, #FFFFFF);
                color: #344054;
                font-size: 15px;
                line-height: 1.8;
                font-weight: 450;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            /* =========================================================
                       EXISTING REPLY
                    ========================================================== */

            .existing-reply-section {
                margin-bottom: 24px;
            }

            .existing-reply-title {
                margin-bottom: 10px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
            }

                .existing-reply-title strong {
                    color: var(--green);
                    font-size: 14px;
                    font-weight: 800;
                }

            .existing-reply {
                padding: 18px;
                border: 1px solid #ABEFC6;
                border-radius: 10px;
                background: var(--green-soft);
                color: #166534;
                font-size: 14px;
                line-height: 1.75;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            .reply-meta {
                margin-top: 9px;
                color: var(--text-secondary);
                font-size: 12px;
                line-height: 1.5;
            }

            /* =========================================================
                       REPLY FORM
                    ========================================================== */

            .reply-field label {
                display: block;
                margin-bottom: 9px;
                color: var(--dark-2);
                font-size: 14px;
                font-weight: 750;
            }

            .reply-textarea {
                width: 100%;
                min-height: 220px;
                padding: 16px;
                border: 1px solid #D0D5DD;
                border-radius: 10px;
                outline: none;
                resize: vertical;
                background: #FFFFFF;
                color: var(--dark);
                font-size: 15px;
                line-height: 1.7;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .reply-textarea::placeholder {
                    color: var(--text-light);
                }

                .reply-textarea:hover {
                    border-color: #F9A47B;
                }

                .reply-textarea:focus {
                    border-color: var(--orange);
                    box-shadow: 0 0 0 4px rgba(253, 80, 0, 0.10);
                }

            .reply-bottom {
                margin-top: 9px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .reply-help,
            .character-count {
                color: var(--text-light);
                font-size: 12px;
                font-weight: 500;
            }

            .character-count {
                white-space: nowrap;
            }

            .reply-button {
                min-height: 46px;
                margin-top: 17px;
                padding: 0 22px;
                border: none;
                border-radius: 9px;
                background: linear-gradient(135deg, var(--orange), #FF6A21);
                color: #FFFFFF;
                font-size: 14px;
                font-weight: 800;
                cursor: pointer;
                box-shadow: 0 6px 16px rgba(253, 80, 0, 0.22);
                transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
            }

                .reply-button:hover {
                    background: var(--orange-dark);
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(253, 80, 0, 0.28);
                }

                .reply-button:active {
                    transform: translateY(0);
                }

                .reply-button:disabled {
                    opacity: 0.6;
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                }

            /* =========================================================
                       CUSTOMER CARD
                    ========================================================== */

            .contact-avatar {
                width: 64px;
                height: 64px;
                margin-bottom: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--orange-border);
                border-radius: 16px;
                background: var(--orange-soft);
                color: var(--orange-dark);
                font-size: 23px;
                font-weight: 900;
            }

            .contact-name {
                margin: 0 0 5px;
                color: var(--dark);
                font-size: 18px;
                line-height: 1.35;
                font-weight: 850;
            }

            .contact-email {
                margin-bottom: 20px;
                color: var(--text-secondary);
                font-size: 13px;
                overflow-wrap: anywhere;
            }

            .contact-info {
                display: grid;
                gap: 10px;
            }

            .contact-info-item {
                padding: 13px;
                border: 1px solid #EEF1F4;
                border-radius: 9px;
                background: #F9FAFB;
                transition: background 0.2s ease, border-color 0.2s ease;
            }

                .contact-info-item:hover {
                    border-color: var(--orange-border);
                    background: var(--orange-soft-2);
                }

                .contact-info-item span {
                    display: block;
                    margin-bottom: 4px;
                    color: var(--text-light);
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 0.4px;
                    text-transform: uppercase;
                }

                .contact-info-item strong {
                    display: block;
                    color: var(--dark-2);
                    font-size: 13px;
                    line-height: 1.5;
                    font-weight: 700;
                    overflow-wrap: anywhere;
                }

            .email-link {
                width: 100%;
                min-height: 44px;
                margin-top: 17px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                border: 1px solid var(--orange);
                border-radius: 9px;
                background: #FFFFFF;
                color: var(--orange-dark);
                font-size: 13px;
                font-weight: 800;
                text-decoration: none;
                transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
            }

                .email-link:hover {
                    background: var(--orange);
                    color: #FFFFFF;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(253, 80, 0, 0.18);
                }

            .notice {
                margin-top: 17px;
                padding: 14px;
                border: 1px solid #FED7AA;
                border-radius: 9px;
                background: #FFF7ED;
                color: #9A3412;
                font-size: 12px;
                line-height: 1.65;
            }

            ::selection {
                background: rgba(253, 80, 0, 0.18);
                color: var(--dark);
            }

            /* =========================================================
                       TABLET
                    ========================================================== */

            @@media (max-width: 1000px) {

                .content {
                    max-width: 900px;
                }

                .grid {
                    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.7fr);
                    gap: 18px;
                }

                .panel {
                    padding: 23px;
                }
            }

            /* =========================================================
                       SMALL TABLET
                    ========================================================== */

            @@media (max-width: 820px) {

                .grid {
                    grid-template-columns: 1fr;
                }

                .content {
                    width: calc(100% - 32px);
                }

                .topbar {
                    padding: 0 22px;
                }
            }

            /* =========================================================
                       MOBILE
                    ========================================================== */

            @@media (max-width: 650px) {

                .topbar {
                    position: relative;
                    min-height: auto;
                    padding: 15px 16px;
                    align-items: flex-start;
                    flex-direction: column;
                }

                .topbar-actions {
                    width: 100%;
                }

                .back-button,
                .dashboard-button {
                    flex: 1;
                    min-height: 41px;
                    font-size: 13px;
                }

                .logo {
                    width: 43px;
                    height: 43px;
                    font-size: 19px;
                }

                .brand strong {
                    font-size: 18px;
                }

                .brand span {
                    font-size: 11px;
                }

                .content {
                    width: calc(100% - 22px);
                    padding: 27px 0 60px;
                }

                .page-title {
                    margin-bottom: 22px;
                }

                    .page-title h1 {
                        font-size: 28px;
                    }

                    .page-title p {
                        font-size: 13px;
                    }

                .panel {
                    margin-bottom: 18px;
                    padding: 19px;
                    border-radius: 13px;
                }

                .panel-heading {
                    margin-bottom: 18px;
                    padding-bottom: 14px;
                }

                    .panel-heading h2 {
                        font-size: 18px;
                    }

                    .panel-heading p {
                        font-size: 13px;
                    }

                .meta {
                    grid-template-columns: 1fr;
                }

                .meta-item strong {
                    font-size: 14px;
                }

                .customer-message {
                    padding: 16px;
                    font-size: 14px;
                }

                .reply-textarea {
                    min-height: 190px;
                    font-size: 14px;
                }

                .reply-bottom {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 3px;
                }

                .reply-button {
                    width: 100%;
                    min-height: 46px;
                }
            }

            /* =========================================================
                       VERY SMALL MOBILE
                    ========================================================== */

            @@media (max-width: 430px) {

                .topbar-actions {
                    flex-direction: column;
                }

                .back-button,
                .dashboard-button {
                    width: 100%;
                }

                .page-title h1 {
                    font-size: 25px;
                }

                .panel {
                    padding: 16px;
                }

                .status {
                    font-size: 10px;
                }
            }

    </style>

</head>

<body>

    <!-- =========================================
         TOP BAR
    ========================================= -->

    <header class="topbar">

        <div class="brand">

            <div class="logo">
                W
            </div>

            <div>

                <strong>
                    WorkHub
                </strong>

                <span>
                    Administration · Contact Inquiries
                </span>

            </div>

        </div>

        <div class="topbar-actions">

            <a href="/AdminInquiries/Index"
               class="back-button">

                ← All Inquiries

            </a>

            <a href="/AdminDashboard/Index"
               class="dashboard-button">

                Dashboard

            </a>

        </div>

    </header>

    <!-- =========================================
         CONTENT
    ========================================= -->

    <main class="content">

        <!-- PAGE TITLE -->

        <div class="page-title">

            <span class="page-eyebrow">

                Inquiry #@Model.InquiryId

            </span>

            <div class="page-title-row">

                <h1>
                    @Model.InquiryType
                </h1>

                @if (isReplied)
                {
                    <span class="status status-replied">
                        Replied
                    </span>
                }
                else
                {
                    <span class="status status-new">
                        New
                    </span>
                }

            </div>

            <p>
                Submitted @Model.CreatedDateText
            </p>

        </div>

        <!-- SUCCESS -->
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="message success">
                ✓ @Model.SuccessMessage
            </div>
        }

        <!-- ERROR -->
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="message error">
                @Model.ErrorMessage
            </div>
        }

        <!-- GRID -->

        <div class="grid">

            <!-- =================================
                 LEFT
            ================================== -->

            <div>

                <!-- CUSTOMER INQUIRY -->

                <section class="panel">

                    <div class="panel-heading">

                        <h2>
                            Customer Inquiry
                        </h2>

                        <p>
                            Review the message submitted
                            through the WorkHub Contact page.
                        </p>

                    </div>

                    <div class="meta">

                        <div class="meta-item">

                            <span>
                                Customer
                            </span>

                            <strong>
                                @Model.Name
                            </strong>

                        </div>

                        <div class="meta-item">

                            <span>
                                Email Address
                            </span>

                            <strong>
                                @Model.Email
                            </strong>

                        </div>

                        <div class="meta-item">

                            <span>
                                Topic
                            </span>

                            <strong>
                                @Model.InquiryType
                            </strong>

                        </div>

                        <div class="meta-item">

                            <span>
                                Status
                            </span>

                            @if (isReplied)
                            {
                                <span class="status status-replied">
                                    Replied
                                </span>
                            }
                            else
                            {
                                <span class="status status-new">
                                    New
                                </span>
                            }

                        </div>

                    </div>

                    <div class="customer-message-label">
                        Message
                    </div>

                    <div class="customer-message">
                        @Model.Message
                    </div>

                </section>

                <!-- REPLY -->

                <section class="panel"
                         id="reply">

                    <div class="panel-heading">

                        <h2>

                            @(isReplied
                                ? "Update Reply"
                                : "Reply to Inquiry")

                        </h2>

                        <p>

                            @(isReplied
                                ? "Review or update the response already saved for this inquiry."
                                : "Write a response to this customer inquiry.")

                        </p>

                    </div>

                    <!-- PREVIOUS REPLY -->
                    @if (!string.IsNullOrWhiteSpace(Model.ReplyMessage))
                    {
                        <div class="existing-reply-section">

                            <div class="existing-reply-title">

                                <strong>
                                    Previous Reply
                                </strong>

                                <span class="status status-replied">
                                    Replied
                                </span>

                            </div>

                            <div class="existing-reply">
                                @Model.ReplyMessage
                            </div>

                            <div class="reply-meta">

                                @if (!string.IsNullOrWhiteSpace(Model.RepliedDateText))
                                {
                                    <text>
                                        Replied:
                                        @Model.RepliedDateText
                                    </text>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.RepliedBy))
                                {
                                    <text>
                                        · By:
                                        @Model.RepliedBy
                                    </text>
                                }

                            </div>

                        </div>
                    }

                    <!-- REPLY FORM -->

                    <form action="/AdminInquiries/Reply/@Model.InquiryId"
                          method="post"
                          id="replyForm">

                        @Html.AntiForgeryToken()

                        <div class="reply-field">

                            <label for="replyMessage">

                                @(isReplied
                                    ? "Edit Reply"
                                    : "Your Reply")

                            </label>

                            <textarea name="replyMessage"
                                      id="replyMessage"
                                      class="reply-textarea"
                                      maxlength="4000"
                                      placeholder="Write your reply to @Model.Name..."
                                      required>@Model.ReplyMessage</textarea>

                            <div class="reply-bottom">

                                <span class="reply-help">
                                    Maximum 4,000 characters.
                                </span>

                                <span class="character-count"
                                      id="characterCount">
                                    0 / 4000
                                </span>

                            </div>

                        </div>

                        <button type="submit"
                                class="reply-button"
                                id="replyButton">

                            @(isReplied
                                ? "Update Reply"
                                : "Save Reply")

                        </button>

                    </form>

                </section>

            </div>

            <!-- =================================
                 RIGHT
            ================================== -->

            <div>

                <!-- CUSTOMER -->

                <section class="panel">

                    <div class="panel-heading">

                        <h2>
                            Customer
                        </h2>

                        <p>
                            Contact information associated
                            with this inquiry.
                        </p>

                    </div>

                    <div class="contact-avatar">

                        @(string.IsNullOrWhiteSpace(Model.Name)
                            ? "?"
                            : Model.Name
                                .Substring(0, 1)
                                .ToUpperInvariant())

                    </div>

                    <h3 class="contact-name">
                        @Model.Name
                    </h3>

                    <div class="contact-email">
                        @Model.Email
                    </div>

                    <div class="contact-info">

                        <div class="contact-info-item">

                            <span>
                                Inquiry ID
                            </span>

                            <strong>
                                #@Model.InquiryId
                            </strong>

                        </div>

                        <div class="contact-info-item">

                            <span>
                                Topic
                            </span>

                            <strong>
                                @Model.InquiryType
                            </strong>

                        </div>

                        <div class="contact-info-item">

                            <span>
                                Submitted
                            </span>

                            <strong>
                                @Model.CreatedDateText
                            </strong>

                        </div>

                        <div class="contact-info-item">

                            <span>
                                Current Status
                            </span>

                            <strong>
                                @Model.Status
                            </strong>

                        </div>

                    </div>

                    <a href="mailto:@Model.Email"
                       class="email-link">

                        ✉ Email Customer

                    </a>

                    <div class="notice">

                        Saving a reply in WorkHub stores
                        the response against this inquiry.

                        The Email Customer button opens
                        your email application separately.

                    </div>

                </section>

                <!-- REPLY INFORMATION -->
                @if (isReplied)
                {
                    <section class="panel">

                        <div class="panel-heading">

                            <h2>
                                Reply Information
                            </h2>

                            <p>
                                Latest recorded response details.
                            </p>

                        </div>

                        <div class="contact-info">

                            <div class="contact-info-item">

                                <span>
                                    Status
                                </span>

                                <strong>
                                    Replied
                                </strong>

                            </div>

                            <div class="contact-info-item">

                                <span>
                                    Replied At
                                </span>

                                <strong>

                                    @(string.IsNullOrWhiteSpace(Model.RepliedDateText)
                                        ? "-"
                                        : Model.RepliedDateText)

                                </strong>

                            </div>

                            <div class="contact-info-item">

                                <span>
                                    Replied By
                                </span>

                                <strong>

                                    @(string.IsNullOrWhiteSpace(Model.RepliedBy)
                                        ? "WorkHub Admin"
                                        : Model.RepliedBy)

                                </strong>

                            </div>

                        </div>

                    </section>
                }

            </div>

        </div>

    </main>

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function() {

                    const replyMessage =
                        document.getElementById("replyMessage");

                    const characterCount =
                        document.getElementById("characterCount");

                    const replyForm =
                        document.getElementById("replyForm");

                    const replyButton =
                        document.getElementById("replyButton");

                    function updateCharacterCount() {

                        if (!replyMessage || !characterCount) {
                            return;
                        }

                        const length =
                            replyMessage.value.length;

                        characterCount.textContent =
                            length + " / 4000";
                    }

                    updateCharacterCount();

                    replyMessage?.addEventListener(
                        "input",
                        updateCharacterCount
                    );

                    replyForm?.addEventListener(
                        "submit",
                        function(event) {

                            const message =
                                replyMessage?.value.trim() || "";

                            if (!message) {

                                event.preventDefault();

                                alert(
                                    "Please enter a reply message."
                                );

                                return;
                            }

                            if (message.length > 4000) {

                                event.preventDefault();

                                alert(
                                    "Reply cannot exceed 4000 characters."
                                );

                                return;
                            }

                            if (replyButton) {

                                replyButton.disabled = true;

                                replyButton.textContent =
                                    "Saving Reply...";
                            }
                        }
                    );

                }
            );

    </script>

</body>

</html>