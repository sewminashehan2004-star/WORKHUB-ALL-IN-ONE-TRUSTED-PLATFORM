                            📄
                        </div>

                        <strong>
                            No CV uploaded
                        </strong>

                        <p>
                            Upload one below whenever you are ready.
                        </p>

                    </div>

                }


                <div class="cv-upload-box">


                    <h3>
                        Upload CV
                    </h3>


                    <p>
                        PDF or DOCX only · Maximum file size 5 MB
                    </p>


                    <form asp-controller="JobSeeker"
                          asp-action="UploadCV"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <div class="form-grid">


                            <div class="form-group full">

                                <label>
                                    Select CV File
                                </label>

                                <input type="file"
                                       name="file"
                                       class="form-control-custom"
                                       accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                                       required />

                            </div>


                            <div class="form-group full">

                                <div class="checkbox-row">

                                    <input type="checkbox"
                                           id="isPrimaryCV"
                                           name="isPrimary"
                                           value="true"
                                           checked />

                                    <input type="hidden"
                                           name="isPrimary"
                                           value="false" />

                                    <label for="isPrimaryCV">
                                        Make this my primary CV
                                    </label>

                                </div>

                            </div>


                        </div>


                        <button type="submit"
                                class="primary-button">

                            Upload CV

                        </button>


                    </form>


                </div>

            }


        </div>


    </div>

</section>


@section Scripts
{
    <script>

        function toggleEndDate(
            checkboxId,
            endDateId) {

            const checkbox =
                document.getElementById(
                    checkboxId
                );

            const endDate =
                document.getElementById(
                    endDateId
                );


            if (!checkbox ||
                !endDate) {

                return;
            }


            if (checkbox.checked) {

                endDate.value =
                    "";

                endDate.disabled =
                    true;

                endDate.required =
                    false;

            }
            else {

                endDate.disabled =
                    false;

            }

        }

    </script>
}