</div>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            async function() {

                const home =
                    document.getElementById("workHubHome");

                if (!home) {
                    return;
                }

                const apiBase =
                    home.dataset.apiBase;


                /* =================================================
                   HERO SLIDESHOW
                ================================================= */

                const slides =
                    document.querySelectorAll(".hero-slide");

                const dots =
                    document.querySelectorAll(".hero-dot");

                let currentSlide = 0;

                function showSlide(index) {

                    slides.forEach(
                        function(slide, i) {

                            slide.classList.toggle(
                                "active",
                                i === index
                            );

                        }
                    );

                    dots.forEach(
                        function(dot, i) {

                            dot.classList.toggle(
                                "active",
                                i === index
                            );

                        }
                    );

                    currentSlide = index;
                }

                dots.forEach(
                    function(dot) {

                        dot.addEventListener(
                            "click",
                            function() {

                                showSlide(
                                    Number(
                                        dot.dataset.slide
                                    )
                                );

                            }
                        );

                    }
                );

                setInterval(
                    function() {

                        currentSlide =
                            (currentSlide + 1)
                            % slides.length;

                        showSlide(currentSlide);

                    },
                    6000
                );


                /* =================================================
                   LOAD HOME DATA
                ================================================= */

                try {

                    const response =
                        await fetch(
                            apiBase + "api/Home"
                        );

                    if (!response.ok) {

                        throw new Error(
                            "Unable to load homepage data."
                        );

                    }

                    const data =
                        await response.json();


                    renderJobCategories(
                        data.jobCategories || []
                    );

                    renderServices(
                        data.services || []
                    );

                    renderMarketplace(
                        data.marketplace || []
                    );

                }
                catch (error) {

                    console.error(
                        "WorkHub Home Error:",
                        error
                    );

                    showHomeError();

                }


                /* =================================================
                   JOB CATEGORIES
                ================================================= */

                function renderJobCategories(
                    categories
                ) {

                    const loading =
                        document.getElementById(
                            "jobCategoriesLoading"
                        );

                    const container =
                        document.getElementById(
                            "jobCategoriesContainer"
                        );

                    loading.style.display = "none";


                    if (categories.length === 0) {

                        container.innerHTML =
                            `
                                <div class="home-empty">
                                    No job categories available yet.
                                </div>
                                `;

                        return;
                    }


                    const visibleCategories =
                        categories.slice(0, 6);


                    container.innerHTML =
                        visibleCategories.map(
                            function(category) {

                                return `
                                    <div class="home-card category-card">

                                        <div class="card-image-placeholder category-icon">
                                        </div>

                                        <div class="home-card-content">

                                            <span class="card-category">
                                                ${escapeHtml(category)}
                                            </span>

                                            <h3>
                                                ${escapeHtml(category)}
                                            </h3>

                                            <p>
                                                Find available
                                                ${escapeHtml(category)}
                                                opportunities through WorkHub.
                                            </p>

                                            <a
                                                href="/Jobs?category=${encodeURIComponent(category)}"
                                                class="card-button">

                                                View Jobs

                                            </a>

                                        </div>

                                    </div>
                                    `;

                            }
                        ).join("");

                }


                /* =================================================
                   SERVICES
                ================================================= */

                function renderServices(
                    services
                ) {

                    const loading =
                        document.getElementById(
                            "servicesLoading"
                        );

                    const container =
                        document.getElementById(
                            "servicesContainer"
                        );

                    loading.style.display = "none";


                    if (services.length === 0) {

                        container.innerHTML =
                            `
                                <div class="home-empty">
                                    No services available yet.
                                </div>
                                `;

                        return;
                    }


                    const visibleServices =
                        services.slice(0, 6);


                    container.innerHTML =
                        visibleServices.map(
                            function(service) {

                                const provider =
                                    service.provider
                                        ?.displayName
                                    ||
                                    "Service Provider";


                                const location =
                                    service.location
                                    ||
                                    service.provider?.location
                                    ||
                                    "Location not specified";


                                const rating =
                                    Number(
                                        service.averageRating || 0
                                    ).toFixed(1);


                                return `
                                    <div class="home-card service-card">

                                        <div class="card-image-placeholder">

                                            <span>
                                                ⚒
                                            </span>

                                        </div>

                                        <div class="home-card-content">

                                            <span class="card-category">
                                                ${escapeHtml(
                                    service.category?.categoryName
                                    || "Service"
                                )}
                                            </span>

                                            <h3>
                                                ${escapeHtml(
                                    service.title
                                )}
                                            </h3>

                                            <p class="card-provider">
                                                ${escapeHtml(provider)}
                                            </p>

                                            <p class="card-location">
                                                ◉
                                                ${escapeHtml(location)}
                                            </p>

                                            <div class="card-meta-row">

                                                <span>
                                                    ★ ${rating}
                                                </span>

                                                <span class="card-price">
                                                    From
                                                    ${formatMoney(
                                    service.startingPrice
                                )}
                                                </span>

                                            </div>

                                            <a
                                                href="/Services/Details/${service.serviceOfferingId}"
                                                class="card-button">

                                                Contact Provider

                                            </a>

                                        </div>

                                    </div>
                                    `;

                            }
                        ).join("");

                }


                /* =================================================
                   MARKETPLACE
                ================================================= */

                function renderMarketplace(
                    listings
                ) {

                    const loading =
                        document.getElementById(
                            "marketplaceLoading"
                        );

                    const container =
                        document.getElementById(
                            "marketplaceContainer"
                        );

                    loading.style.display = "none";


                    if (listings.length === 0) {

                        container.innerHTML =
                            `
                                <div class="home-empty">
                                    No marketplace listings available yet.
                                </div>
                                `;

                        return;
                    }


                    const visibleListings =
                        listings.slice(0, 6);


                    container.innerHTML =
                        visibleListings.map(
                            function(listing) {

                                let imageHtml =
                                    `
                                        <div class="card-image-placeholder">

                                            <span>
                                                ◈
                                            </span>

                                        </div>
                                        `;


                                if (
                                    listing.primaryImageId
                                ) {

                                    imageHtml =
                                        `
                                            <div class="marketplace-card-image">

                                                <img
                                                    src="${apiBase}api/MarketplaceImages/${listing.primaryImageId}/file"
                                                    alt="${escapeHtml(listing.title)}"
                                                    loading="lazy"
                                                />

                                            </div>
                                            `;

                                }


                                return `
                                    <div class="home-card marketplace-card">

                                        ${imageHtml}

                                        <div class="home-card-content">

                                            <div class="marketplace-tags">

                                                <span class="card-category">
                                                    ${escapeHtml(
                                    listing.category?.categoryName
                                    || "Marketplace"
                                )}
                                                </span>

                                                <span class="listing-type">
                                                    ${escapeHtml(
                                    listing.listingType || ""
                                )}
                                                </span>

                                            </div>

                                            <h3>
                                                ${escapeHtml(
                                    listing.title
                                )}
                                            </h3>

                                            <p class="card-location">
                                                ◉
                                                ${escapeHtml(
                                    listing.location
                                    || "Location not specified"
                                )}
                                            </p>

                                            <div class="marketplace-price">
                                                ${formatMoney(listing.price)}
                                            </div>

                                            <a
                                                href="/Marketplace/Details/${listing.marketplaceListingId}"
                                                class="card-button">

                                                View Item

                                            </a>

                                        </div>

                                    </div>
                                    `;

                            }
                        ).join("");

                }


                /* =================================================
                   CURRENCY
                ================================================= */

                function formatMoney(value) {

                    if (
                        value === null ||
                        value === undefined
                    ) {

                        return "Price not specified";

                    }

                    return new Intl.NumberFormat(
                        "en-LK",
                        {
                            style: "currency",
                            currency: "LKR",
                            maximumFractionDigits: 0
                        }
                    ).format(value);

                }


                /* =================================================
                   HTML SECURITY
                ================================================= */

                function escapeHtml(value) {

                    const div =
                        document.createElement("div");

                    div.textContent =
                        value ?? "";

                    return div.innerHTML;

                }


                /* =================================================
                   ERROR
                ================================================= */

                function showHomeError() {

                    const containers =
                        [
                            "jobCategoriesContainer",
                            "servicesContainer",
                            "marketplaceContainer"
                        ];


                    const loading =
                        [
                            "jobCategoriesLoading",
                            "servicesLoading",
                            "marketplaceLoading"
                        ];


                    loading.forEach(
                        function(id) {

                            const element =
                                document.getElementById(id);

                            if (element) {

                                element.style.display =
                                    "none";

                            }

                        }
                    );


                    containers.forEach(
                        function(id) {

                            const element =
                                document.getElementById(id);

                            if (element) {

                                element.innerHTML =
                                    `
                                        <div class="home-empty">
                                            Unable to load WorkHub data.
                                            Make sure WorkHub API is running.
                                        </div>
                                        `;

                            }

                        }
                    );

                }

            }
        );

    </script>
}