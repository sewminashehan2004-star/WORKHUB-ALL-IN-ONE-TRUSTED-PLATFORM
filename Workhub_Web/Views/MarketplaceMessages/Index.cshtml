@model Workhub_Web.Models.MarketplaceInboxViewModel
@{ ViewData["Title"] = "Marketplace Messages"; }
<style>
.msg-page{min-height:calc(100vh - 80px);padding:44px 0 80px;background:radial-gradient(circle at 92% 0,rgba(253,80,0,.07),transparent 28%),#f8fafc}.msg-shell{width:min(1080px,calc(100% - 36px));margin:auto}.msg-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.msg-kicker{color:#fd5000;font-size:12px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.msg-head h1{font-size:40px;margin:7px 0 5px;color:#0f172a}.msg-head p{margin:0;color:#64748b;font-size:14px}.msg-browse{padding:11px 15px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;color:#334155;font-size:12px;font-weight:850}.msg-card{overflow:hidden;background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 14px 40px rgba(15,23,42,.07)}.conv{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:14px;align-items:center;padding:18px 20px;border-bottom:1px solid #edf0f4;color:inherit;text-decoration:none;transition:.18s}.conv:last-child{border-bottom:0}.conv:hover{background:#fff9f5}.conv-avatar{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#fd5000,#ff7800);color:#fff;font-size:18px;font-weight:950}.conv-head{display:flex;justify-content:space-between;gap:12px}.conv-head strong{font-size:14px;color:#0f172a}.conv-head span{font-size:10px;color:#94a3b8}.conv h3{font-size:13px;margin:4px 0;color:#334155}.conv p{margin:0;color:#64748b;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.unread{min-width:28px;height:28px;padding:0 8px;border-radius:999px;display:grid;place-items:center;background:#fd5000;color:#fff;font-size:10px;font-weight:900}.empty{padding:60px 20px;text-align:center}.empty-icon{width:65px;height:65px;border-radius:18px;display:grid;place-items:center;background:#fff0e9;color:#fd5000;margin:0 auto 15px;font-size:28px}.empty h3{font-size:20px;margin:0 0 7px}.empty p{font-size:12px;color:#64748b;margin:0}@@media(max-width:650px){.msg-head{align-items:flex-start;flex-direction:column}.msg-head h1{font-size:32px}.msg-browse{width:100%;text-align:center}.conv{grid-template-columns:46px minmax(0,1fr) auto;padding:15px}.conv-avatar{width:46px;height:46px}.conv-head span{display:none}}
</style>
<section class="msg-page"><div class="msg-shell"><div class="msg-head"><div><span class="msg-kicker">Buyer & seller communication</span><h1>Marketplace Messages</h1><p>Keep your buying and selling conversations together inside WorkHub.</p></div><a class="msg-browse" href="/Marketplace">← Browse Marketplace</a></div>
@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="wh-alert danger">@Model.ErrorMessage</div>}
@if(!string.IsNullOrWhiteSpace(Model.SuccessMessage)){<div class="wh-alert success">@Model.SuccessMessage</div>}
<div class="msg-card">@if(!Model.Conversations.Any()){<div class="empty"><div class="empty-icon">💬</div><h3>No conversations yet</h3><p>Open a marketplace listing and send the seller a message.</p></div>}else{@foreach(var item in Model.Conversations){<a class="conv" asp-action="Chat" asp-route-id="@item.MarketplaceConversationId"><div class="conv-avatar">@((item.OtherParty.FullName ?? "U").Substring(0,1).ToUpperInvariant())</div><div><div class="conv-head"><strong>@item.OtherParty.FullName</strong><span>@item.UpdatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span></div><h3>@item.Listing.Title • $@item.Listing.Price.ToString("N0")</h3><p>@(item.LastMessage?.MessageText ?? "Conversation started")</p></div>@if(item.UnreadCount>0){<span class="unread">@item.UnreadCount</span>}</a>}}</div></div></section>
