@model Workhub_Web.Models.CompanyApplicationDetailsViewModel

@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "Application Details";

    var currentStatus =
        string.IsNullOrWhiteSpace(Model.Status)
            ? "Received"
            : Model.Status.Trim();

    var matchScore =
        Model.MatchResult?.OverallScore ?? 0;

    var safeMatchScore =
        Math.Clamp(
            matchScore,
            0m,
            100m);

    var statusClass =
        currentStatus.ToLowerInvariant() switch
        {
            "received" => "status-received",
            "under review" => "status-review",
            "shortlisted" => "status-shortlisted",
            "interview" => "status-interview",
            "offered" => "status-offered",
            "hired" => "status-hired",
            "rejected" => "status-rejected",
            _ => "status-received"
        };
}

<style>

    :root {
        --detail-orange: #FD5000;
        --detail-orange-dark: #D94300;
        --detail-orange-light: #FF7A00;
        --detail-orange-soft: #FFF2EB;
        --detail-dark: #0F172A;
        --detail-dark-2: #1E293B;
        --detail-text: #64748B;
        --detail-text-dark: #334155;
        --detail-border: #E2E8F0;
        --detail-bg: #F8FAFC;
        --detail-green: #16A34A;
        --detail-green-soft: #F0FDF4;
        --detail-blue: #2563EB;
        --detail-blue-soft: #EFF6FF;
        --detail-red: #DC2626;
        --detail-red-dark: #B91C1C;
        --detail-red-soft: #FEF2F2;
        --detail-purple: #7C3AED;
        --detail-purple-soft: #F5F3FF;
        --detail-yellow: #D97706;
        --detail-yellow-soft: #FFFBEB;
        --detail-cyan: #0E7490;
        --detail-cyan-soft: #ECFEFF;
        --detail-shadow: 0 12px 34px rgba(15,23,42,.07);
    }


    * {
        box-sizing: border-box;
    }


    .detail-svg {
        width: 21px;
        height: 21px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }


    /* =========================================
           PAGE
        ========================================= */

    .application-detail-page {
        min-height: calc(100vh - 72px);
        padding: 48px 24px 90px;
        background: radial-gradient( circle at top right, rgba(253,80,0,.07), transparent 31% ), radial-gradient( circle at bottom left, rgba(253,80,0,.035), transparent 27% ), var(--detail-bg);
    }


    .application-detail-container {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
    }


    /* =========================================
           HEADER
        ========================================= */

    .detail-header {
        margin-bottom: 28px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }


    .detail-label {
        margin-bottom: 10px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--detail-orange);
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 1.1px;
        text-transform: uppercase;
    }


        .detail-label svg {
            width: 18px;
            height: 18px;
        }


    .detail-header h1 {
        margin: 0 0 9px;
        color: var(--detail-dark);
        font-size: 42px;
        font-weight: 950;
        letter-spacing: -1px;
    }


    .detail-header p {
        margin: 0;
        color: var(--detail-text);
        font-size: 15px;
        line-height: 1.6;
    }


        .detail-header p strong {
            color: var(--detail-dark);
        }


    .detail-back {
        min-height: 44px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid var(--detail-border);
        border-radius: 10px;
        background: #FFFFFF;
        color: #475569;
        font-size: 12px;
        font-weight: 850;
        text-decoration: none;
        box-shadow: 0 5px 14px rgba(15,23,42,.04);
        transition: .2s ease;
    }


        .detail-back svg {
            width: 17px;
            height: 17px;
        }


        .detail-back:hover {
            transform: translateY(-1px);
            border-color: var(--detail-orange);
            background: var(--detail-orange-soft);
            color: var(--detail-orange-dark);
        }


    /* =========================================
           MESSAGES
        ========================================= */

    .detail-message {
        margin-bottom: 21px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 800;
    }


    .detail-message-success {
        border: 1px solid #BBF7D0;
        background: var(--detail-green-soft);
        color: #15803D;
    }


    .detail-message-error {
        border: 1px solid #FECACA;
        background: var(--detail-red-soft);
        color: var(--detail-red-dark);
    }


    /* =========================================
           LAYOUT
        ========================================= */

    .detail-layout {
        display: grid;
        grid-template-columns: minmax(0,1.38fr) minmax(330px,.62fr);
        gap: 24px;
        align-items: start;
    }


    /* =========================================
           CARDS
        ========================================= */

    .detail-card {
        margin-bottom: 22px;
        padding: 29px;
        border: 1px solid var(--detail-border);
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: var(--detail-shadow);
    }


    .detail-card-header {
        margin-bottom: 22px;
        padding-bottom: 17px;
        display: flex;
        align-items: flex-start;
        gap: 13px;
        border-bottom: 1px solid #F1F5F9;
    }


    .detail-card-header-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--detail-orange-soft);
        color: var(--detail-orange-dark);
    }


        .detail-card-header-icon svg {
            width: 22px;
            height: 22px;
        }


    .detail-card-header h2 {
        margin: 0 0 6px;
        color: var(--detail-dark);
        font-size: 21px;
        font-weight: 950;
    }


    .detail-card-header p {
        margin: 0;
        color: #64748B;
        font-size: 13px;
        line-height: 1.55;
    }


    /* =========================================
           CANDIDATE
        ========================================= */

    .candidate-header {
        display: flex;
        align-items: flex-start;
        gap: 17px;
    }


    .candidate-avatar {
        width: 70px;
        height: 70px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: linear-gradient( 135deg, var(--detail-orange), var(--detail-orange-light) );
        color: #FFFFFF;
        font-size: 26px;
        font-weight: 950;
        box-shadow: 0 10px 22px rgba(253,80,0,.23);
    }


    .candidate-name {
        margin: 0 0 7px;
        color: var(--detail-dark);
        font-size: 23px;
        font-weight: 950;
    }


    .candidate-contact-line {
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #475569;
        font-size: 12px;
        font-weight: 750;
    }


        .candidate-contact-line svg {
            width: 15px;
            height: 15px;
            color: var(--detail-orange-dark);
            flex-shrink: 0;
        }


    .candidate-summary {
        margin-top: 20px;
        padding: 17px;
        border: 1px solid #E2E8F0;
        border-radius: 11px;
        background: linear-gradient( 135deg, #F8FAFC, #FFFFFF );
        color: #475569;
        font-size: 13px;
        line-height: 1.75;
    }


    .candidate-meta-grid {
        margin-top: 17px;
        display: grid;
        grid-template-columns: repeat( 2, minmax(0,1fr) );
        gap: 12px;
    }


    .candidate-meta {
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        background: #F8FAFC;
    }


    .candidate-meta-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--detail-orange-dark);
    }


        .candidate-meta-icon svg {
            width: 18px;
            height: 18px;
        }


    .candidate-meta-content {
        min-width: 0;
    }


    .candidate-meta span {
        display: block;
        margin-bottom: 4px;
        color: #94A3B8;
        font-size: 9px;
        font-weight: 850;
        text-transform: uppercase;
    }


    .candidate-meta strong {
        display: block;
        color: #334155;
        font-size: 12px;
        font-weight: 850;
        overflow-wrap: anywhere;
    }


    /* =========================================
           SKILLS
        ========================================= */

    .candidate-skill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }


    .candidate-skill {
        min-width: 155px;
        padding: 11px 13px;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        background: #F8FAFC;
        transition: .2s ease;
    }


        .candidate-skill:hover {
            transform: translateY(-2px);
            border-color: #FDBA95;
            background: var(--detail-orange-soft);
        }


        .candidate-skill strong {
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--detail-dark);
            font-size: 12px;
            font-weight: 900;
        }


            .candidate-skill strong svg {
                width: 14px;
                height: 14px;
                color: var(--detail-orange-dark);
            }


        .candidate-skill span {
            color: #64748B;
            font-size: 10px;
        }


    /* =========================================
           TIMELINE
        ========================================= */

    .timeline-list {
        display: grid;
        gap: 13px;
    }


    .timeline-item {
        position: relative;
        padding: 16px 16px 16px 19px;
        border-left: 4px solid var(--detail-orange);
        border-radius: 0 11px 11px 0;
        background: #F8FAFC;
        transition: .2s ease;
    }


        .timeline-item:hover {
            background: var(--detail-orange-soft);
            transform: translateX(3px);
        }


        .timeline-item strong {
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--detail-dark);
            font-size: 14px;
            font-weight: 900;
        }


            .timeline-item strong svg {
                width: 15px;
                height: 15px;
                color: var(--detail-orange-dark);
            }


        .timeline-item .timeline-sub {
            margin-bottom: 5px;
            color: #475569;
            font-size: 12px;
            font-weight: 800;
        }


        .timeline-item span {
            color: #94A3B8;
            font-size: 10px;
        }


    /* =========================================
           COVER LETTER
        ========================================= */

    .cover-letter {
        padding: 18px;
        border: 1px solid #E2E8F0;
        border-radius: 11px;
        background: linear-gradient( 135deg, #F8FAFC, #FFFFFF );
        color: #475569;
        font-size: 13px;
        line-height: 1.8;
        white-space: pre-wrap;
    }


    /* =========================================
           SCREENING ANSWERS
        ========================================= */

    .screening-answer-list {
        display: grid;
        gap: 13px;
    }


    .screening-answer-item {
        padding: 16px;
        border: 1px solid #E2E8F0;
        border-radius: 11px;
        background: #F8FAFC;
        transition: .2s ease;
    }


        .screening-answer-item:hover {
            border-color: #FDBA95;
            background: #FFF9F5;
            transform: translateY(-2px);
        }


    .screening-question {
        margin-bottom: 8px;
        display: flex;
        align-items: flex-start;
        gap: 7px;
        color: #64748B;
        font-size: 12px;
        font-weight: 750;
        line-height: 1.55;
    }


        .screening-question svg {
            width: 16px;
            height: 16px;
            margin-top: 1px;
            flex-shrink: 0;
            color: var(--detail-orange-dark);
        }


    .screening-answer-item strong {
        display: block;
        margin-left: 23px;
        color: var(--detail-dark);
        font-size: 14px;
        font-weight: 900;
        line-height: 1.55;
    }


    .screening-answer-item small {
        margin: 8px 0 0 23px;
        display: flex;
        align-items: center;
        gap: 5px;
        color: #94A3B8;
        font-size: 10px;
    }


        .screening-answer-item small svg {
            width: 13px;
            height: 13px;
        }


    /* =========================================
           STATUS
        ========================================= */

    .status-badge {
        min-height: 33px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
    }


    .status-badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }


    .status-received {
        background: var(--detail-blue-soft);
        color: var(--detail-blue);
    }


    .status-review {
        background: var(--detail-yellow-soft);
        color: var(--detail-yellow);
    }


    .status-shortlisted {
        background: var(--detail-purple-soft);
        color: var(--detail-purple);
    }


    .status-interview {
        background: var(--detail-cyan-soft);
        color: var(--detail-cyan);
    }


    .status-offered {
        background: #ECFDF5;
        color: #047857;
    }


    .status-hired {
        background: var(--detail-green-soft);
        color: var(--detail-green);
    }


    .status-rejected {
        background: var(--detail-red-soft);
        color: var(--detail-red);
    }


    .status-form {
        margin-top: 18px;
    }


        .status-form label {
            margin-bottom: 8px;
            display: block;
            color: #334155;
            font-size: 13px;
            font-weight: 850;
        }


    .status-select {
        width: 100%;
        min-height: 47px;
        margin-bottom: 11px;
        padding: 0 13px;
        border: 1px solid #CBD5E1;
        border-radius: 10px;
        background: #FFFFFF;
        color: var(--detail-dark);
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }


        .status-select:hover {
            border-color: #94A3B8;
        }


        .status-select:focus {
            border-color: var(--detail-orange);
            box-shadow: 0 0 0 4px rgba(253,80,0,.09);
        }


    .status-update-button {
        width: 100%;
        min-height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( 135deg, var(--detail-orange), var(--detail-orange-light) );
        color: #FFFFFF;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(253,80,0,.21);
        transition: .2s ease;
    }


        .status-update-button svg {
            width: 17px;
            height: 17px;
        }


        .status-update-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(253,80,0,.29);
        }


        .status-update-button:disabled {
            opacity: .65;
            cursor: not-allowed;
            transform: none;
        }


    /* =========================================
           CV MATCH
        ========================================= */

    .match-main {
        text-align: center;
    }


    .match-circle {
        position: relative;
        width: 145px;
        height: 145px;
        margin: 0 auto 17px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 10px solid var(--detail-orange-soft);
        border-radius: 50%;
        background: #FFFFFF;
        box-shadow: inset 0 0 0 2px #FED7C5, 0 10px 24px rgba(15,23,42,.07);
    }


        .match-circle::after {
            content: "";
            position: absolute;
            inset: -10px;
            border: 2px solid rgba(253,80,0,.12);
            border-radius: 50%;
        }


        .match-circle strong {
            color: var(--detail-dark);
            font-size: 34px;
            font-weight: 950;
            line-height: 1;
        }


        .match-circle span {
            margin-top: 5px;
            color: #94A3B8;
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
        }


    .match-description {
        margin-bottom: 19px;
        color: #64748B;
        font-size: 11px;
        line-height: 1.6;
    }


    .match-breakdown {
        display: grid;
        gap: 11px;
    }


    .match-row {
        padding: 12px;
        border-radius: 9px;
        background: #F8FAFC;
    }


    .match-row-top {
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }


        .match-row-top span {
            color: #64748B;
            font-size: 10px;
            font-weight: 800;
        }


        .match-row-top strong {
            color: var(--detail-dark);
            font-size: 11px;
            font-weight: 900;
        }


    .score-bar {
        height: 7px;
        overflow: hidden;
        border-radius: 20px;
        background: #E2E8F0;
    }


    .score-fill {
        height: 100%;
        border-radius: 20px;
        background: linear-gradient( 90deg, var(--detail-orange), var(--detail-orange-light) );
    }


    .match-text-box {
        margin-top: 14px;
        padding: 14px;
        border: 1px solid #E2E8F0;
        border-radius: 9px;
        background: #F8FAFC;
    }


        .match-text-box strong {
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--detail-dark);
            font-size: 11px;
            font-weight: 900;
        }


            .match-text-box strong svg {
                width: 14px;
                height: 14px;
                color: var(--detail-orange-dark);
            }


        .match-text-box p {
            margin: 0;
            color: #64748B;
            font-size: 10px;
            line-height: 1.65;
        }


    /* =========================================
           APPLICATION INFO
        ========================================= */

    .application-info-list {
        display: grid;
        gap: 9px;
    }


    .application-info-row {
        padding: 12px 0;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid #F1F5F9;
    }


        .application-info-row:last-child {
            border-bottom: none;
        }


    .application-info-label {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #94A3B8;
        font-size: 10px;
        font-weight: 800;
    }


        .application-info-label svg {
            width: 14px;
            height: 14px;
            color: var(--detail-orange-dark);
        }


    .application-info-row strong {
        color: #475569;
        font-size: 11px;
        font-weight: 850;
        text-align: right;
    }


    /* =========================================
           EMPTY
        ========================================= */

    .detail-empty {
        padding: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px dashed #CBD5E1;
        border-radius: 10px;
        background: #FAFCFE;
        color: #94A3B8;
        font-size: 11px;
        text-align: center;
    }


        .detail-empty svg {
            width: 17px;
            height: 17px;
            flex-shrink: 0;
        }


    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media (max-width: 950px) {

        .detail-layout {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 650px) {

        .application-detail-page {
            padding: 30px 14px 65px;
        }


        .detail-header {
            flex-direction: column;
        }


            .detail-header h1 {
                font-size: 34px;
            }


            .detail-header p {
                font-size: 13px;
            }


        .detail-back {
            width: 100%;
        }


        .detail-card {
            padding: 22px;
        }


        .candidate-meta-grid {
            grid-template-columns: 1fr;
        }


        .candidate-header {
            flex-direction: column;
        }


        .candidate-name {
            font-size: 21px;
        }
    }
</style>


<section class="application-detail-page">

    <div class="application-detail-container">


        <!-- =========================================
             HEADER
        ========================================= -->

        <div class="detail-header">

            <div>

                <span class="detail-label">

                    <svg viewBox="0 0 24 24"
                         class="detail-svg">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                        <circle cx="9"
                                cy="7"
                                r="4" />

                        <path d="M19 8v6" />

                        <path d="M22 11h-6" />

                    </svg>

                    Candidate Application

                </span>


                <h1>
                    @Model.Candidate.FullName
                </h1>


                <p>

                    Application for

                    <strong>
                        @Model.Job.Title
                    </strong>

                </p>

            </div>


            <a asp-controller="CompanyApplications"
               asp-action="Index"
               asp-route-jobId="@Model.Job.JobId"
               class="detail-back">

                <svg viewBox="0 0 24 24"
                     class="detail-svg">

                    <path d="M19 12H5" />

                    <path d="m11 18-6-6 6-6" />

                </svg>

                Back to Applications

            </a>

        </div>


        <!-- =========================================
             MESSAGES
        ========================================= -->
        @if (
                    !string.IsNullOrWhiteSpace(
                        Model.SuccessMessage))
        {
            <div class="detail-message detail-message-success">

                <svg viewBox="0 0 24 24"
                     class="detail-svg">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <path d="m8 12 3 3 5-6" />

                </svg>

                @Model.SuccessMessage

            </div>
        }


        @if (
            !string.IsNullOrWhiteSpace(
                Model.ErrorMessage))
        {
            <div class="detail-message detail-message-error">

                <svg viewBox="0 0 24 24"
                     class="detail-svg">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <path d="M12 8v5" />

                    <path d="M12 17h.01" />

                </svg>

                @Model.ErrorMessage

            </div>
        }


        <div class="detail-layout">


            <!-- =====================================
                 LEFT
            ====================================== -->

            <div>


                <!-- =================================
                     CANDIDATE PROFILE
                ================================== -->

                <div class="detail-card">


                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <circle cx="12"
                                        cy="8"
                                        r="4" />

                                <path d="M4 21a8 8 0 0 1 16 0" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Candidate Profile
                            </h2>

                            <p>
                                Job seeker information submitted
                                with this application.
                            </p>

                        </div>

                    </div>


                    <div class="candidate-header">


                        <div class="candidate-avatar">

                            @(string.IsNullOrWhiteSpace(
                                Model.Candidate.FullName)
                                ? "A"
                                : Model.Candidate.FullName
                                    .Substring(0, 1)
                                    .ToUpperInvariant())

                        </div>


                        <div>

                            <h2 class="candidate-name">
                                @Model.Candidate.FullName
                            </h2>


                            <div class="candidate-contact-line">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2" />

                                    <path d="m3 7 9 6 9-6" />

                                </svg>

                                @Model.Candidate.Email

                            </div>


                            <div class="candidate-contact-line">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11z" />

                                    <circle cx="12"
                                            cy="10"
                                            r="2" />

                                </svg>


                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        Model.Candidate.CurrentLocation))
                                {
                                    <span>
                                        @Model.Candidate.CurrentLocation
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Location not provided
                                    </span>
                                }

                            </div>


                        </div>

                    </div>


                    @if (
                        !string.IsNullOrWhiteSpace(
                            Model.Candidate.ProfessionalSummary))
                    {
                        <div class="candidate-summary">

                            @Model.Candidate.ProfessionalSummary

                        </div>
                    }


                    <div class="candidate-meta-grid">


                        <div class="candidate-meta">

                            <div class="candidate-meta-icon">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <rect x="3"
                                          y="7"
                                          width="18"
                                          height="13"
                                          rx="2" />

                                    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                                </svg>

                            </div>


                            <div class="candidate-meta-content">

                                <span>
                                    Preferred Category
                                </span>

                                <strong>

                                    @(string.IsNullOrWhiteSpace(
                                        Model.Candidate.PreferredJobCategory)
                                        ? "Not provided"
                                        : Model.Candidate.PreferredJobCategory)

                                </strong>

                            </div>

                        </div>


                        <div class="candidate-meta">

                            <div class="candidate-meta-icon">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <circle cx="12"
                                            cy="12"
                                            r="9" />

                                    <path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8" />

                                    <path d="M12 6v12" />

                                </svg>

                            </div>


                            <div class="candidate-meta-content">

                                <span>
                                    Expected Salary
                                </span>

                                <strong>

                                    @if (
                                        Model.Candidate.ExpectedSalary.HasValue)
                                    {
                                        @Model.Candidate.ExpectedSalary.Value.ToString("N2")
                                    }
                                    else
                                    {
                                        <text>Not provided</text>
                                    }

                                </strong>

                            </div>

                        </div>


                    </div>

                </div>


                <!-- =================================
                     COVER LETTER
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M5 3h10l4 4v14H5z" />

                                <path d="M15 3v5h5" />

                                <path d="M8 12h8" />

                                <path d="M8 16h6" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Cover Letter
                            </h2>

                            <p>
                                Candidate's message for this vacancy.
                            </p>

                        </div>

                    </div>


                    @if (
                        !string.IsNullOrWhiteSpace(
                            Model.CoverLetter))
                    {
                        <div class="cover-letter">

                            @Model.CoverLetter

                        </div>
                    }
                    else
                    {
                        <div class="detail-empty">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M5 3h10l4 4v14H5z" />

                                <path d="M8 13h8" />

                            </svg>

                            No cover letter was provided.

                        </div>
                    }

                </div>


                <!-- =================================
                     SKILLS
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M14 7 7 14" />

                                <path d="m5 12-2 2 7 7 2-2" />

                                <path d="M17 3l4 4-9 9-4-4z" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Candidate Skills
                            </h2>

                            <p>
                                Skills recorded in the candidate's
                                WorkHub profile.
                            </p>

                        </div>

                    </div>


                    @if (Model.Skills.Any())
                    {
                        <div class="candidate-skill-list">

                            @foreach (
                                var skill
                                in Model.Skills)
                            {
                                <div class="candidate-skill">

                                    <strong>

                                        <svg viewBox="0 0 24 24"
                                             class="detail-svg">

                                            <path d="m8 12 3 3 5-6" />

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                        </svg>

                                        @skill.SkillName

                                    </strong>


                                    <span>

                                        @(string.IsNullOrWhiteSpace(
                                            skill.ProficiencyLevel)
                                            ? "Level not specified"
                                            : skill.ProficiencyLevel)

                                        @if (
                                            skill.YearsOfExperience.HasValue)
                                        {
                                            <text>
                                                • @skill.YearsOfExperience.Value.ToString("0.#") yr(s)
                                            </text>
                                        }

                                    </span>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="detail-empty">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />

                                <path d="M8 12h8" />

                            </svg>

                            No skills have been added.

                        </div>
                    }

                </div>


                <!-- =================================
                     EXPERIENCE
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <rect x="3"
                                      y="7"
                                      width="18"
                                      height="13"
                                      rx="2" />

                                <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                                <path d="M3 12h18" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Work Experience
                            </h2>

                            <p>
                                Candidate's employment history.
                            </p>

                        </div>

                    </div>


                    @if (Model.Experience.Any())
                    {
                        <div class="timeline-list">

                            @foreach (
                                var experience
                                in Model.Experience)
                            {
                                <div class="timeline-item">

                                    <strong>

                                        <svg viewBox="0 0 24 24"
                                             class="detail-svg">

                                            <rect x="3"
                                                  y="7"
                                                  width="18"
                                                  height="13"
                                                  rx="2" />

                                            <path d="M8 7V5h8v2" />

                                        </svg>

                                        @experience.JobTitle

                                    </strong>


                                    <div class="timeline-sub">
                                        @experience.CompanyName
                                    </div>


                                    <span>
                                        @experience.PeriodText
                                    </span>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="detail-empty">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <rect x="3"
                                      y="7"
                                      width="18"
                                      height="13"
                                      rx="2" />

                                <path d="M8 7V5h8v2" />

                            </svg>

                            No work experience has been added.

                        </div>
                    }

                </div>


                <!-- =================================
                     EDUCATION
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="m3 10 9-5 9 5-9 5z" />

                                <path d="M7 12v5c3 2 7 2 10 0v-5" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Education
                            </h2>

                            <p>
                                Candidate's education and qualifications.
                            </p>

                        </div>

                    </div>


                    @if (Model.Education.Any())
                    {
                        <div class="timeline-list">

                            @foreach (
                                var education
                                in Model.Education)
                            {
                                <div class="timeline-item">

                                    <strong>

                                        <svg viewBox="0 0 24 24"
                                             class="detail-svg">

                                            <path d="m3 10 9-5 9 5-9 5z" />

                                            <path d="M7 12v5c3 2 7 2 10 0v-5" />

                                        </svg>

                                        @education.Qualification

                                    </strong>


                                    <div class="timeline-sub">

                                        @education.InstitutionName

                                    </div>


                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            education.FieldOfStudy))
                                    {
                                        <span>

                                            @education.FieldOfStudy

                                        </span>
                                    }

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="detail-empty">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="m3 10 9-5 9 5-9 5z" />

                            </svg>

                            No education records have been added.

                        </div>
                    }

                </div>


                <!-- =================================
                     SCREENING ANSWERS
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />

                                <path d="M9.5 9a2.5 2.5 0 0 1 4.8 1c0 2-2.3 2.1-2.3 4" />

                                <path d="M12 18h.01" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Employer Screening Answers
                            </h2>

                            <p>
                                Answers submitted by this candidate
                                for the selected vacancy.
                            </p>

                        </div>

                    </div>


                    @if (Model.ScreeningAnswers.Any())
                    {
                        <div class="screening-answer-list">

                            @foreach (
                                var answer
                                in Model.ScreeningAnswers)
                            {
                                <div class="screening-answer-item">

                                    <span class="screening-question">

                                        <svg viewBox="0 0 24 24"
                                             class="detail-svg">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <path d="M9.5 9a2.5 2.5 0 0 1 4.8 1c0 2-2.3 2.1-2.3 4" />

                                        </svg>

                                        @answer.QuestionText

                                    </span>


                                    <strong>
                                        @answer.AnswerText
                                    </strong>


                                    <small>

                                        <svg viewBox="0 0 24 24"
                                             class="detail-svg">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <path d="M12 7v5l3 2" />

                                        </svg>

                                        @answer.SubmittedAt
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy, h:mm tt")

                                    </small>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="detail-empty">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />

                                <path d="M8 12h8" />

                            </svg>

                            No screening answers were submitted
                            for this application.

                        </div>
                    }

                </div>


            </div>


            <!-- =====================================
                 RIGHT SIDE
            ====================================== -->

            <div>


                <!-- =================================
                     STATUS
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M9 11l3 3L22 4" />

                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Application Status
                            </h2>

                            <p>
                                Move this candidate through
                                your recruitment process.
                            </p>

                        </div>

                    </div>


                    <span class="status-badge @statusClass">

                        <span class="status-badge-dot">
                        </span>

                        @currentStatus

                    </span>


                    <form asp-controller="CompanyApplications"
                          asp-action="UpdateStatus"
                          asp-route-applicationId="@Model.JobApplicationId"
                          method="post"
                          class="status-form"
                          id="statusForm">

                        @Html.AntiForgeryToken()


                        <label for="status">
                            Change Status
                        </label>


                        <select name="status"
                                id="status"
                                class="status-select">

                            @foreach (
                                var statusOption
                                in new[]
                                {
                                    "Received",
                                    "Under Review",
                                    "Shortlisted",
                                    "Interview",
                                    "Offered",
                                    "Hired",
                                    "Rejected"
                                })
                            {
                                if (
                                    string.Equals(
                                        currentStatus,
                                        statusOption,
                                        StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@statusOption"
                                            selected>

                                        @statusOption

                                    </option>
                                }
                                else
                                {
                                    <option value="@statusOption">

                                        @statusOption

                                    </option>
                                }
                            }

                        </select>


                        <button type="submit"
                                class="status-update-button"
                                id="statusUpdateButton">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M20 6 9 17l-5-5" />

                            </svg>

                            Update Status

                        </button>

                    </form>

                </div>


                <!-- =================================
                     CV MATCH
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M4 19v-6" />

                                <path d="M10 19V9" />

                                <path d="M16 19V5" />

                                <path d="M22 19H2" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Candidate Match
                            </h2>

                            <p>
                                WorkHub rule-based CV and
                                vacancy matching result.
                            </p>

                        </div>

                    </div>


                    @if (Model.MatchResult != null)
                    {
                        <div class="match-main">

                            <div class="match-circle">

                                <strong>
                                    @safeMatchScore.ToString("0.#")
                                </strong>

                                <span>
                                    Overall Match
                                </span>

                            </div>


                            <div class="match-description">

                                This score compares the candidate's
                                profile with the requirements of
                                @Model.Job.Title.

                            </div>

                        </div>


                        <div class="match-breakdown">

                            @{
                                var matchItems =
                                    new[]
                                    {
                                        new
                                        {
                                            Name = "Skills",
                                            Score = Model.MatchResult.SkillsScore
                                        },

                                        new
                                        {
                                            Name = "Experience",
                                            Score = Model.MatchResult.ExperienceScore
                                        },

                                        new
                                        {
                                            Name = "Education",
                                            Score = Model.MatchResult.EducationScore
                                        },

                                        new
                                        {
                                            Name = "Preferred Skills",
                                            Score = Model.MatchResult.PreferredSkillsScore
                                        },

                                        new
                                        {
                                            Name = "Job Relevance",
                                            Score = Model.MatchResult.RelevanceScore
                                        },

                                        new
                                        {
                                            Name = "Location",
                                            Score = Model.MatchResult.LocationScore
                                        }
                                    };
                            }


                            @foreach (var item in matchItems)
                            {
                                var score =
                                    Math.Clamp(
                                        item.Score,
                                        0m,
                                        100m);


                                <div class="match-row">

                                    <div class="match-row-top">

                                        <span>
                                            @item.Name
                                        </span>

                                        <strong>
                                            @score.ToString("0.#")%
                                        </strong>

                                    </div>


                                    <div class="score-bar">

                                        <div class="score-fill"
                                             style="width:@score.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;">
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>


                        @if (
                            !string.IsNullOrWhiteSpace(
                                Model.MatchResult.MatchedSkills))
                        {
                            <div class="match-text-box">

                                <strong>

                                    <svg viewBox="0 0 24 24"
                                         class="detail-svg">

                                        <circle cx="12"
                                                cy="12"
                                                r="9" />

                                        <path d="m8 12 3 3 5-6" />

                                    </svg>

                                    Matched Skills

                                </strong>

                                <p>
                                    @Model.MatchResult.MatchedSkills
                                </p>

                            </div>
                        }


                        @if (
                            !string.IsNullOrWhiteSpace(
                                Model.MatchResult.MissingSkills))
                        {
                            <div class="match-text-box">

                                <strong>

                                    <svg viewBox="0 0 24 24"
                                         class="detail-svg">

                                        <circle cx="12"
                                                cy="12"
                                                r="9" />

                                        <path d="M8 12h8" />

                                    </svg>

                                    Missing Skills

                                </strong>

                                <p>
                                    @Model.MatchResult.MissingSkills
                                </p>

                            </div>
                        }


                        @if (
                            !string.IsNullOrWhiteSpace(
                                Model.MatchResult.Recommendations))
                        {
                            <div class="match-text-box">

                                <strong>

                                    <svg viewBox="0 0 24 24"
                                         class="detail-svg">

                                        <path d="M9 18h6" />

                                        <path d="M10 22h4" />

                                        <path d="M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2z" />

                                    </svg>

                                    Matching Notes

                                </strong>

                                <p>
                                    @Model.MatchResult.Recommendations
                                </p>

                            </div>
                        }

                    }
                    else
                    {
                        <div class="detail-empty">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M4 19v-6" />

                                <path d="M10 19V9" />

                                <path d="M16 19V5" />

                            </svg>

                            No CV match result is currently
                            available for this application.

                        </div>
                    }

                </div>


                <!-- =================================
                     APPLICATION INFO
                ================================== -->

                <div class="detail-card">

                    <div class="detail-card-header">

                        <div class="detail-card-header-icon">

                            <svg viewBox="0 0 24 24"
                                 class="detail-svg">

                                <path d="M5 3h10l4 4v14H5z" />

                                <path d="M15 3v5h5" />

                                <path d="M8 12h8" />

                            </svg>

                        </div>


                        <div>

                            <h2>
                                Application Information
                            </h2>

                            <p>
                                Job application record details.
                            </p>

                        </div>

                    </div>


                    <div class="application-info-list">


                        <div class="application-info-row">

                            <span class="application-info-label">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <path d="M5 4h14v16H5z" />

                                    <path d="M9 8h6" />

                                </svg>

                                Application ID

                            </span>

                            <strong>
                                #@Model.JobApplicationId
                            </strong>

                        </div>


                        <div class="application-info-row">

                            <span class="application-info-label">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <rect x="3"
                                          y="7"
                                          width="18"
                                          height="13"
                                          rx="2" />

                                    <path d="M8 7V5h8v2" />

                                </svg>

                                Job

                            </span>

                            <strong>
                                @Model.Job.Title
                            </strong>

                        </div>


                        <div class="application-info-row">

                            <span class="application-info-label">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="16"
                                          rx="2" />

                                    <path d="M8 3v4" />

                                    <path d="M16 3v4" />

                                </svg>

                                Applied

                            </span>

                            <strong>
                                @Model.AppliedDateText
                            </strong>

                        </div>


                        <div class="application-info-row">

                            <span class="application-info-label">

                                <svg viewBox="0 0 24 24"
                                     class="detail-svg">

                                    <circle cx="12"
                                            cy="12"
                                            r="9" />

                                    <path d="M12 7v5l3 2" />

                                </svg>

                                Last Updated

                            </span>

                            <strong>
                                @Model.UpdatedDateText
                            </strong>

                        </div>


                    </div>

                </div>


            </div>


        </div>


    </div>

</section>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const statusForm =
                    document.getElementById(
                        "statusForm"
                    );


                const statusSelect =
                    document.getElementById(
                        "status"
                    );


                const statusUpdateButton =
                    document.getElementById(
                        "statusUpdateButton"
                    );


                if (
                    statusForm &&
                    statusSelect &&
                    statusUpdateButton
                ) {

                    statusForm.addEventListener(
                        "submit",
                        function(event) {

                            const selectedStatus =
                                statusSelect.value;


                            const confirmed =
                                confirm(
                                    `Change this application status to "${selectedStatus}"?`
                                );


                            if (!confirmed) {
                                event.preventDefault();

                                return;
                            }


                            statusUpdateButton.disabled =
                                true;


                            statusUpdateButton.textContent =
                                "Updating...";

                        }
                    );

                }

            }
        );

    </script>
}