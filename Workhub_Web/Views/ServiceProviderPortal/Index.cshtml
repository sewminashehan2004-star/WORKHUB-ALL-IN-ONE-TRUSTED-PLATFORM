@model Workhub_Web.Models.ServiceProviderPortalViewModel

@{
    ViewData["Title"] = "Service Provider Studio";
}

<style>
    /* =========================================================
           WORKHUB SERVICE PROVIDER STUDIO
           Premium Orange / Dark UI
           ========================================================= */

    :root {
        --sp-orange: #FD5000;
        --sp-orange-dark: #D94300;
        --sp-orange-light: #FFF2EB;
        --sp-orange-soft: #FFF8F4;
        --sp-dark: #0F172A;
        --sp-dark-2: #1E293B;
        --sp-text: #475569;
        --sp-muted: #64748B;
        --sp-bg: #F8FAFC;
        --sp-white: #FFFFFF;
        --sp-border: #E5E7EB;
        --sp-green: #16A34A;
        --sp-green-soft: #DCFCE7;
        --sp-red: #DC2626;
        --sp-red-soft: #FEF2F2;
        --sp-shadow: 0 12px 35px rgba(15, 23, 42, .07);
        --sp-shadow-hover: 0 22px 55px rgba(15, 23, 42, .12);
    }


    /* =========================================================
           PAGE
           ========================================================= */

    .sp-page {
        min-height: 100vh;
        padding: 40px 0 90px;
        background: radial-gradient( circle at 5% 0%, rgba(253, 80, 0, .07), transparent 25% ), radial-gradient( circle at 95% 15%, rgba(253, 80, 0, .045), transparent 25% ), var(--sp-bg);
    }

    .sp-container {
        width: min(1380px, calc(100% - 36px));
        margin: 0 auto;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .sp-hero {
        position: relative;
        overflow: hidden;
        min-height: 235px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 35px;
        padding: 42px 48px;
        border-radius: 28px;
        background: radial-gradient( circle at 85% 20%, rgba(253, 80, 0, .32), transparent 28% ), linear-gradient( 135deg, #0F172A 0%, #172033 55%, #111827 100% );
        box-shadow: 0 25px 70px rgba(15, 23, 42, .16);
        color: white;
    }

        .sp-hero::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            right: -100px;
            top: -170px;
            border-radius: 50%;
            border: 1px solid rgba(253, 80, 0, .35);
            box-shadow: 0 0 0 45px rgba(253, 80, 0, .045), 0 0 0 90px rgba(253, 80, 0, .025);
        }

        .sp-hero::after {
            content: "";
            position: absolute;
            width: 8px;
            height: 8px;
            right: 28%;
            bottom: 30px;
            border-radius: 50%;
            background: var(--sp-orange);
            box-shadow: 0 0 20px rgba(253, 80, 0, .8), 0 0 50px rgba(253, 80, 0, .45);
        }

    .sp-hero-content {
        position: relative;
        z-index: 2;
    }

    .sp-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: #FF9A70;
        font-size: 12px;
        font-weight: 850;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

        .sp-eyebrow::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--sp-orange);
            box-shadow: 0 0 12px rgba(253, 80, 0, .8);
        }

    .sp-hero h1 {
        margin: 0;
        color: white;
        font-size: clamp(32px, 4vw, 52px);
        line-height: 1.08;
        letter-spacing: -1.8px;
        font-weight: 850;
    }

    .sp-hero p {
        max-width: 700px;
        margin: 16px 0 0;
        color: rgba(255,255,255,.68);
        font-size: 16px;
        line-height: 1.7;
    }

    .sp-hero-action {
        position: relative;
        z-index: 3;
        flex-shrink: 0;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .sp-btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 20px;
        border: 0;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: transform .25s ease, box-shadow .25s ease, background .25s ease, border-color .25s ease;
    }

    .sp-btn-primary {
        background: linear-gradient( 135deg, var(--sp-orange), #FF7546 );
        color: white;
        box-shadow: 0 10px 25px rgba(253, 80, 0, .25);
    }

        .sp-btn-primary:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(253, 80, 0, .35);
        }

    .sp-btn-light {
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        color: white;
        backdrop-filter: blur(12px);
    }

        .sp-btn-light:hover {
            color: white;
            background: rgba(255,255,255,.16);
            border-color: rgba(255,255,255,.3);
            transform: translateY(-2px);
        }

    .sp-btn-danger {
        background: var(--sp-red-soft);
        color: var(--sp-red);
    }

        .sp-btn-danger:hover {
            background: #fee2e2;
        }


    /* =========================================================
           ALERTS
           ========================================================= */

    .sp-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding: 15px 18px;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 7px 22px rgba(15,23,42,.04);
    }

        .sp-alert::before {
            width: 27px;
            height: 27px;
            display: grid;
            place-items: center;
            flex: 0 0 27px;
            border-radius: 50%;
            font-size: 14px;
            font-weight: 900;
        }

    .sp-alert-success {
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        color: #166534;
    }

        .sp-alert-success::before {
            content: "✓";
            background: var(--sp-green-soft);
            color: var(--sp-green);
        }

    .sp-alert-danger {
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #991b1b;
    }

        .sp-alert-danger::before {
            content: "!";
            background: #fee2e2;
            color: var(--sp-red);
        }

    .sp-alert-neutral {
        margin-top: 18px;
        border: 1px solid var(--sp-border);
        background: #f8fafc;
        color: var(--sp-muted);
    }


    /* =========================================================
           MAIN GRID
           ========================================================= */

    .sp-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
        margin-top: 25px;
    }


    /* =========================================================
           PANELS
           ========================================================= */

    .sp-panel {
        position: relative;
        overflow: hidden;
        padding: 28px;
        border: 1px solid var(--sp-border);
        border-radius: 22px;
        background: rgba(255,255,255,.96);
        box-shadow: var(--sp-shadow);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .sp-panel:hover {
            border-color: #fbd0bd;
            box-shadow: var(--sp-shadow-hover);
        }

        .sp-panel::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--sp-orange), #FF9A70, transparent );
        }

    .sp-panel-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

        .sp-panel-heading h2 {
            margin: 5px 0 0;
            color: var(--sp-dark);
            font-size: 25px;
            line-height: 1.2;
            letter-spacing: -.7px;
            font-weight: 850;
        }

        .sp-panel-heading p {
            max-width: 650px;
            margin: 10px 0 0;
            color: var(--sp-muted);
            font-size: 14px;
            line-height: 1.6;
        }


    /* =========================================================
           ICON SYSTEM
           ========================================================= */

    .sp-icon {
        width: 19px;
        height: 19px;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .sp-icon-lg {
        width: 23px;
        height: 23px;
    }

    .sp-heading-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        flex: 0 0 48px;
        border-radius: 14px;
        background: linear-gradient( 135deg, var(--sp-orange-light), #fff );
        color: var(--sp-orange);
        border: 1px solid #ffd8c8;
    }

    .sp-heading-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }


    /* =========================================================
           STATUS / COUNT
           ========================================================= */

    .sp-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        background: var(--sp-orange-light);
        color: var(--sp-orange-dark);
        font-size: 11px;
        font-weight: 850;
        white-space: nowrap;
    }

        .sp-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .sp-status.good {
            background: var(--sp-green-soft);
            color: var(--sp-green);
        }

        .sp-status.muted {
            background: #f1f5f9;
            color: var(--sp-muted);
        }

    .sp-count {
        min-width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        padding: 0 10px;
        border-radius: 11px;
        background: var(--sp-orange-light);
        color: var(--sp-orange-dark);
        font-size: 13px;
        font-weight: 850;
    }


    /* =========================================================
           FORMS
           ========================================================= */

    .sp-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .sp-field {
        min-width: 0;
    }

    .sp-field-full {
        grid-column: 1 / -1;
    }

    .sp-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--sp-dark-2);
        font-size: 13px;
        font-weight: 800;
    }

    .sp-field input,
    .sp-field select,
    .sp-field textarea {
        width: 100%;
        border: 1px solid var(--sp-border);
        border-radius: 11px;
        background: #fff;
        color: var(--sp-dark);
        padding: 12px 14px;
        outline: none;
        font-family: inherit;
        font-size: 14px;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

    .sp-field input,
    .sp-field select {
        height: 46px;
    }

    .sp-field textarea {
        resize: vertical;
        min-height: 110px;
        line-height: 1.6;
    }

        .sp-field input::placeholder,
        .sp-field textarea::placeholder {
            color: #94a3b8;
        }

        .sp-field input:focus,
        .sp-field select:focus,
        .sp-field textarea:focus {
            border-color: var(--sp-orange);
            box-shadow: 0 0 0 4px rgba(253,80,0,.09);
            background: #fff;
        }


    /* =========================================================
           TABLE
           ========================================================= */

    .sp-space-top {
        margin-top: 25px;
    }

    .sp-table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid var(--sp-border);
        border-radius: 16px;
    }

    .sp-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
        background: white;
    }

        .sp-table th {
            padding: 14px 16px;
            background: #f8fafc;
            border-bottom: 1px solid var(--sp-border);
            color: #64748b;
            font-size: 11px;
            font-weight: 850;
            text-align: left;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .sp-table td {
            padding: 17px 16px;
            border-bottom: 1px solid #eef2f7;
            color: var(--sp-text);
            font-size: 14px;
            vertical-align: middle;
        }

        .sp-table tbody tr {
            transition: background .2s ease;
        }

            .sp-table tbody tr:hover {
                background: #fffaf7;
            }

            .sp-table tbody tr:last-child td {
                border-bottom: none;
            }

        .sp-table strong {
            display: block;
            margin-bottom: 4px;
            color: var(--sp-dark);
            font-weight: 800;
        }

        .sp-table small {
            display: block;
            max-width: 300px;
            color: var(--sp-muted);
            font-size: 12px;
            line-height: 1.5;
        }


    /* =========================================================
           REMOVE LINK
           ========================================================= */

    .sp-actions-cell {
        text-align: right;
    }

    .sp-link-danger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 0;
        padding: 7px 10px;
        border-radius: 8px;
        background: transparent;
        color: var(--sp-red);
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

        .sp-link-danger:hover {
            background: var(--sp-red-soft);
        }


    /* =========================================================
           EMPTY
           ========================================================= */

    .sp-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 150px;
        padding: 30px;
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
        background: #f8fafc;
        color: var(--sp-muted);
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }

    .sp-empty-icon {
        width: 46px;
        height: 46px;
        display: grid;
        place-items: center;
        margin-bottom: 12px;
        border-radius: 13px;
        background: var(--sp-orange-light);
        color: var(--sp-orange);
    }


    /* =========================================================
           LEAD CARDS
           ========================================================= */

    .sp-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .sp-lead-card {
        position: relative;
        padding: 22px;
        border: 1px solid var(--sp-border);
        border-radius: 18px;
        background: white;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .sp-lead-card:hover {
            transform: translateY(-5px);
            border-color: #ffd0bd;
            box-shadow: 0 15px 40px rgba(15,23,42,.08);
        }

    .sp-card-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

        .sp-card-meta span:first-child {
            padding: 6px 10px;
            border-radius: 8px;
            background: var(--sp-orange-light);
            color: var(--sp-orange-dark);
            font-size: 11px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .sp-card-meta span:last-child {
            color: #94a3b8;
            font-size: 12px;
            font-weight: 700;
        }

    .sp-lead-card h3 {
        margin: 0 0 9px;
        color: var(--sp-dark);
        font-size: 19px;
        line-height: 1.35;
        letter-spacing: -.3px;
        font-weight: 850;
    }

    .sp-lead-card > p {
        margin: 0;
        color: var(--sp-muted);
        font-size: 14px;
        line-height: 1.65;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }


    /* =========================================================
           DETAIL STRIP
           ========================================================= */

    .sp-detail-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }

        .sp-detail-strip span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 10px;
            border: 1px solid #eef2f7;
            border-radius: 9px;
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 750;
        }


    /* =========================================================
           OFFER FORM
           ========================================================= */

    .sp-inline-offer {
        display: grid;
        grid-template-columns: 130px 1fr auto;
        gap: 8px;
        margin-top: 18px;
    }

        .sp-inline-offer input {
            width: 100%;
            min-width: 0;
            height: 43px;
            padding: 0 12px;
            border: 1px solid var(--sp-border);
            border-radius: 10px;
            outline: none;
            font-family: inherit;
            font-size: 13px;
            transition: .2s ease;
        }

            .sp-inline-offer input:focus {
                border-color: var(--sp-orange);
                box-shadow: 0 0 0 3px rgba(253,80,0,.08);
            }

        .sp-inline-offer .sp-btn {
            height: 43px;
            min-height: 43px;
            padding: 0 15px;
            white-space: nowrap;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1050px) {

        .sp-main-grid {
            grid-template-columns: 1fr;
        }

        .sp-card-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 760px) {

        .sp-page {
            padding-top: 20px;
        }

        .sp-container {
            width: min(100% - 24px, 1380px);
        }

        .sp-hero {
            flex-direction: column;
            align-items: flex-start;
            padding: 32px 25px;
            border-radius: 22px;
        }

            .sp-hero h1 {
                font-size: 34px;
            }

        .sp-hero-action {
            width: 100%;
        }

            .sp-hero-action .sp-btn {
                width: 100%;
            }

        .sp-panel {
            padding: 22px 18px;
            border-radius: 18px;
        }

        .sp-panel-heading h2 {
            font-size: 22px;
        }

        .sp-form-grid {
            grid-template-columns: 1fr;
        }

        .sp-field-full {
            grid-column: auto;
        }

        .sp-card-grid {
            grid-template-columns: 1fr;
        }

        .sp-inline-offer {
            grid-template-columns: 1fr;
        }

            .sp-inline-offer .sp-btn {
                width: 100%;
            }
    }


    @@media (max-width: 480px) {

        .sp-hero h1 {
            font-size: 30px;
            letter-spacing: -1px;
        }

        .sp-hero p {
            font-size: 14px;
        }

        .sp-panel-heading {
            align-items: flex-start;
        }

        .sp-heading-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
        }

        .sp-count {
            min-width: 32px;
            height: 32px;
        }

        .sp-lead-card {
            padding: 18px;
        }

        .sp-detail-strip {
            flex-direction: column;
        }

            .sp-detail-strip span {
                width: 100%;
            }
    }


    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .sp-panel,
        .sp-lead-card,
        .sp-btn,
        * {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<section class="sp-page">

   
    <div class="sp-container">


        <!-- =====================================================
         HERO
    ====================================================== -->

        <div class="sp-hero">

            <div class="sp-hero-content">

                <span class="sp-eyebrow">
                    Provider workspace
                </span>

                <h1>
                    Grow your service business
                </h1>

                <p>
                    Publish services, discover customer requests,
                    send professional offers and manage your
                    service business from one workspace.
                </p>

            </div>

            <div class="sp-hero-action">

                <a asp-controller="Services"
                   asp-action="Index"
                   class="sp-btn sp-btn-light">

                    <svg class="sp-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M3 12h18"></path>
                        <path d="M13 6l6 6-6 6"></path>

                    </svg>

                    View public services

                </a>

            </div>

        </div>


        <!-- =====================================================
         ALERTS
    ====================================================== -->
        @if (TempData["ProviderSuccess"] is string success)
        {
            <div class="sp-alert sp-alert-success">
                @success
            </div>
        }

        @if (TempData["ProviderError"] is string error)
        {
            <div class="sp-alert sp-alert-danger">
                @error
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="sp-alert sp-alert-danger">
                @Model.ErrorMessage
            </div>
        }


        <!-- =====================================================
         PROFILE + NEW SERVICE
    ====================================================== -->

        <div class="sp-main-grid">


            <!-- PROVIDER PROFILE -->

            <div class="sp-panel">

                <div class="sp-panel-heading">

                    <div class="sp-heading-left">

                        <div class="sp-heading-icon">

                            <svg class="sp-icon-lg"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <circle cx="12"
                                        cy="8"
                                        r="4">
                                </circle>

                                <path d="M4 21a8 8 0 0 1 16 0">
                                </path>

                            </svg>

                        </div>

                        <div>

                            <span class="sp-eyebrow">
                                Provider profile
                            </span>

                            <h2>
                                Your business card
                            </h2>

                        </div>

                    </div>

                    <span class="sp-status">
                        @Model.Profile.VerificationStatus
                    </span>

                </div>


                <form asp-action="UpdateProfile"
                      method="post"
                      class="sp-form-grid">

                    @Html.AntiForgeryToken()


                    <div class="sp-field">

                        <label>
                            Display name
                        </label>

                        <input name="DisplayName"
                               value="@Model.Profile.DisplayName"
                               maxlength="100"
                               required />

                    </div>


                    <div class="sp-field">

                        <label>
                            Location
                        </label>

                        <input name="Location"
                               value="@Model.Profile.Location"
                               maxlength="150" />

                    </div>


                    <div class="sp-field">

                        <label>
                            Years of experience
                        </label>

                        <input name="YearsOfExperience"
                               type="number"
                               min="0"
                               max="50"
                               value="@Model.Profile.YearsOfExperience" />

                    </div>


                    <div class="sp-field">

                        <label>
                            Starting price
                        </label>

                        <input name="StartingPrice"
                               type="number"
                               min="0"
                               step="0.01"
                               value="@Model.Profile.StartingPrice" />

                    </div>


                    <div class="sp-field sp-field-full">

                        <label>
                            Professional bio
                        </label>

                        <textarea name="Bio"
                                  rows="4"
                                  maxlength="1000">@Model.Profile.Bio</textarea>

                    </div>


                    <div class="sp-field-full">

                        <button class="sp-btn sp-btn-primary"
                                type="submit">

                            <svg class="sp-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z">
                                </path>

                                <path d="M17 21v-8H7v8">
                                </path>

                                <path d="M7 3v5h8">
                                </path>

                            </svg>

                            Save provider profile

                        </button>

                    </div>

                </form>

            </div>


            <!-- CREATE SERVICE -->

            <div class="sp-panel">

                <div class="sp-panel-heading">

                    <div class="sp-heading-left">

                        <div class="sp-heading-icon">

                            <svg class="sp-icon-lg"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M12 3v18"></path>
                                <path d="M3 12h18"></path>

                                <rect x="4"
                                      y="4"
                                      width="16"
                                      height="16"
                                      rx="3">
                                </rect>

                            </svg>

                        </div>

                        <div>

                            <span class="sp-eyebrow">
                                New service
                            </span>

                            <h2>
                                Publish an offering
                            </h2>

                        </div>

                    </div>

                </div>


                <form asp-action="CreateOffering"
                      method="post"
                      class="sp-form-grid">

                    @Html.AntiForgeryToken()


                    <div class="sp-field">

                        <label>
                            Category
                        </label>

                        <select name="ServiceCategoryId"
                                required>

                            <option value="">
                                Choose category
                            </option>

                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.ServiceCategoryId">
                                    @c.CategoryName
                                </option>
                            }

                        </select>

                    </div>


                    <div class="sp-field">

                        <label>
                            Title
                        </label>

                        <input name="Title"
                               maxlength="150"
                               placeholder="e.g. Emergency plumbing repair"
                               required />

                    </div>


                    <div class="sp-field">

                        <label>
                            Starting price
                        </label>

                        <input name="StartingPrice"
                               type="number"
                               min="0"
                               step="0.01"
                               required />

                    </div>


                    <div class="sp-field">

                        <label>
                            Service area
                        </label>

                        <input name="Location"
                               maxlength="150"
                               placeholder="Melbourne CBD / Remote" />

                    </div>


                    <div class="sp-field sp-field-full">

                        <label>
                            Description
                        </label>

                        <textarea name="Description"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Tell customers what is included."></textarea>

                    </div>


                    <input type="hidden"
                           name="IsAvailable"
                           value="true" />


                    <div class="sp-field-full">

                        <button class="sp-btn sp-btn-primary"
                                type="submit">

                            <svg class="sp-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M12 5v14"></path>
                                <path d="M5 12h14"></path>

                            </svg>

                            Publish service

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- =====================================================
         PUBLISHED SERVICES
    ====================================================== -->

        <div class="sp-panel sp-space-top">

            <div class="sp-panel-heading">

                <div class="sp-heading-left">

                    <div class="sp-heading-icon">

                        <svg class="sp-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M4 5h16v14H4z"></path>
                            <path d="M8 9h8"></path>
                            <path d="M8 13h6"></path>
                            <path d="M8 17h4"></path>

                        </svg>

                    </div>

                    <div>

                        <span class="sp-eyebrow">
                            Your catalogue
                        </span>

                        <h2>
                            Published services
                        </h2>

                    </div>

                </div>

                <span class="sp-count">
                    @Model.Offerings.Count
                </span>

            </div>


            @if (Model.Offerings.Count == 0)
            {
                <div class="sp-empty">

                    <div class="sp-empty-icon">

                        <svg class="sp-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M4 4h16v16H4z"></path>
                            <path d="M8 9h8"></path>
                            <path d="M8 13h6"></path>

                        </svg>

                    </div>

                    You have not published a service yet.

                </div>
            }
            else
            {
                <div class="sp-table-wrap">

                    <table class="sp-table">

                        <thead>

                            <tr>
                                <th>Service</th>
                                <th>Category</th>
                                <th>Location</th>
                                <th>From</th>
                                <th>Status</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Offerings)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @item.Title
                                        </strong>

                                        <small>
                                            @item.Description
                                        </small>

                                    </td>

                                    <td>
                                        @item.Category.CategoryName
                                    </td>

                                    <td>
                                        @(item.Location ?? "Flexible")
                                    </td>

                                    <td>
                                        $@item.StartingPrice.ToString("0.00")
                                    </td>

                                    <td>

                                        <span class="sp-status @(item.IsAvailable ? "good" : "muted")">

                                            @(item.IsAvailable
                                                ? "Available"
                                                : "Paused")

                                        </span>

                                    </td>

                                    <td class="sp-actions-cell">

                                        <form asp-action="DeleteOffering"
                                              asp-route-id="@item.ServiceOfferingId"
                                              method="post"
                                              onsubmit="return confirm('Remove this service offering?');">

                                            @Html.AntiForgeryToken()

                                            <button class="sp-link-danger"
                                                    type="submit">

                                                <svg class="sp-icon"
                                                     viewBox="0 0 24 24"
                                                     aria-hidden="true">

                                                    <path d="M3 6h18"></path>

                                                    <path d="M8 6V4h8v2"></path>

                                                    <path d="M19 6l-1 15H6L5 6"></path>

                                                    <path d="M10 11v6"></path>
                                                    <path d="M14 11v6"></path>

                                                </svg>

                                                Remove

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


        <!-- =====================================================
         OPEN CUSTOMER REQUESTS
    ====================================================== -->

        <div class="sp-panel sp-space-top">

            <div class="sp-panel-heading">

                <div class="sp-heading-left">

                    <div class="sp-heading-icon">

                        <svg class="sp-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M4 5h16v14H4z"></path>

                            <path d="M8 9h8"></path>
                            <path d="M8 13h5"></path>

                            <path d="M15 17h3"></path>

                        </svg>

                    </div>

                    <div>

                        <span class="sp-eyebrow">
                            Lead board
                        </span>

                        <h2>
                            Open customer requests
                        </h2>

                        <p>
                            Send one clear quote. Customers compare
                            offers and select a provider.
                        </p>

                    </div>

                </div>

                <span class="sp-count">
                    @Model.OpenRequests.Count
                </span>

            </div>


            @if (Model.OpenRequests.Count == 0)
            {
                <div class="sp-empty">

                    <div class="sp-empty-icon">

                        <svg class="sp-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M3 12h18"></path>
                            <path d="M12 3v18"></path>

                        </svg>

                    </div>

                    No open customer requests right now.

                </div>
            }
            else
            {
                <div class="sp-card-grid">

                    @foreach (var request in Model.OpenRequests)
                    {
                        var alreadyOffered =
                            Model.MyOffers.Any(
                                x => x.ServiceRequestId ==
                                     request.ServiceRequestId
                            );

                        <article class="sp-lead-card">

                            <div class="sp-card-meta">

                                <span>
                                    @request.Category.CategoryName
                                </span>

                                <span>
                                    @request.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM")
                                </span>

                            </div>


                            <h3>
                                @request.Title
                            </h3>


                            <p>
                                @request.Description
                            </p>


                            <div class="sp-detail-strip">

                                <span>

                                    <svg class="sp-icon"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path>
                                        <circle cx="12" cy="9" r="2.2"></circle>

                                    </svg>

                                    @(request.Location ?? "Flexible")

                                </span>


                                <span>

                                    <svg class="sp-icon"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <circle cx="12"
                                                cy="12"
                                                r="8">
                                        </circle>

                                        <path d="M12 7v5l3 2"></path>

                                    </svg>

                                    @(request.Budget.HasValue
                                        ? "$" + request.Budget.Value.ToString("0.00")
                                        : "Open budget")

                                </span>


                                <span>

                                    <svg class="sp-icon"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <rect x="3"
                                              y="4"
                                              width="18"
                                              height="17"
                                              rx="2">
                                        </rect>

                                        <path d="M16 2v4"></path>
                                        <path d="M8 2v4"></path>
                                        <path d="M3 10h18"></path>

                                    </svg>

                                    @(request.PreferredDate?.ToString("dd MMM yyyy")
                                        ?? "Flexible")

                                </span>

                            </div>


                            @if (alreadyOffered)
                            {
                                <div class="sp-alert sp-alert-neutral">
                                    You already sent an offer for this request.
                                </div>
                            }
                            else
                            {
                                <form asp-action="SendOffer"
                                      asp-route-requestId="@request.ServiceRequestId"
                                      method="post"
                                      class="sp-inline-offer">

                                    @Html.AntiForgeryToken()

                                    <input name="offeredPrice"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           placeholder="Your price"
                                           required />

                                    <input name="message"
                                           maxlength="1000"
                                           placeholder="Short message to customer" />

                                    <button class="sp-btn sp-btn-primary"
                                            type="submit">

                                        <svg class="sp-icon"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M22 2 11 13"></path>

                                            <path d="m22 2-7 20-4-9-9-4Z"></path>

                                        </svg>

                                        Send offer

                                    </button>

                                </form>
                            }

                        </article>
                    }

                </div>
            }

        </div>


        <!-- =====================================================
         OFFER HISTORY
    ====================================================== -->

        <div class="sp-panel sp-space-top">

            <div class="sp-panel-heading">

                <div class="sp-heading-left">

                    <div class="sp-heading-icon">

                        <svg class="sp-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M4 4h16v16H4z"></path>

                            <path d="M8 9h8"></path>
                            <path d="M8 13h8"></path>
                            <path d="M8 17h5"></path>

                        </svg>

                    </div>

                    <div>

                        <span class="sp-eyebrow">
                            Offer history
                        </span>

                        <h2>
                            Your quotes
                        </h2>

                    </div>

                </div>

            </div>


            @if (Model.MyOffers.Count == 0)
            {
                <div class="sp-empty">

                    <div class="sp-empty-icon">

                        <svg class="sp-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M4 4h16v16H4z"></path>
                            <path d="M8 9h8"></path>
                            <path d="M8 13h5"></path>

                        </svg>

                    </div>

                    No offers submitted yet.

                </div>
            }
            else
            {
                <div class="sp-table-wrap">

                    <table class="sp-table">

                        <thead>

                            <tr>
                                <th>Request</th>
                                <th>Your price</th>
                                <th>Customer budget</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var offer in Model.MyOffers)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @offer.Request.Title
                                        </strong>

                                        <small>
                                            @offer.Request.Location
                                        </small>

                                    </td>

                                    <td>
                                        $@offer.OfferedPrice.ToString("0.00")
                                    </td>

                                    <td>
                                        @(offer.Request.Budget.HasValue
                                            ? "$" + offer.Request.Budget.Value.ToString("0.00")
                                            : "—")
                                    </td>

                                    <td>

                                        <span class="sp-status">
                                            @offer.Status
                                        </span>

                                    </td>

                                    <td>
                                        @offer.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>
   

</section>
