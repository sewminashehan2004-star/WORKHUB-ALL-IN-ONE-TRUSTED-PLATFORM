                                        </span>

                                        <strong>
                                            @Model.FullName
                                        </strong>

                                    </div>

                                    <div class="settings-account-item">

                                        <span>
                                            Email
                                        </span>

                                        <strong>
                                            @Model.Email
                                        </strong>

                                    </div>

