                                        ✎ Edit Profile

                                    </a>

                                </div>

                            </div>


                            <!-- =========================================
                 SIGN OUT
            ========================================== -->

                            <div class="settings-section">

                                <div class="settings-heading">

                                    <div class="settings-heading-icon">
                                        <svg class="wh-svg-icon-lg" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <path d="M16 17l5-5-5-5"></path>
                                            <path d="M21 12H9"></path>
                                        </svg>
                                    </div>

                                    <div>

                                        <h4>
                                            Sign Out
                                        </h4>

                                        <p>
                                            End your current WorkHub
                                            session securely on this device.
                                        </p>

                                    </div>

                                </div>

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="settings-logout-button">

                                        Sign Out

                                    </button>

                                </form>

                            </div>


                            <!-- =========================================
                 CHANGE PASSWORD
            ========================================== -->

                            <div class="settings-section full-width">

                                <div class="settings-heading">

                                    <div class="settings-heading-icon">
                                        <svg class="wh-svg-icon-lg" viewBox="0 0 24 24" aria-hidden="true">
                                            <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                                            <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
                                        </svg>
                                    </div>

                                    <div>

                                        <h4>
                                            Change Password
                                        </h4>

                                        <p>
                                            Update your password to
                                            keep your WorkHub account secure.
                                        </p>

                                    </div>

                                </div>


                                <form asp-controller="Account"
                                      asp-action="ChangePassword"
                                      method="post"
                                      id="changePasswordForm">

                                    @Html.AntiForgeryToken()


                                    <!-- CURRENT PASSWORD -->

                                    <div class="settings-field">

                                        <label for="currentPassword">
                                            Current Password
                                        </label>

                                        <input type="password"
                                               id="currentPassword"
                                               name="currentPassword"
                                               class="settings-input"
                                               autocomplete="current-password"
                                               required />

                                    </div>


                                    <!-- NEW + CONFIRM PASSWORD -->

                                    <div class="settings-account-grid">

                                        <div class="settings-field">

                                            <label for="newPassword">
                                                New Password
                                            </label>

                                            <input type="password"
                                                   id="newPassword"
                                                   name="newPassword"
                                                   class="settings-input"
                                                   minlength="6"
                                                   autocomplete="new-password"
                                                   required />

                                            <div class="settings-helper">
                                                Minimum 6 characters.
                                            </div>

                                        </div>


                                        <div class="settings-field">

                                            <label for="confirmPassword">
                                                Confirm New Password
                                            </label>

                                            <input type="password"
                                                   id="confirmPassword"
                                                   name="confirmPassword"
                                                   class="settings-input"
                                                   minlength="6"
                                                   autocomplete="new-password"
                                                   required />

                                        </div>

                                    </div>


                                    <button type="submit"
                                            class="settings-primary-button">

                                        Change Password

                                    </button>

                                </form>

                            </div>


                            <!-- =========================================
                 DANGER ZONE
            ========================================== -->

                            <div class="settings-section full-width danger">

                                <div class="settings-heading">

                                    <div class="settings-heading-icon">
                                        <svg class="wh-svg-icon-lg" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 9v4"></path>
                                            <path d="M12 17h.01"></path>
                                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path>
                                        </svg>
                                    </div>

                                    <div>

                                        <h4 style="color:#B91C1C;">
                                            Danger Zone
                                        </h4>

                                        <p>
                                            Delete your WorkHub account
                                            and disable your professional profiles.
                                        </p>

                                    </div>

                                </div>


                                <!-- WARNING -->

                                <div class="delete-warning">

                                    <strong>
                                        Warning:
                                    </strong>

                                    Deleting your account will prevent
                                    you from signing in and will deactivate
                                    your Job Seeker, Service Provider and
                                    Marketplace Seller profiles.

                                </div>


                                <!-- DELETE ACCOUNT FORM -->

                                <form asp-controller="Account"
                                      asp-action="DeleteAccount"
                                      method="post"
                                      id="deleteAccountForm">

                                    @Html.AntiForgeryToken()


                                    <!-- CURRENT PASSWORD -->

                                    <div class="settings-field">

                                        <label for="deletePassword">
                                            Current Password
                                        </label>

                                        <input type="password"
                                               id="deletePassword"
                                               name="password"
                                               class="settings-input"
                                               autocomplete="current-password"
                                               required />

                                    </div>


                                    <!-- DELETE CONFIRMATION -->

                                    <div class="settings-field">

                                        <label for="deleteConfirmation">
                                            Type DELETE to confirm
                                        </label>

                                        <input type="text"
                                               id="deleteConfirmation"
                                               name="confirmation"
                                               class="settings-input"
                                               placeholder="DELETE"
                                               autocomplete="off"
                                               required />

                                        <div class="settings-helper">
                                            Type DELETE exactly to confirm account deletion.
                                        </div>

                                    </div>


                                    <!-- DELETE BUTTON -->

                                    <button type="submit"
                                            class="delete-button">

                                        Delete WorkHub Account

                                    </button>




                                </form>

                            </div>

                        </div>

                    </div>

                </section>



                @section Scripts
                {
                    <script>

                                        document.addEventListener(
                                            "DOMContentLoaded",
                                            function() {


                                                // =====================================
                                                // TAB SYSTEM
                                                // =====================================

                                                const tabs =
                                                    document.querySelectorAll(
                                                        ".sidebar-tab"
                                                    );


                                                const panels =
                                                    document.querySelectorAll(
                                                        ".tab-panel"
                                                    );


                                                function openTab(tabName) {
                                                    tabs.forEach(
                                                        function(tab) {
                                                            tab.classList.remove(
                                                                "active"
                                                            );
                                                        }
                                                    );


                                                    panels.forEach(
                                                        function(panel) {
                                                            panel.classList.remove(
                                                                "active"
                                                            );
                                                        }
                                                    );


                                                    const selectedTab =
                                                        document.querySelector(
                                                            '.sidebar-tab[data-tab="' +
                                                            tabName +
                                                            '"]'
                                                        );


                                                    const selectedPanel =
                                                        document.getElementById(
                                                            tabName
                                                        );


                                                    if (selectedTab) {
                                                        selectedTab.classList.add(
                                                            "active"
                                                        );
                                                    }


                                                    if (selectedPanel) {
                                                        selectedPanel.classList.add(
                                                            "active"
                                                        );
                                                    }


                                                    if (
                                                        history
                                                        &&
                                                        history.replaceState
                                                    ) {
                                                        history.replaceState(
                                                            null,
                                                            "",
                                                            "#" + tabName
                                                        );
                                                    }
                                                }


                                                tabs.forEach(
                                                    function(tab) {
                                                        tab.addEventListener(
                                                            "click",
                                                            function() {
                                                                openTab(
                                                                    this.dataset.tab
                                                                );
                                                            }
                                                        );
                                                    }
                                                );


                                                // =====================================
                                                // OPEN TAB FROM URL HASH
                                                // =====================================

                                                const hash =
                                                    window.location.hash
                                                        .replace(
                                                            "#",
                                                            ""
                                                        );


                                                if (
                                                    hash
                                                    &&
                                                    document.getElementById(
                                                        hash
                                                    )
                                                ) {
                                                    openTab(
                                                        hash
                                                    );
                                                }


                                                // =====================================
                                                // CHANGE PASSWORD VALIDATION
                                                // =====================================

                                                const changePasswordForm =
                                                    document.getElementById(
                                                        "changePasswordForm"
                                                    );


                                                changePasswordForm?.addEventListener(
                                                    "submit",
                                                    function(event) {
                                                        const newPassword =
                                                            document.getElementById(
                                                                "newPassword"
                                                            )?.value
                                                            ??
                                                            "";


                                                        const confirmPassword =
                                                            document.getElementById(
                                                                "confirmPassword"
                                                            )?.value
                                                            ??
                                                            "";


                                                        if (
                                                            newPassword !==
                                                            confirmPassword
                                                        ) {
                                                            event.preventDefault();


                                                            alert(
                                                                "New password and confirmation password do not match."
                                                            );
                                                        }
                                                    }
                                                );


                                                // =====================================
                                                // DELETE ACCOUNT SAFETY
                                                // =====================================

                                                const deleteAccountForm =
                                                    document.getElementById(
                                                        "deleteAccountForm"
                                                    );


                                                deleteAccountForm?.addEventListener(
                                                    "submit",
                                                    function(event) {
                                                        const confirmation =
                                                            document.getElementById(
                                                                "deleteConfirmation"
                                                            )?.value
                                                                .trim()
                                                                .toUpperCase()
                                                            ??
                                                            "";


                                                        if (
                                                            confirmation !==
                                                            "DELETE"
                                                        ) {
                                                            event.preventDefault();


                                                            alert(
                                                                "Please type DELETE to confirm account deletion."
                                                            );


                                                            return;
                                                        }


                                                        const confirmed =
                                                            window.confirm(
                                                                "Are you sure you want to delete your WorkHub account? You will no longer be able to sign in."
                                                            );


                                                        if (!confirmed) {
                                                            event.preventDefault();
                                                        }
                                                    }
                                                );


                                                // =====================================
                                                // NOTIFICATION FORMS
                                                // =====================================

                                                const notificationForms =
                                                    document.querySelectorAll(
                                                        ".notification-ajax-form"
                                                    );


                                                notificationForms.forEach(
                                                    function(form) {
                                                        form.addEventListener(
                                                            "submit",
                                                            async function(event) {
                                                                event.preventDefault();


                                                                const button =
                                                                    form.querySelector(
                                                                        "button"
                                                                    );


                                                                if (button) {
                                                                    button.disabled =
                                                                        true;

                                                                    button.textContent =
                                                                        "Updating...";
                                                                }


                                                                try {
                                                                    const formData =
                                                                        new FormData(
                                                                            form
                                                                        );


                                                                    const response =
                                                                        await fetch(
                                                                            form.action,
                                                                            {
                                                                                method:
                                                                                    "POST",

                                                                                body:
                                                                                    formData,

                                                                                credentials:
                                                                                    "same-origin"
                                                                            }
                                                                        );


                                                                    if (!response.ok) {
                                                                        throw new Error();
                                                                    }


                                                                    window.location.href =
                                                                        "/Account/Profile#notifications";
                                                                }
                                                                catch {
                                                                    if (button) {
                                                                        button.disabled =
                                                                            false;

                                                                        button.textContent =
                                                                            "Try again";
                                                                    }


                                                                    alert(
                                                                        "Unable to update notification."
                                                                    );
                                                                }
                                                            }
                                                        );
                                                    }
                                                );


                                                // =====================================
                                                // SAFE URL
                                                // =====================================

                                                function getSafeUrl(value) {
                                                    if (!value) {
                                                        return null;
                                                    }


                                                    let url =
                                                        value.trim();


                                                    if (!url) {
                                                        return null;
                                                    }


                                                    if (
                                                        !url.startsWith(
                                                            "http://"
                                                        )
                                                        &&
                                                        !url.startsWith(
                                                            "https://"
                                                        )
                                                    ) {
                                                        url =
                                                            "https://" +
                                                            url;
                                                    }


                                                    try {
                                                        const parsed =
                                                            new URL(
                                                                url
                                                            );


                                                        if (
                                                            parsed.protocol !==
                                                            "http:"
                                                            &&
                                                            parsed.protocol !==
                                                            "https:"
                                                        ) {
                                                            return null;
                                                        }


                                                        return parsed.href;
                                                    }
                                                    catch {
                                                        return null;
                                                    }
                                                }


                                                // =====================================
                                                // EXTERNAL LINK
                                                // =====================================

                                                function setupExternalLink(
                                                    elementId,
                                                    value) {
                                                    const element =
                                                        document.getElementById(
                                                            elementId
                                                        );


                                                    if (!element) {
                                                        return false;
                                                    }


                                                    const safeUrl =
                                                        getSafeUrl(
                                                            value
                                                        );


                                                    if (!safeUrl) {
                                                        element.style.display =
                                                            "none";

                                                        return false;
                                                    }


                                                    element.href =
                                                        safeUrl;


                                                    element.style.display =
                                                        "inline-flex";


                                                    return true;
                                                }


                                                // =====================================
                                                // LOAD GENERAL PROFILE
                                                // =====================================

                                                loadDashboardProfile();


                                                async function loadDashboardProfile() {
                                                    try {
                                                        const response =
                                                            await fetch(
                                                                "/UserProfile/DashboardSummary",
                                                                {
                                                                    credentials:
                                                                        "same-origin",

                                                                    cache:
                                                                        "no-store"
                                                                }
                                                            );


                                                        if (!response.ok) {
                                                            return;
                                                        }


                                                        const profile =
                                                            await response.json();


                                                        // LOCATION

                                                        const locationParts =
                                                            [];


                                                        if (profile.country) {
                                                            locationParts.push(
                                                                profile.country
                                                            );
                                                        }


                                                        if (profile.location) {
                                                            locationParts.push(
                                                                profile.location
                                                            );
                                                        }


                                                        if (
                                                            locationParts.length
                                                            > 0
                                                        ) {
                                                            const box =
                                                                document.getElementById(
                                                                    "dashboardProfileLocation"
                                                                );


                                                            const text =
                                                                document.getElementById(
                                                                    "dashboardProfileLocationText"
                                                                );


                                                            if (box && text) {
                                                                text.textContent =
                                                                    locationParts.join(
                                                                        " · "
                                                                    );


                                                                box.style.display =
                                                                    "flex";
                                                            }
                                                        }


                                                        // ABOUT

                                                        if (profile.about) {
                                                            let about =
                                                                profile.about.trim();


                                                            if (
                                                                about.length
                                                                > 120
                                                            ) {
                                                                about =
                                                                    about.substring(
                                                                        0,
                                                                        120
                                                                    )
                                                                    +
                                                                    "...";
                                                            }


                                                            const aboutBox =
                                                                document.getElementById(
                                                                    "dashboardProfileAbout"
                                                                );


                                                            if (aboutBox) {
                                                                aboutBox.textContent =
                                                                    about;


                                                                aboutBox.style.display =
                                                                    "block";
                                                            }
                                                        }


                                                        // WEBSITE

                                                        const websiteLink =
                                                            document.getElementById(
                                                                "dashboardWebsiteLink"
                                                            );


                                                        const websiteEmpty =
                                                            document.getElementById(
                                                                "dashboardWebsiteEmpty"
                                                            );


                                                        const websiteUrl =
                                                            getSafeUrl(
                                                                profile.website
                                                            );


                                                        if (
                                                            websiteUrl
                                                            &&
                                                            websiteLink
                                                        ) {
                                                            websiteLink.href =
                                                                websiteUrl;


                                                            websiteLink.textContent =
                                                                profile.website;


                                                            websiteLink.style.display =
                                                                "inline";


                                                            if (websiteEmpty) {
                                                                websiteEmpty.style.display =
                                                                    "none";
                                                            }
                                                        }


                                                        // CONNECTED APPS

                                                        let appCount =
                                                            0;


                                                        if (
                                                            setupExternalLink(
                                                                "dashboardLinkedIn",
                                                                profile.linkedInUrl
                                                            )
                                                        ) {
                                                            appCount++;
                                                        }


                                                        if (
                                                            setupExternalLink(
                                                                "dashboardFacebook",
                                                                profile.facebookUrl
                                                            )
                                                        ) {
                                                            appCount++;
                                                        }


                                                        if (
                                                            setupExternalLink(
                                                                "dashboardGitHub",
                                                                profile.gitHubUrl
                                                            )
                                                        ) {
                                                            appCount++;
                                                        }


                                                        if (
                                                            setupExternalLink(
                                                                "dashboardInstagram",
                                                                profile.instagramUrl
                                                            )
                                                        ) {
                                                            appCount++;
                                                        }


                                                        if (appCount > 0) {
                                                            const emptyApps =
                                                                document.getElementById(
                                                                    "dashboardAppsEmpty"
                                                                );


                                                            if (emptyApps) {
                                                                emptyApps.style.display =
                                                                    "none";
                                                            }
                                                        }
                                                    }
                                                    catch {
                                                        console.log(
                                                            "Dashboard profile information could not be loaded."
                                                        );
                                                    }
                                                }


                                                // =====================================
                                                // LOAD NEWS & UPDATES
                                                // =====================================

                                                loadNewsUpdates();


                                                async function loadNewsUpdates() {
                                                    const loading =
                                                        document.getElementById(
                                                            "newsLoading"
                                                        );


                                                    const errorBox =
                                                        document.getElementById(
                                                            "newsError"
                                                        );


                                                    const emptyBox =
                                                        document.getElementById(
                                                            "newsEmpty"
                                                        );


                                                    const list =
                                                        document.getElementById(
                                                            "newsList"
                                                        );


                                                    if (!list) {
                                                        return;
                                                    }


                                                    // CLEAR OLD CONTENT

                                                    list.innerHTML =
                                                        "";


                                                    if (errorBox) {
                                                        errorBox.style.display =
                                                            "none";
                                                    }


                                                    if (emptyBox) {
                                                        emptyBox.style.display =
                                                            "none";
                                                    }


                                                    if (loading) {
                                                        loading.style.display =
                                                            "block";
                                                    }


                                                    try {
                                                        const response =
                                                            await fetch(
                                                                "/UserNews/List",
                                                                {
                                                                    method:
                                                                        "GET",

                                                                    credentials:
                                                                        "same-origin",

                                                                    cache:
                                                                        "no-store",

                                                                    headers:
                                                                    {
                                                                        "Accept":
                                                                            "application/json"
                                                                    }
                                                                }
                                                            );


                                                        if (loading) {
                                                            loading.style.display =
                                                                "none";
                                                        }


                                                        if (!response.ok) {
                                                            if (errorBox) {
                                                                errorBox.style.display =
                                                                    "block";
                                                            }


                                                            return;
                                                        }


                                                        const newsItems =
                                                            await response.json();


                                                        if (
                                                            !Array.isArray(
                                                                newsItems
                                                            )
                                                            ||
                                                            newsItems.length === 0
                                                        ) {
                                                            if (emptyBox) {
                                                                emptyBox.style.display =
                                                                    "block";
                                                            }


                                                            return;
                                                        }


                                                        newsItems.forEach(
                                                            function(news) {
                                                                createNewsCard(
                                                                    news,
                                                                    list
                                                                );
                                                            }
                                                        );
                                                    }
                                                    catch (error) {
                                                        if (loading) {
                                                            loading.style.display =
                                                                "none";
                                                        }


                                                        if (errorBox) {
                                                            errorBox.style.display =
                                                                "block";
                                                        }


                                                        console.log(
                                                            "News and updates could not be loaded.",
                                                            error
                                                        );
                                                    }
                                                }


                                                // =====================================
                                                // CREATE NEWS CARD
                                                // =====================================

                                                function createNewsCard(
                                                    news,
                                                    list) {
                                                    const card =
                                                        document.createElement(
                                                            "article"
                                                        );


                                                    card.className =
                                                        "profile-news-card";


                                                    // TOP

                                                    const top =
                                                        document.createElement(
                                                            "div"
                                                        );


                                                    top.className =
                                                        "profile-news-top";


                                                    const category =
                                                        document.createElement(
                                                            "span"
                                                        );


                                                    category.className =
                                                        "profile-news-category";


                                                    category.textContent =
                                                        news.category
                                                        ||
                                                        "General";


                                                    const date =
                                                        document.createElement(
                                                            "span"
                                                        );


                                                    date.className =
                                                        "profile-news-date";


                                                    const rawDate =
                                                        news.publishedAt
                                                        ||
                                                        news.createdAt;


                                                    if (rawDate) {
                                                        const parsedDate =
                                                            new Date(
                                                                rawDate
                                                            );


                                                        if (
                                                            !Number.isNaN(
                                                                parsedDate.getTime()
                                                            )
                                                        ) {
                                                            date.textContent =
                                                                parsedDate
                                                                    .toLocaleDateString(
                                                                        undefined,
                                                                        {
                                                                            day:
                                                                                "2-digit",

                                                                            month:
                                                                                "short",

                                                                            year:
                                                                                "numeric"
                                                                        }
                                                                    );
                                                        }
                                                    }


                                                    top.appendChild(
                                                        category
                                                    );


                                                    top.appendChild(
                                                        date
                                                    );


                                                    // TITLE

                                                    const title =
                                                        document.createElement(
                                                            "h4"
                                                        );


                                                    title.className =
                                                        "profile-news-title";


                                                    title.textContent =
                                                        news.title
                                                        ||
                                                        "WorkHub Update";


                                                    // SUMMARY

                                                    const summary =
                                                        document.createElement(
                                                            "p"
                                                        );


                                                    summary.className =
                                                        "profile-news-summary";


                                                    if (
                                                        news.summary
                                                        &&
                                                        news.summary.trim()
                                                    ) {
                                                        summary.textContent =
                                                            news.summary;
                                                    }
                                                    else {
                                                        const fallback =
                                                            news.content
                                                            ||
                                                            "Read the latest WorkHub update.";


                                                        summary.textContent =
                                                            fallback.length > 180
                                                                ? fallback.substring(
                                                                    0,
                                                                    180
                                                                )
                                                                +
                                                                "..."
                                                                : fallback;
                                                    }


                                                    // FULL CONTENT

                                                    const content =
                                                        document.createElement(
                                                            "div"
                                                        );


                                                    content.className =
                                                        "profile-news-content";


                                                    content.textContent =
                                                        news.content
                                                        ||
                                                        "";


                                                    // FOOTER

                                                    const footer =
                                                        document.createElement(
                                                            "div"
                                                        );


                                                    footer.className =
                                                        "profile-news-footer";


                                                    const author =
                                                        document.createElement(
                                                            "span"
                                                        );


                                                    author.className =
                                                        "profile-news-author";


                                                    author.textContent =
                                                        "Published by "
                                                        +
                                                        (
                                                            news.createdBy
                                                            ||
                                                            "WorkHub Admin"
                                                        );


                                                    const readButton =
                                                        document.createElement(
                                                            "button"
                                                        );


                                                    readButton.type =
                                                        "button";


                                                    readButton.className =
                                                        "profile-news-read-button";


                                                    readButton.textContent =
                                                        "Read More";


                                                    readButton.addEventListener(
                                                        "click",
                                                        function() {
                                                            const isOpen =
                                                                content.classList
                                                                    .contains(
                                                                        "open"
                                                                    );


                                                            if (isOpen) {
                                                                content.classList.remove(
                                                                    "open"
                                                                );


                                                                readButton.textContent =
                                                                    "Read More";
                                                            }
                                                            else {
                                                                content.classList.add(
                                                                    "open"
                                                                );


                                                                readButton.textContent =
                                                                    "Show Less";
                                                            }
                                                        }
                                                    );


                                                    footer.appendChild(
                                                        author
                                                    );


                                                    footer.appendChild(
                                                        readButton
                                                    );


                                                    // BUILD

                                                    card.appendChild(
                                                        top
                                                    );


                                                    card.appendChild(
                                                        title
                                                    );


                                                    card.appendChild(
                                                        summary
                                                    );


                                                    card.appendChild(
                                                        footer
                                                    );


                                                    card.appendChild(
                                                        content
                                                    );


                                                    list.appendChild(
                                                        card
                                                    );
                                                }


                                            }
                                        );

                    </script>
                }
