@model Workhub_Web.Models.CompanyRegisterViewModel

@{
    ViewData["Title"] = "Company Registration";
}

<style>

    :root {
        --company-orange: #FD5000;
        --company-orange-dark: #D94300;
        --company-orange-soft: #FFF3EC;
        --company-dark: #0F172A;
        --company-text: #64748B;
        --company-border: #E2E8F0;
        --company-bg: #F8FAFC;
        --company-red: #DC2626;
    }


    .company-register-page {
        min-height: calc(100vh - 70px);
        padding: 55px 20px 90px;
        background: radial-gradient( circle at 90% 10%, rgba(253, 80, 0, .10), transparent 30% ), var(--company-bg);
    }


    .company-register-container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
    }


    .company-back-link {
        margin-bottom: 20px;
        display: inline-flex;
        color: #64748B;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
    }


        .company-back-link:hover {
            color: var(--company-orange-dark);
        }


    .company-register-card {
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(300px, .8fr) minmax(0, 1.2fr);
        border: 1px solid var(--company-border);
        border-radius: 20px;
        background: #FFFFFF;
        box-shadow: 0 18px 50px rgba(15, 23, 42, .09);
    }


    /* LEFT */

    .company-register-left {
        padding: 48px 38px;
        background: radial-gradient( circle at 85% 15%, rgba(253, 80, 0, .34), transparent 30% ), linear-gradient( 145deg, #0F172A, #1E293B 65%, #431407 );
    }


    .company-register-badge {
        display: inline-block;
        margin-bottom: 18px;
        padding: 6px 10px;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 30px;
        background: rgba(255,255,255,.07);
        color: #FDBA74;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .company-register-left h1 {
        margin: 0 0 14px;
        color: #FFFFFF;
        font-size: 35px;
        font-weight: 950;
        line-height: 1.15;
    }


    .company-register-left > p {
        margin: 0 0 30px;
        color: #CBD5E1;
        font-size: 11px;
        line-height: 1.7;
    }


    .company-process {
        display: grid;
        gap: 11px;
    }


    .company-process-item {
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 1px solid rgba(255,255,255,.09);
        border-radius: 10px;
        background: rgba(255,255,255,.05);
    }


    .company-process-number {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(253,80,0,.20);
        color: #FDBA74;
        font-size: 10px;
        font-weight: 900;
    }


    .company-process-item strong {
        display: block;
        margin-bottom: 2px;
        color: #FFFFFF;
        font-size: 10px;
        font-weight: 850;
    }


    .company-process-item span {
        color: #CBD5E1;
        font-size: 8px;
        line-height: 1.4;
    }


    /* FORM */

    .company-register-form {
        padding: 45px;
    }


    .company-form-heading {
        margin-bottom: 27px;
    }


        .company-form-heading span {
            display: block;
            margin-bottom: 6px;
            color: var(--company-orange);
            font-size: 9px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
        }


        .company-form-heading h2 {
            margin: 0 0 8px;
            color: var(--company-dark);
            font-size: 27px;
            font-weight: 950;
        }


        .company-form-heading p {
            margin: 0;
            color: var(--company-text);
            font-size: 10px;
            line-height: 1.6;
        }


    .validation-summary-errors {
        margin-bottom: 18px;
        padding: 13px 15px;
        border: 1px solid #FECACA;
        border-radius: 9px;
        background: #FEF2F2;
        color: #B91C1C;
        font-size: 10px;
    }


        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }


    .company-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }


    .company-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


        .company-field.full {
            grid-column: 1 / -1;
        }


        .company-field label {
            color: #334155;
            font-size: 10px;
            font-weight: 850;
        }


    .required-star {
        color: var(--company-orange);
    }


    .company-input {
        width: 100%;
        height: 47px;
        padding: 0 13px;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        background: #FFFFFF;
        color: var(--company-dark);
        font-size: 11px;
        outline: none;
    }


        .company-input:focus {
            border-color: var(--company-orange);
            box-shadow: 0 0 0 3px rgba(253, 80, 0, .10);
        }


    .field-validation-error {
        color: var(--company-red);
        font-size: 8px;
        font-weight: 700;
    }


    .company-field-help {
        color: #94A3B8;
        font-size: 8px;
        line-height: 1.5;
    }


    .company-approval-note {
        margin-top: 22px;
        padding: 14px 15px;
        border: 1px solid #FED7C2;
        border-radius: 9px;
        background: #FFF8F4;
        color: #7C2D12;
        font-size: 9px;
        line-height: 1.6;
    }


        .company-approval-note strong {
            display: block;
            margin-bottom: 3px;
            color: var(--company-orange-dark);
            font-size: 10px;
        }


    .company-submit {
        width: 100%;
        margin-top: 18px;
        padding: 13px 17px;
        border: none;
        border-radius: 9px;
        background: var(--company-orange);
        color: #FFFFFF;
        font-size: 11px;
        font-weight: 900;
        cursor: pointer;
    }


        .company-submit:hover {
            background: var(--company-orange-dark);
        }


    .company-login-note {
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid #F1F5F9;
        color: #64748B;
        font-size: 9px;
        text-align: center;
    }


        .company-login-note a {
            color: var(--company-orange-dark);
            font-weight: 900;
            text-decoration: none;
        }


    @@media (max-width: 850px) {

        .company-register-card {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 600px) {

        .company-register-page {
            padding: 35px 14px 60px;
        }


        .company-register-left,
        .company-register-form {
            padding: 30px 22px;
        }


        .company-form-grid {
            grid-template-columns: 1fr;
        }


        .company-field.full {
            grid-column: auto;
        }
    }

</style>


<section class="company-register-page">

    <div class="company-register-container">


        <a asp-controller="CompanyPortal"
           asp-action="Index"
           class="company-back-link">

            ← Back to Company Portal

        </a>


        <div class="company-register-card">


            <!-- LEFT -->

            <div class="company-register-left">


                <span class="company-register-badge">
                    WorkHub Company Portal
                </span>


                <h1>
                    Register Your Company
                </h1>


                <p>
                    Submit your company or organization
                    registration request. A WorkHub
                    administrator will review the request
                    before the account becomes active.
                </p>


                <div class="company-process">


                    <div class="company-process-item">

                        <div class="company-process-number">
                            1
                        </div>

                        <div>
                            <strong>
                                Submit Registration
                            </strong>

                            <span>
                                Enter your company and
                                account information.
                            </span>
                        </div>

                    </div>


                    <div class="company-process-item">

                        <div class="company-process-number">
                            2
                        </div>

                        <div>
                            <strong>
                                Admin Review
                            </strong>

                            <span>
                                WorkHub reviews the company
                                registration request.
                            </span>
                        </div>

                    </div>


                    <div class="company-process-item">

                        <div class="company-process-number">
                            3
                        </div>

                        <div>
                            <strong>
                                Account Approval
                            </strong>

                            <span>
                                Approved company accounts
                                become active.
                            </span>
                        </div>

                    </div>


                    <div class="company-process-item">

                        <div class="company-process-number">
                            4
                        </div>

                        <div>
                            <strong>
                                Access Dashboard
                            </strong>

                            <span>
                                Sign in and start managing
                                jobs through WorkHub.
                            </span>
                        </div>

                    </div>


                </div>

            </div>


            <!-- FORM -->

            <div class="company-register-form">


                <div class="company-form-heading">

                    <span>
                        Registration Request
                    </span>

                    <h2>
                        Company / Organization Details
                    </h2>

                    <p>
                        Fields marked with * are required.
                    </p>

                </div>


                <div asp-validation-summary="ModelOnly">
                </div>


                <form asp-controller="CompanyPortal"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="company-form-grid">


                        <!-- COMPANY NAME -->

                        <div class="company-field full">

                            <label asp-for="CompanyName">
                                Company / Organization Name
                                <span class="required-star">*</span>
                            </label>

                            <input asp-for="CompanyName"
                                   class="company-input"
                                   placeholder="Example: ABC Engineering Pty Ltd" />

                            <span asp-validation-for="CompanyName">
                            </span>

                        </div>


                        <!-- CONTACT NAME -->

                        <div class="company-field full">

                            <label asp-for="FullName">
                                Contact Person Name
                                <span class="required-star">*</span>
                            </label>

                            <input asp-for="FullName"
                                   class="company-input"
                                   placeholder="Example: John Smith"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName">
                            </span>

                            <span class="company-field-help">
                                The person responsible for
                                managing this WorkHub company account.
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="company-field">

                            <label asp-for="Email">
                                Company Email
                                <span class="required-star">*</span>
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="company-input"
                                   placeholder="company@example.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email">
                            </span>

                        </div>


                        <!-- PHONE -->

                        <div class="company-field">

                            <label asp-for="Phone">
                                Phone
                            </label>

                            <input asp-for="Phone"
                                   type="tel"
                                   class="company-input"
                                   placeholder="+61 ..."
                                   autocomplete="tel" />

                            <span asp-validation-for="Phone">
                            </span>

                        </div>


                        <!-- LOCATION -->

                        <div class="company-field full">

                            <label asp-for="Location">
                                Company Location
                                <span class="required-star">*</span>
                            </label>

                            <input asp-for="Location"
                                   class="company-input"
                                   placeholder="Example: Melbourne, Victoria" />

                            <span asp-validation-for="Location">
                            </span>

                        </div>


                        <!-- PASSWORD -->

                        <div class="company-field">

                            <label asp-for="Password">
                                Password
                                <span class="required-star">*</span>
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="company-input"
                                   placeholder="Minimum 6 characters"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password">
                            </span>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="company-field">

                            <label asp-for="ConfirmPassword">
                                Confirm Password
                                <span class="required-star">*</span>
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="company-input"
                                   placeholder="Enter password again"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword">
                            </span>

                        </div>


                    </div>


                    <div class="company-approval-note">

                        <strong>
                            Admin approval required
                        </strong>

                        Submitting this form does not
                        immediately activate the company account.
                        Your request will first be reviewed by
                        a WorkHub administrator.

                    </div>


                    <button type="submit"
                            class="company-submit">

                        Submit Registration Request

                    </button>


                </form>


                <div class="company-login-note">

                    Already have an approved company account?

                    <a asp-controller="CompanyPortal"
                       asp-action="Login">

                        Company Sign In

                    </a>

                </div>


            </div>


        </div>


    </div>

</section>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}