@model Workhub_Web.Models.JobSeekerApplicationViewModel

@{
    ViewData["Title"] = "Job Seeker Profile";

    var remainingSkills =
        Model.AvailableSkills
            .Where(
                available =>
                    !Model.Skills.Any(
                        saved =>
                            saved.SkillId ==
                            available.SkillId))
            .ToList();
}


<style>

    :root {
        --wh-orange: #FD5000;
        --wh-orange-dark: #D94300;
        --wh-orange-hover: #B93800;
        --wh-orange-soft: #FFF2EB;
        --wh-dark: #0F172A;
        --wh-text: #64748B;
        --wh-text-dark: #334155;
        --wh-border: #E2E8F0;
        --wh-bg: #F8FAFC;
        --wh-green: #16A34A;
        --wh-green-soft: #F0FDF4;
        --wh-red: #DC2626;
        --wh-red-soft: #FEF2F2;
        --wh-blue: #2563EB;
        --wh-blue-soft: #EFF6FF;
    }


    /* =========================================
           PAGE
        ========================================= */

    .jobseeker-page {
        min-height: calc(100vh - 76px);
        padding: 48px 28px 90px;
        background: var(--wh-bg);
    }


    .jobseeker-container {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
    }


    /* =========================================
           PAGE HEADER
        ========================================= */

    .jobseeker-header {
        margin-bottom: 26px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
    }


    .jobseeker-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: var(--wh-orange);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }


    .jobseeker-header h1 {
        margin: 0 0 8px;
        color: var(--wh-dark);
        font-size: 36px;
        font-weight: 900;
        letter-spacing: -.5px;
    }


    .jobseeker-header p {
        max-width: 740px;
        margin: 0;
        color: var(--wh-text);
        font-size: 13px;
        line-height: 1.7;
    }


    .back-dashboard {
        padding: 10px 16px;
        border: 1px solid var(--wh-border);
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--wh-text-dark);
        font-size: 11px;
        font-weight: 850;
        text-decoration: none;
        white-space: nowrap;
        transition: .2s ease;
    }


        .back-dashboard:hover {
            border-color: var(--wh-orange);
            color: var(--wh-orange-dark);
            background: var(--wh-orange-soft);
        }


    /* =========================================
           SECTION NAVIGATION
        ========================================= */

    .section-navigation {
        margin-bottom: 24px;
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        border: 1px solid var(--wh-border);
        border-radius: 13px;
        background: #FFFFFF;
    }


    .section-nav-link {
        padding: 8px 12px;
        border-radius: 8px;
        color: #475569;
        font-size: 10px;
        font-weight: 850;
        text-decoration: none;
        transition: .2s ease;
    }


        .section-nav-link:hover {
            background: var(--wh-orange-soft);
            color: var(--wh-orange-dark);
        }


    /* =========================================
           MESSAGES
        ========================================= */

    .jobseeker-message {
        margin-bottom: 20px;
        padding: 14px 17px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 750;
    }


    .jobseeker-success {
        border: 1px solid #BBF7D0;
        background: var(--wh-green-soft);
        color: #15803D;
    }


    .jobseeker-error {
        border: 1px solid #FECACA;
        background: var(--wh-red-soft);
        color: #B91C1C;
    }


    /* =========================================
           MAIN CARD
        ========================================= */

    .jobseeker-card {
        margin-bottom: 22px;
        padding: 28px;
        scroll-margin-top: 95px;
        border: 1px solid var(--wh-border);
        border-radius: 16px;
        background: #FFFFFF;
        box-shadow: 0 7px 24px rgba(15, 23, 42, .04);
    }


    .card-header {
        margin-bottom: 23px;
        padding-bottom: 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid #F1F5F9;
    }


        .card-header h2 {
            margin: 0;
            color: var(--wh-dark);
            font-size: 19px;
            font-weight: 900;
        }


        .card-header span {
            color: var(--wh-text);
            font-size: 10px;
            font-weight: 650;
        }


    /* =========================================
           PERSONAL PROFILE
        ========================================= */

    .personal-profile-header {
        margin-bottom: 23px;
        display: flex;
        align-items: center;
        gap: 16px;
    }


    .personal-avatar {
        position: relative;
        width: 75px;
        height: 75px;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--wh-orange);
        color: #FFFFFF;
        font-size: 27px;
        font-weight: 900;
    }


        .personal-avatar img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .personal-profile-header h3 {
        margin: 0 0 4px;
        color: var(--wh-dark);
        font-size: 20px;
        font-weight: 900;
    }


    .personal-profile-header p {
        margin: 0;
        color: var(--wh-text);
        font-size: 11px;
    }


    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }


    .detail-box {
        padding: 16px 17px;
        border-radius: 10px;
        background: #F8FAFC;
    }


        .detail-box.full {
            grid-column: 1 / -1;
        }


    .detail-label {
        display: block;
        margin-bottom: 6px;
        color: #94A3B8;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }


    .detail-value {
        color: var(--wh-text-dark);
        font-size: 12px;
        font-weight: 750;
        word-break: break-word;
    }


    .personal-footer {
        margin-top: 20px;
        padding-top: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        border-top: 1px solid #F1F5F9;
    }


        .personal-footer p {
            margin: 0;
            color: var(--wh-text);
            font-size: 10px;
        }


    .outline-button {
        padding: 9px 14px;
        border: 1px solid var(--wh-orange);
        border-radius: 8px;
        background: #FFFFFF;
        color: var(--wh-orange-dark);
        font-size: 10px;
        font-weight: 850;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }


        .outline-button:hover {
            background: var(--wh-orange-soft);
            color: var(--wh-orange-dark);
        }


    /* =========================================
           FORM
        ========================================= */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px;
    }


    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


        .form-group.full {
            grid-column: 1 / -1;
        }


        .form-group label {
            color: var(--wh-text-dark);
            font-size: 11px;
            font-weight: 800;
        }


    .form-control-custom {
        width: 100%;
        padding: 12px 13px;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        background: #FFFFFF;
        color: var(--wh-dark);
        font-size: 12px;
        outline: none;
        transition: .2s ease;
    }


        .form-control-custom:focus {
            border-color: var(--wh-orange);
            box-shadow: 0 0 0 3px rgba(253, 80, 0, .10);
        }


    textarea.form-control-custom {
        min-height: 125px;
        resize: vertical;
        line-height: 1.6;
    }


    .field-help {
        color: #94A3B8;
        font-size: 9px;
        line-height: 1.5;
    }


    .primary-button {
        margin-top: 19px;
        padding: 11px 19px;
        border: none;
        border-radius: 8px;
        background: var(--wh-orange-dark);
        color: #FFFFFF;
        font-size: 10px;
        font-weight: 900;
        cursor: pointer;
        transition: .2s ease;
    }


        .primary-button:hover {
            background: var(--wh-orange-hover);
        }


    /* =========================================
           OPTIONAL SECTION NOTE
        ========================================= */

    .optional-note {
        margin-bottom: 20px;
        padding: 13px 15px;
        border: 1px solid #E2E8F0;
        border-radius: 9px;
        background: #F8FAFC;
        color: #64748B;
        font-size: 10px;
        line-height: 1.6;
    }


        .optional-note strong {
            color: var(--wh-dark);
        }


    /* =========================================
           LOCK / EMPTY
        ========================================= */

    .section-locked {
        padding: 18px;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        background: #F8FAFC;
        color: #64748B;
        font-size: 10px;
        line-height: 1.6;
    }


        .section-locked strong {
            color: var(--wh-dark);
        }


    .section-empty {
        margin-bottom: 20px;
        padding: 25px 18px;
        border: 1px dashed #CBD5E1;
        border-radius: 10px;
        background: #FAFAFA;
        text-align: center;
    }


    .section-empty-icon {
        margin-bottom: 7px;
        font-size: 25px;
    }


    .section-empty strong {
        display: block;
        margin-bottom: 4px;
        color: var(--wh-dark);
        font-size: 12px;
    }


    .section-empty p {
        margin: 0;
        color: var(--wh-text);
        font-size: 10px;
    }


    /* =========================================
           ITEMS
        ========================================= */

    .item-card {
        margin-bottom: 12px;
        padding: 17px;
        border: 1px solid #E2E8F0;
        border-radius: 11px;
        background: #F8FAFC;
    }


    .item-main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
    }


    .item-left {
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 13px;
    }


    .item-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--wh-orange-soft);
        font-size: 19px;
    }


    .item-content h4 {
        margin: 0 0 4px;
        color: var(--wh-dark);
        font-size: 13px;
        font-weight: 900;
    }


    .item-company {
        margin-bottom: 4px;
        color: #475569;
        font-size: 11px;
        font-weight: 750;
    }


    .item-detail {
        margin-bottom: 4px;
        color: var(--wh-text);
        font-size: 10px;
    }


    .item-date {
        color: #94A3B8;
        font-size: 9px;
        font-weight: 700;
    }


    .item-description {
        margin-top: 8px;
        color: #64748B;
        font-size: 10px;
        line-height: 1.6;
    }


    .item-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
    }


    .small-button {
        padding: 7px 10px;
        border-radius: 7px;
        background: #FFFFFF;
        font-size: 9px;
        font-weight: 850;
        text-decoration: none;
        cursor: pointer;
    }


    .edit-button {
        border: 1px solid var(--wh-orange);
        color: var(--wh-orange-dark);
    }


    .delete-button {
        border: 1px solid #FECACA;
        color: var(--wh-red);
    }


        .delete-button:hover {
            background: var(--wh-red-soft);
        }


    /* =========================================
           DETAILS / INLINE EDIT
        ========================================= */

    .edit-details {
        margin-top: 15px;
        border-top: 1px solid #E2E8F0;
    }


        .edit-details summary {
            padding-top: 15px;
            color: var(--wh-orange-dark);
            font-size: 10px;
            font-weight: 850;
            cursor: pointer;
            list-style: none;
        }


            .edit-details summary::-webkit-details-marker {
                display: none;
            }


    .edit-form {
        margin-top: 15px;
    }


    /* =========================================
           CHECKBOX
        ========================================= */

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 9px;
    }


        .checkbox-row input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--wh-orange);
        }


        .checkbox-row label {
            margin: 0;
            color: #475569;
            font-size: 10px;
            font-weight: 700;
        }


    /* =========================================
           SKILLS
        ========================================= */

    .skills-grid {
        margin-bottom: 20px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px;
    }


    .skill-card {
        padding: 15px;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        background: #F8FAFC;
    }


    .skill-header {
        margin-bottom: 9px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }


    .skill-name {
        color: var(--wh-dark);
        font-size: 12px;
        font-weight: 900;
    }


    .skill-category {
        margin-top: 3px;
        color: #94A3B8;
        font-size: 8px;
    }


    .skill-info {
        margin-bottom: 10px;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }


    .skill-badge {
        padding: 5px 8px;
        border-radius: 20px;
        background: var(--wh-orange-soft);
        color: var(--wh-orange-dark);
        font-size: 8px;
        font-weight: 850;
    }


    .skill-experience {
        padding: 5px 8px;
        border-radius: 20px;
        background: #EEF2F7;
        color: #475569;
        font-size: 8px;
        font-weight: 750;
    }


    /* =========================================
           CV
        ========================================= */

    .cv-list {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        gap: 11px;
    }


    .cv-card {
        padding: 16px;
        border: 1px solid #E2E8F0;
        border-radius: 11px;
        background: #F8FAFC;
    }


        .cv-card.primary {
            border-color: #FDBA95;
            background: #FFF9F5;
        }


    .cv-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
    }


    .cv-info {
        min-width: 0;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }


    .cv-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--wh-orange-soft);
        font-size: 19px;
    }


    .cv-name {
        margin-bottom: 4px;
        color: var(--wh-dark);
        font-size: 11px;
        font-weight: 900;
        overflow-wrap: anywhere;
    }


    .cv-meta {
        color: var(--wh-text);
        font-size: 9px;
        line-height: 1.55;
    }


    .primary-badge {
        display: inline-block;
        margin-top: 7px;
        padding: 4px 7px;
        border-radius: 20px;
        background: #DCFCE7;
        color: #15803D;
        font-size: 8px;
        font-weight: 900;
    }


    .cv-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }


    .cv-upload-box {
        padding: 20px;
        border: 1px dashed #FDBA95;
        border-radius: 11px;
        background: #FFFAF7;
    }


        .cv-upload-box h3 {
            margin: 0 0 5px;
            color: var(--wh-dark);
            font-size: 13px;
            font-weight: 900;
        }


        .cv-upload-box p {
            margin: 0 0 15px;
            color: var(--wh-text);
            font-size: 9px;
        }


    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media (max-width: 720px) {

        .jobseeker-page {
            padding: 32px 14px 65px;
        }


        .jobseeker-header {
            flex-direction: column;
        }


        .details-grid,
        .form-grid,
        .skills-grid {
            grid-template-columns: 1fr;
        }


        .detail-box.full,
        .form-group.full {
            grid-column: auto;
        }


        .item-main,
        .cv-main,
        .personal-footer {
            flex-direction: column;
        }


        .item-actions,
        .cv-actions {
            justify-content: flex-start;
        }


        .jobseeker-card {
            padding: 21px;
        }
    }

</style>


<section class="jobseeker-page">

    <div class="jobseeker-container">


        <!-- =====================================
             HEADER
        ====================================== -->

        <div class="jobseeker-header">

            <div>

                <span class="jobseeker-eyebrow">
                    WorkHub Job Seeker
                </span>

                <h1>
                    Job Seeker Profile
                </h1>

                <p>
                    Manage your professional information,
                    education, skills, work experience and CV.
                    These details help you build a stronger
                    professional profile and support future
                    WorkHub job features.
                </p>

            </div>


            <a asp-controller="Account"
               asp-action="Profile"
               class="back-dashboard">

                ← Back to Dashboard

            </a>

        </div>


        <!-- =====================================
             NAVIGATION
        ====================================== -->

        <div class="section-navigation">

            <a href="#personal"
               class="section-nav-link">
                Personal
            </a>

            <a href="#professional"
               class="section-nav-link">
                Professional
            </a>

            <a href="#education"
               class="section-nav-link">
                Education
            </a>

            <a href="#skills"
               class="section-nav-link">
                Skills
            </a>

            <a href="#experience"
               class="section-nav-link">
                Work Experience
            </a>

            <a href="#cv"
               class="section-nav-link">
                CV & Resume
            </a>

        </div>


        <!-- =====================================
             MESSAGES
        ====================================== -->
        @if (TempData["JobSeekerSuccess"] != null)
        {
            <div class="jobseeker-message jobseeker-success">

                @TempData["JobSeekerSuccess"]

            </div>
        }


        @if (TempData["JobSeekerError"] != null)
        {
            <div class="jobseeker-message jobseeker-error">

                @TempData["JobSeekerError"]

            </div>
        }


        <!-- =====================================
             PERSONAL INFORMATION
        ====================================== -->

        <div class="jobseeker-card"
             id="personal">


            <div class="card-header">

                <h2>
                    Personal Information
                </h2>

                <span>
                    From your main WorkHub profile
                </span>

            </div>


            <div class="personal-profile-header">


                <div class="personal-avatar">

                    <span>
                        @Model.Initial
                    </span>


                    @if (Model.HasProfileImage)
                    {
                        <img src="/UserProfile/ProfileImage?v=@DateTime.UtcNow.Ticks"
                             alt="@Model.FullName"
                             onerror="this.style.display='none';" />
                    }

                </div>


                <div>

                    <h3>
                        @Model.FullName
                    </h3>

                    <p>
                        @Model.Email
                    </p>

                </div>


            </div>


            <div class="details-grid">


                <div class="detail-box">

                    <span class="detail-label">
                        First Name
                    </span>

                    <div class="detail-value">
                        @Model.FirstName
                    </div>

                </div>


                <div class="detail-box">

                    <span class="detail-label">
                        Last Name
                    </span>

                    <div class="detail-value">
                        @Model.LastName
                    </div>

                </div>


                <div class="detail-box">

                    <span class="detail-label">
                        Date of Birth
                    </span>

                    <div class="detail-value">

                        @(Model.DateOfBirth.HasValue
                            ? Model.DateOfBirth.Value.ToString("dd MMM yyyy")
                            : "Not added")

                    </div>

                </div>


                <div class="detail-box">

                    <span class="detail-label">
                        Email
                    </span>

                    <div class="detail-value">
                        @Model.Email
                    </div>

                </div>


                <div class="detail-box">

                    <span class="detail-label">
                        Country
                    </span>

                    <div class="detail-value">

                        @(string.IsNullOrWhiteSpace(Model.Country)
                            ? "Not added"
                            : Model.Country)

                    </div>

                </div>


                <div class="detail-box">

                    <span class="detail-label">
                        Location
                    </span>

                    <div class="detail-value">

                        @(string.IsNullOrWhiteSpace(Model.Location)
                            ? "Not added"
                            : Model.Location)

                    </div>

                </div>


                <div class="detail-box full">

                    <span class="detail-label">
                        Phone
                    </span>

                    <div class="detail-value">

                        @(string.IsNullOrWhiteSpace(Model.Phone)
                            ? "Not added"
                            : Model.Phone)

                    </div>

                </div>


            </div>


            <div class="personal-footer">

                <p>
                    Personal information is managed
                    through your main WorkHub profile.
                </p>


                <a asp-controller="UserProfile"
                   asp-action="Edit"
                   class="outline-button">

                    Edit Personal Profile

                </a>

            </div>


        </div>


        <!-- =====================================
             PROFESSIONAL INFORMATION
        ====================================== -->

        <div class="jobseeker-card"
             id="professional">


            <div class="card-header">

                <h2>
                    Professional Information
                </h2>

                <span>
                    Career preferences
                </span>

            </div>


            <div class="optional-note">

                <strong>
                    Professional details are flexible.
                </strong>

                Update these fields whenever your career
                preferences change. They are not used to
                calculate a profile completion percentage.

            </div>


            <form asp-controller="JobSeeker"
                  asp-action="SaveProfessionalProfile"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="form-grid">


                    <div class="form-group full">

                        <label>
                            Professional Summary
                        </label>

                        <textarea asp-for="ProfessionalSummary"
                                  maxlength="1000"
                                  class="form-control-custom"
                                  placeholder="Describe your professional background, strengths and career interests..."></textarea>

                    </div>


                    <div class="form-group">

                        <label>
                            Preferred Job Category
                        </label>

                        <select asp-for="PreferredJobCategory"
                                class="form-control-custom">

                            <option value="">
                                Select category
                            </option>

                            <option value="Information Technology">
                                Information Technology
                            </option>

                            <option value="Accounting & Finance">
                                Accounting & Finance
                            </option>

                            <option value="Engineering">
