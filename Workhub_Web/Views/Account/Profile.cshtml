                            </p>


                        </div>


                        <!-- PUBLISHED NEWS -->

                        <div id="newsList"
                             class="profile-news-list">
                        </div>


                    </div>


                </section>

                <!-- =================================
     ACCOUNT SETTINGS
================================== -->

