                                           asp-action="DownloadCV"
                                           asp-route-id="@cv.CVDocumentId"
                                           class="small-button edit-button">

                                            Download

                                        </a>


                                        <form asp-controller="JobSeeker"
                                              asp-action="DeleteCV"
                                              method="post"
                                              onsubmit="return confirm('Delete this CV?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@cv.CVDocumentId" />

                                            <button type="submit"
                                                    class="small-button delete-button">

                                                Delete

                                            </button>

