                <!-- =================================
                     NOTIFICATIONS
                ================================== -->

                <section id="notifications"
                         class="tab-panel">


                    <div class="dashboard-card">


                        <div class="dashboard-card-header">

                            <h3>
                                Notifications
                            </h3>

                            <span>
                                Admin replies and WorkHub activity
                            </span>

                        </div>


                        <div class="notification-summary">


                            <div class="notification-summary-left">


                                <div class="notification-summary-icon">
                                    <svg class="wh-svg-icon-lg" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                        <path d="M10 21h4"></path>
                                    </svg>
                                </div>

                                <div>

                                    <strong>

                                        @Model.UnreadNotificationCount
                                        unread notification@(Model.UnreadNotificationCount == 1 ? "" : "s")

                                    </strong>


                                    <span>
                                        Admin replies to your inquiries
                                        will appear here.
                                    </span>

                                </div>


                            </div>


                            @if (Model.UnreadNotificationCount > 0)
                            {
                                <form asp-controller="Account"
                                      asp-action="MarkAllNotificationsRead"
                                      method="post"
                                      class="notification-ajax-form">

                                    @Html.AntiForgeryToken()


                                    <button type="submit"
                                            class="notification-action-button">

                                        Mark all as read

                                    </button>

                                </form>
                            }


                        </div>


                        @if (
                            Model.Notifications == null
                            ||
                            !Model.Notifications.Any()
                        )
                        {
                            <div class="notification-empty">


                                <div class="notification-summary-icon">
                                    <svg class="wh-svg-icon-lg" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                        <path d="M10 21h4"></path>
                                    </svg>
                                </div>

                                <h4>
                                    No notifications yet
                                </h4>


                                <p>
                                    When WorkHub Admin replies
                                    to your Contact Us inquiry,
                                    the reply will appear here.
                                </p>


                            </div>
                        }
                        else
                        {
                            <div class="notification-list">


                                @foreach (
                                    var notification
                                    in Model.Notifications)
                                {
                                    <div class="notification-item
                                        @(!notification.IsRead
                                            ? "unread"
                                            : "")">


                                        <div class="notification-icon">

                                            @if (string.Equals(
                                                notification.NotificationType,
                                                "InquiryReply",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <svg class="wh-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                                    <path d="m4 6 8 7 8-7"></path>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="wh-svg-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                                    <path d="M10 21h4"></path>
                                                </svg>
                                            }

                                        </div>


                                        <div>


                                            <div class="notification-title-row">


                                                <span class="notification-title">

                                                    @notification.Title

                                                </span>


                                                @if (!notification.IsRead)
                                                {
                                                    <span class="notification-new-badge">
                                                        New
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="notification-read-badge">
                                                        Read
                                                    </span>
                                                }


                                            </div>


                                            <div class="notification-message-box">@notification.Message</div>


                                            <div class="notification-meta">


                                                <span>

                                                    @notification.CreatedAt

                                                 
                                                </span>


                                                <span>
                                                    •
                                                </span>


                                                <span class="notification-type">

                                                    @(string.Equals(
                                                        notification.NotificationType,
                                                        "InquiryReply",
                                                        StringComparison.OrdinalIgnoreCase)
                                                        ? "Admin Reply"
                                                        : notification.NotificationType)

                                                </span>




                                            </div>


                                        </div>


                                        @if (!notification.IsRead)
                                        {
                                            <form asp-controller="Account"
                                                  asp-action="MarkNotificationRead"
                                                  method="post"
                                                  class="notification-read-form notification-ajax-form">

                                                @Html.AntiForgeryToken()


                                                <input type="hidden"
                                                       name="id"
                                                       value="@notification.UserNotificationId" />


                                                <button type="submit"
                                                        class="notification-read-button">

                                                    Mark as read

                                                </button>


                                            </form>
                                        }


                                    </div>
                                }


                            </div>
                        }


                    </div>


                </section>







                <!-- =================================
                     NEWS & UPDATES
                ================================== -->

                <section id="news"
                         class="tab-panel">


                    <div class="dashboard-card">


                        <div class="dashboard-card-header">

                            <h3>
                                News & Updates
                            </h3>

                            <span>
                                Latest from WorkHub
                            </span>

                        </div>


                        <div class="news-intro">

                            <div class="news-intro-icon">
                                <svg class="wh-svg-icon-lg" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 4h16v16H4z"></path>
                                    <path d="M8 9h8"></path>
                                    <path d="M8 13h8"></path>
                                    <path d="M8 17h5"></path>
                                </svg>
                            </div>


                            <div>

                                <strong>
                                    WorkHub News
                                </strong>

                                <span>
                                    Stay informed about platform updates,
                                    announcements and important information
