                                                  asp-action="SetPrimaryCV"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@cv.CVDocumentId" />

                                                <button type="submit"
                                                        class="small-button edit-button">

                                                    Set Primary

                                                </button>

                                            </form>

                                        }


