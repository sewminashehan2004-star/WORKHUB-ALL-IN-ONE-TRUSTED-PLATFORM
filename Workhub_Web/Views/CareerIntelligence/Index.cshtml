@model Workhub_Web.Models.CareerIntelligenceViewModel

@{
    ViewData["Title"] = "Career Intelligence";

    var benchmarkSkills =
        Model.Benchmark?.Requirements.Skills
            .OrderBy(x => x.Importance == "Required" ? 0 : 1)
            .ThenBy(x => x.SkillName)
            .ToList()
        ?? new List<Workhub_Web.Models.CareerBenchmarkSkillViewModel>();

    var matchedSkills =
        Model.CVAnalysis?.Skills.Matched
        ?? new List<Workhub_Web.Models.CVSkillAnalysisViewModel>();

    var partialSkills =
        Model.CVAnalysis?.Skills.Partial
        ?? new List<Workhub_Web.Models.CVSkillAnalysisViewModel>();

    var missingSkills =
        Model.CVAnalysis?.Skills.Missing
        ?? new List<Workhub_Web.Models.CVSkillAnalysisViewModel>();
}


<style>

    :root {
        --orange: #FD5000;
        --orange-dark: #D94300;
        --orange-soft: #FFF3EC;
        --dark: #0F172A;
        --text: #64748B;
        --border: #E2E8F0;
        --light: #F8FAFC;
        --green: #16A34A;
        --green-soft: #F0FDF4;
        --yellow: #D97706;
        --yellow-soft: #FFFBEB;
        --red: #DC2626;
        --red-soft: #FEF2F2;
        --blue: #2563EB;
        --blue-soft: #EFF6FF;
    }

    .ci-page {
        min-height: 100vh;
        padding: 45px 26px 90px;
        background: var(--light);
    }

    .ci-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }

    .ci-header {
        margin-bottom: 25px;
    }

    .ci-eyebrow {
        display: block;
        margin-bottom: 7px;
        color: var(--orange);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }

    .ci-header h1 {
        margin: 0 0 8px;
        color: var(--dark);
        font-size: 38px;
        font-weight: 900;
    }

    .ci-header p {
        max-width: 760px;
        margin: 0;
        color: var(--text);
        font-size: 14px;
        line-height: 1.7;
    }

    .ci-card {
        margin-bottom: 22px;
        padding: 27px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.04);
    }

    .ci-card-title {
        margin-bottom: 20px;
    }

        .ci-card-title h2 {
            margin: 0 0 5px;
            color: var(--dark);
            font-size: 20px;
            font-weight: 900;
        }

        .ci-card-title p {
            margin: 0;
            color: var(--text);
            font-size: 12px;
            line-height: 1.6;
        }

    .ci-error,
    .ci-success {
        margin-bottom: 20px;
        padding: 13px 16px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
    }

    .ci-error {
        border: 1px solid #FECACA;
        background: var(--red-soft);
        color: #B91C1C;
    }

    .ci-success {
        border: 1px solid #BBF7D0;
        background: var(--green-soft);
        color: #15803D;
    }

    .selector-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .ci-field label {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 11px;
        font-weight: 850;
    }

    .ci-field select {
        width: 100%;
        height: 49px;
        padding: 0 13px;
        border: 1px solid #CBD5E1;
        border-radius: 9px;
        background: white;
        color: var(--dark);
        font-size: 13px;
        outline: none;
    }

        .ci-field select:focus {
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(253, 80, 0, 0.10);
        }

    .selector-action {
        margin-top: 18px;
        display: flex;
        justify-content: flex-end;
    }

    .primary-button {
        padding: 12px 20px;
        border: 0;
        border-radius: 8px;
        background: var(--orange-dark);
        color: white;
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
    }

        .primary-button:hover {
            background: #B93800;
        }

    .benchmark-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

        .benchmark-heading h2 {
            margin: 0 0 5px;
            color: var(--dark);
            font-size: 27px;
            font-weight: 900;
        }

    .benchmark-category {
        color: var(--orange-dark);
        font-size: 12px;
        font-weight: 850;
    }

    .source-pill {
        padding: 7px 11px;
        border-radius: 30px;
        background: var(--orange-soft);
        color: var(--orange-dark);
        font-size: 10px;
        font-weight: 850;
    }

    .market-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 13px;
        margin-bottom: 20px;
    }

    .market-box {
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 11px;
        background: #FAFCFF;
    }

        .market-box span {
            display: block;
            margin-bottom: 5px;
            color: var(--text);
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .market-box strong {
            color: var(--dark);
            font-size: 16px;
            font-weight: 900;
        }

    .baseline-note {
        margin-bottom: 22px;
        padding: 13px 16px;
        border-left: 4px solid var(--blue);
        border-radius: 7px;
        background: var(--blue-soft);
        color: #334155;
        font-size: 11px;
        line-height: 1.6;
    }

    .requirement-grid {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 17px;
        margin-bottom: 25px;
    }

    .requirement-box {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 11px;
    }

        .requirement-box h3 {
            margin: 0 0 10px;
            color: var(--dark);
            font-size: 13px;
            font-weight: 900;
        }

    .experience-value {
        color: var(--orange-dark);
        font-size: 29px;
        font-weight: 900;
    }

        .experience-value small {
            color: var(--text);
            font-size: 11px;
        }

    .education-list {
        margin: 0;
        padding-left: 18px;
        color: #475569;
        font-size: 11px;
        line-height: 1.7;
    }

    .skill-benchmark-header {
        margin: 27px 0 13px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .skill-benchmark-header h3 {
            margin: 0;
            color: var(--dark);
            font-size: 16px;
            font-weight: 900;
        }

    .skill-count {
        padding: 5px 9px;
        border-radius: 20px;
        background: #F1F5F9;
        color: #475569;
        font-size: 9px;
        font-weight: 850;
    }

    .benchmark-skill-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .benchmark-skill {
        padding: 14px 15px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: white;
    }

    .benchmark-skill-left {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .neutral-dot {
        width: 9px;
        height: 9px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #94A3B8;
    }

    .benchmark-skill-name {
        margin-bottom: 3px;
        color: var(--dark);
        font-size: 12px;
        font-weight: 850;
    }

    .benchmark-skill-meta {
        color: var(--text);
        font-size: 9px;
    }

    .required-badge,
    .preferred-badge {
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 900;
    }

    .required-badge {
        background: var(--orange-soft);
        color: var(--orange-dark);
    }

    .preferred-badge {
        background: var(--blue-soft);
        color: var(--blue);
    }

    .empty-box {
        padding: 17px;
        border: 1px dashed #CBD5E1;
        border-radius: 9px;
        color: var(--text);
        font-size: 11px;
        text-align: center;
    }

    .premium-card {
        border: 1px solid #FED7C2;
        background: linear-gradient(135deg, #FFF9F5, #FFFFFF);
    }

    .premium-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 25px;
        align-items: center;
    }

    .premium-price {
        display: inline-block;
        margin-bottom: 8px;
        color: var(--orange-dark);
        font-size: 25px;
        font-weight: 950;
    }

    .premium-content h2 {
        margin: 0 0 7px;
        color: var(--dark);
        font-size: 20px;
        font-weight: 900;
    }

    .premium-content p {
        max-width: 700px;
        margin: 0;
        color: var(--text);
        font-size: 11px;
        line-height: 1.7;
    }

    .compare-button {
        min-width: 180px;
        padding: 13px 18px;
        border: 0;
        border-radius: 9px;
        background: var(--orange);
        color: white;
        font-size: 11px;
        font-weight: 900;
        cursor: pointer;
    }

        .compare-button:hover {
            background: var(--orange-dark);
        }

    .demo-note {
        margin-top: 8px;
        color: #94A3B8;
        font-size: 9px;
    }

    .score-hero {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 24px;
        align-items: center;
        margin-bottom: 25px;
    }

    .overall-score {
        padding: 25px;
        border-radius: 14px;
        background: var(--dark);
        color: white;
        text-align: center;
    }

    .overall-score-number {
        font-size: 48px;
        font-weight: 950;
        line-height: 1;
    }

        .overall-score-number span {
            font-size: 17px;
            color: #CBD5E1;
        }

    .readiness-level {
        margin-top: 9px;
        color: #FDBA74;
        font-size: 11px;
        font-weight: 850;
    }

    .cv-name {
        margin-top: 6px;
        color: #CBD5E1;
        font-size: 9px;
    }

    .breakdown-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 9px;
    }

    .score-box {
        padding: 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #FAFCFF;
    }

        .score-box span {
            display: block;
            margin-bottom: 5px;
            color: var(--text);
            font-size: 8px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .score-box strong {
            color: var(--dark);
            font-size: 14px;
            font-weight: 900;
        }

    .analysis-section {
        margin-top: 28px;
    }

    .analysis-title {
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .analysis-title h3 {
            margin: 0;
            color: var(--dark);
            font-size: 15px;
            font-weight: 900;
        }

    .analysis-skills {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .analysis-skill {
        padding: 14px;
        display: flex;
        gap: 11px;
        border: 1px solid var(--border);
        border-radius: 9px;
    }

    .status-icon {
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 12px;
        font-weight: 900;
    }

    .matched-card {
        background: var(--green-soft);
        border-color: #BBF7D0;
    }

        .matched-card .status-icon {
            background: var(--green);
            color: white;
        }

    .partial-card {
        background: var(--yellow-soft);
        border-color: #FDE68A;
    }

        .partial-card .status-icon {
            background: var(--yellow);
            color: white;
        }

    .missing-card {
        background: var(--red-soft);
        border-color: #FECACA;
    }

        .missing-card .status-icon {
            background: var(--red);
            color: white;
        }

    .analysis-skill-name {
        color: var(--dark);
        font-size: 11px;
        font-weight: 900;
    }

    .analysis-skill-meta {
        margin-top: 3px;
        color: var(--text);
        font-size: 9px;
        line-height: 1.5;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 25px;
    }

    .detail-card {
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 10px;
    }

        .detail-card h3 {
            margin: 0 0 10px;
            color: var(--dark);
            font-size: 13px;
            font-weight: 900;
        }

        .detail-card p,
        .detail-card li {
            color: var(--text);
            font-size: 10px;
            line-height: 1.65;
        }

        .detail-card ul {
            margin: 0;
            padding-left: 17px;
        }

    .recommendations {
        margin-top: 22px;
        padding: 20px;
        border-radius: 11px;
        background: #FFF8F4;
        border: 1px solid #FED7C2;
    }

        .recommendations h3 {
            margin: 0 0 12px;
            color: var(--dark);
            font-size: 14px;
            font-weight: 900;
        }

        .recommendations li {
            margin-bottom: 7px;
            color: #475569;
            font-size: 10px;
            line-height: 1.6;
        }

    @@media (max-width: 900px) {

        .selector-grid,
        .market-grid,
        .requirement-grid,
        .benchmark-skill-list,
        .analysis-skills,
        .detail-grid,
        .score-hero,
        .premium-grid {
            grid-template-columns: 1fr;
        }

        .breakdown-grid {
            grid-template-columns: 1fr 1fr;
        }

        .premium-grid {
            align-items: stretch;
        }

        .compare-button {
            width: 100%;
        }
    }

</style>


<section class="ci-page">

    <div class="ci-container">


        <div class="ci-header">

            <span class="ci-eyebrow">
                WorkHub Intelligence
            </span>

            <h1>
                Career Intelligence
            </h1>

            <p>
                Explore the requirements for a career,
                then compare your actual Job Seeker
                profile and primary CV against the benchmark.
            </p>

        </div>


        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="ci-error">
                @Model.ErrorMessage
            </div>
        }


        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="ci-success">
                @Model.SuccessMessage
            </div>
        }


        <!-- =====================================
             CAREER SELECTOR
        ====================================== -->

        <div class="ci-card">

            <div class="ci-card-title">

                <h2>
                    Select your target career
                </h2>

                <p>
                    Select a career category and then
                    choose the specific role you want
                    WorkHub to analyse.
                </p>

            </div>


            <form asp-controller="CareerIntelligence"
                  asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="selector-grid">


                    <div class="ci-field">

                        <label asp-for="SelectedCareerCategoryId">
                            Career Category
                        </label>

                        <select asp-for="SelectedCareerCategoryId"
                                id="careerCategory">

                            <option value="0">
                                Select career category
                            </option>

                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CareerCategoryId">
                                    @category.CategoryName
                                </option>
                            }

                        </select>

                    </div>


                    <div class="ci-field">

                        <label asp-for="SelectedCareerRoleId">
                            Target Career Role
                        </label>

                        <select asp-for="SelectedCareerRoleId"
                                id="careerRole">

                            <option value="0">
                                Select target role
                            </option>

                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.CareerRoleId">
                                    @role.RoleName
                                </option>
                            }

                        </select>

                    </div>


                </div>


                <div class="selector-action">

                    <button type="submit"
                            class="primary-button">

                        View Career Benchmark

                    </button>

                </div>

            </form>

        </div>


        <!-- =====================================
             BENCHMARK
        ====================================== -->
        @if (Model.Benchmark != null)
        {
            <div class="ci-card">


                <div class="benchmark-heading">

                    <div>

                        <h2>
                            @Model.Benchmark.RoleName
                        </h2>

                        <div class="benchmark-category">
                            @Model.Benchmark.CategoryName
                        </div>

                    </div>


                    <div class="source-pill">
                        @Model.Benchmark.Market.DataSource
                    </div>

                </div>


                <div class="market-grid">

                    <div class="market-box">

                        <span>
                            Active Jobs Analysed
                        </span>

                        <strong>
                            @Model.Benchmark.Market.ActiveJobCount
                        </strong>

                    </div>


                    <div class="market-box">

                        <span>
                            Data Source
                        </span>

                        <strong>
                            @Model.Benchmark.Market.DataSource
                        </strong>

                    </div>


                    <div class="market-box">

                        <span>
                            Confidence
                        </span>

                        <strong>
                            @Model.Benchmark.Market.ConfidenceLevel
                        </strong>

                    </div>

                </div>


                @if (Model.Benchmark.Market.ActiveJobCount < 3)
                {
                    <div class="baseline-note">

                        There are not yet enough active WorkHub
                        jobs for this role to calculate a reliable
                        live market benchmark. WorkHub is currently
                        using its curated role baseline as fallback
                        guidance.

                    </div>
                }


                <div class="requirement-grid">


                    <div class="requirement-box">

                        <h3>
                            Experience Benchmark
                        </h3>

                        @if (Model.Benchmark.Requirements.AverageMinimumExperienceYears.HasValue)
                        {
                            <div class="experience-value">

                                @(Model.Benchmark.Requirements.AverageMinimumExperienceYears.Value.ToString("0.#"))

                                <small>
                                    years
                                </small>

                            </div>
                        }
                        else
                        {
                            <div class="empty-box">
                                No experience benchmark available.
                            </div>
                        }

                    </div>


                    <div class="requirement-box">

                        <h3>
                            Education Benchmark
                        </h3>

                        @if (Model.Benchmark.Requirements.Education.Any())
                        {
                            <ul class="education-list">

                                @foreach (var education in Model.Benchmark.Requirements.Education)
                                {
                                    <li>
                                        @education
                                    </li>
                                }

                            </ul>
                        }
                        else
                        {
                            <div class="empty-box">
                                No education benchmark available.
                            </div>
                        }

                    </div>


                </div>


                <!-- CAREER SKILL BENCHMARK -->

                <div class="skill-benchmark-header">

                    <h3>
                        Career Skill Benchmark
                    </h3>

                    <span class="skill-count">
                        @benchmarkSkills.Count skills
                    </span>

                </div>


                @if (benchmarkSkills.Any())
                {
                    <div class="benchmark-skill-list">

                        @foreach (var skill in benchmarkSkills)
                        {
                            <div class="benchmark-skill">

                                <div class="benchmark-skill-left">

                                    <span class="neutral-dot"></span>

                                    <div>

                                        <div class="benchmark-skill-name">
                                            @skill.SkillName
                                        </div>

                                        <div class="benchmark-skill-meta">

                                            @if (skill.AverageRequiredYears.HasValue)
                                            {
                                                <span>
                                                    Recommended:
                                                    @(skill.AverageRequiredYears.Value.ToString("0.#"))
                                                    year(s)
                                                </span>
                                            }

                                            @if (skill.DemandPercentage > 0)
                                            {
                                                <span>
                                                    · @(skill.DemandPercentage.ToString("0.#"))% demand
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>


                                @if (skill.Importance == "Required")
                                {
                                    <span class="required-badge">
                                        Required
                                    </span>
                                }
                                else
                                {
                                    <span class="preferred-badge">
                                        Preferred
                                    </span>
                                }

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-box">
                        No skill benchmark available.
                    </div>
                }

            </div>


            <!-- =====================================
                 $2 CV INTELLIGENCE
            ====================================== -->

            <div class="ci-card premium-card">


                <div class="premium-grid">


                    <div class="premium-content">

                        <span class="premium-price">
                            $2
                        </span>

                        <h2>
                            WorkHub CV Intelligence
                        </h2>

                        <p>
                            Compare your primary CV and Job Seeker
                            profile against the
                            @Model.Benchmark.RoleName benchmark.
                            WorkHub checks your skills, relevant
                            experience, education, CV structure
                            and career relevance.
                        </p>

                        <div class="demo-note">
                            Academic MVP: payment is simulated
                            during development.
                        </div>

                    </div>


                    <form asp-controller="CareerIntelligence"
                          asp-action="CompareMyCV"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="SelectedCareerCategoryId"
                               value="@Model.SelectedCareerCategoryId" />

                        <input type="hidden"
                               name="SelectedCareerRoleId"
                               value="@Model.SelectedCareerRoleId" />

                        <button type="submit"
                                class="compare-button">

                            Compare My CV — $2

                        </button>

                    </form>


                </div>

            </div>
        }


        <!-- =====================================
             CV INTELLIGENCE RESULT
        ====================================== -->
        @if (Model.CVAnalysis != null)
        {
            <div class="ci-card">


                <div class="ci-card-title">

                    <h2>
                        WorkHub CV Readiness Report
                    </h2>

                    <p>
                        Your CV and Job Seeker profile compared
                        with the @Model.CVAnalysis.Career.RoleName
                        career benchmark.
                    </p>

                </div>


                <!-- SCORE -->

                <div class="score-hero">


                    <div class="overall-score">

                        <div class="overall-score-number">

                            @(Model.CVAnalysis.Readiness.OverallScore.ToString("0.#"))

                            <span>
                                /100
                            </span>

                        </div>

                        <div class="readiness-level">
                            @Model.CVAnalysis.Readiness.ReadinessLevel
                        </div>

                        <div class="cv-name">
                            @Model.CVAnalysis.CV.CVFileName
                        </div>

                    </div>


                    <div class="breakdown-grid">


                        <div class="score-box">

                            <span>
                                Skills
                            </span>

                            <strong>
                                @(Model.CVAnalysis.ScoreBreakdown.Skills.Score.ToString("0.#"))
                                /
                                @(Model.CVAnalysis.ScoreBreakdown.Skills.Maximum.ToString("0"))
                            </strong>

                        </div>


                        <div class="score-box">

                            <span>
                                Experience
                            </span>

                            <strong>
                                @(Model.CVAnalysis.ScoreBreakdown.Experience.Score.ToString("0.#"))
                                /
                                @(Model.CVAnalysis.ScoreBreakdown.Experience.Maximum.ToString("0"))
                            </strong>

                        </div>


                        <div class="score-box">

                            <span>
                                Education
                            </span>

                            <strong>
                                @(Model.CVAnalysis.ScoreBreakdown.Education.Score.ToString("0.#"))
                                /
                                @(Model.CVAnalysis.ScoreBreakdown.Education.Maximum.ToString("0"))
                            </strong>

                        </div>


                        <div class="score-box">

                            <span>
                                CV Quality
                            </span>

                            <strong>
                                @(Model.CVAnalysis.ScoreBreakdown.CVQuality.Score.ToString("0.#"))
                                /
                                @(Model.CVAnalysis.ScoreBreakdown.CVQuality.Maximum.ToString("0"))
                            </strong>

                        </div>


                        <div class="score-box">

                            <span>
                                Career Relevance
                            </span>

                            <strong>
                                @(Model.CVAnalysis.ScoreBreakdown.CareerRelevance.Score.ToString("0.#"))
                                /
                                @(Model.CVAnalysis.ScoreBreakdown.CareerRelevance.Maximum.ToString("0"))
                            </strong>

                        </div>


                    </div>

                </div>


                <!-- MATCHED -->

                <div class="analysis-section">


                    <div class="analysis-title">

                        <h3>
                            ✓ Matched Skills
                        </h3>

                        <span class="skill-count">
                            @matchedSkills.Count
                        </span>

                    </div>


                    @if (matchedSkills.Any())
                    {
                        <div class="analysis-skills">

                            @foreach (var skill in matchedSkills)
                            {
                                <div class="analysis-skill matched-card">

                                    <div class="status-icon">
                                        ✓
                                    </div>

                                    <div>

                                        <div class="analysis-skill-name">
                                            @skill.SkillName
                                        </div>

                                        <div class="analysis-skill-meta">

                                            Found from:
                                            @skill.FoundFrom

                                            @if (skill.CandidateYears.HasValue)
                                            {
                                                <span>
                                                    · Your experience:
                                                    @(skill.CandidateYears.Value.ToString("0.#"))
                                                    year(s)
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            No fully matched benchmark skills were detected.
                        </div>
                    }

                </div>


                <!-- PARTIAL -->

                <div class="analysis-section">


                    <div class="analysis-title">

                        <h3>
                            ⚠ Partial Skills
                        </h3>

                        <span class="skill-count">
                            @partialSkills.Count
                        </span>

                    </div>


                    @if (partialSkills.Any())
                    {
                        <div class="analysis-skills">

                            @foreach (var skill in partialSkills)
                            {
                                <div class="analysis-skill partial-card">

                                    <div class="status-icon">
                                        !
                                    </div>

                                    <div>

                                        <div class="analysis-skill-name">
                                            @skill.SkillName
                                        </div>

                                        <div class="analysis-skill-meta">

                                            Found from:
                                            @skill.FoundFrom

                                            @if (skill.RecommendedYears.HasValue)
                                            {
                                                <span>
                                                    · Benchmark:
                                                    @(skill.RecommendedYears.Value.ToString("0.#"))
                                                    year(s)
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            No partial skills detected.
                        </div>
                    }

                </div>


                <!-- MISSING -->

                <div class="analysis-section">


                    <div class="analysis-title">

                        <h3>
                            ✕ Missing Skills
                        </h3>

                        <span class="skill-count">
                            @missingSkills.Count
                        </span>

                    </div>


                    @if (missingSkills.Any())
                    {
                        <div class="analysis-skills">

                            @foreach (var skill in missingSkills)
                            {
                                <div class="analysis-skill missing-card">

                                    <div class="status-icon">
                                        ×
                                    </div>

                                    <div>

                                        <div class="analysis-skill-name">
                                            @skill.SkillName
                                        </div>

                                        <div class="analysis-skill-meta">

                                            @skill.Importance skill

                                            @if (skill.RecommendedYears.HasValue)
                                            {
                                                <span>
                                                    · Recommended:
                                                    @(skill.RecommendedYears.Value.ToString("0.#"))
                                                    year(s)
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            Great — no missing benchmark skills were detected.
                        </div>
                    }

                </div>


                <!-- EXPERIENCE + EDUCATION -->

                <div class="detail-grid">


                    <div class="detail-card">

                        <h3>
                            Experience Analysis
                        </h3>

                        <p>
                            Status:
                            <strong>
                                @Model.CVAnalysis.Experience.ExperienceStatus
                            </strong>
                        </p>

                        <p>
                            Your relevant experience:
                            <strong>
                                @(Model.CVAnalysis.Experience.CandidateExperienceYears.ToString("0.#"))
                                year(s)
                            </strong>
                        </p>

                        @if (Model.CVAnalysis.Experience.RecommendedExperienceYears.HasValue)
                        {
                            <p>
                                Benchmark:
                                <strong>
                                    @(Model.CVAnalysis.Experience.RecommendedExperienceYears.Value.ToString("0.#"))
                                    year(s)
                                </strong>
                            </p>
                        }

                    </div>


                    <div class="detail-card">

                        <h3>
                            Education Analysis
                        </h3>

                        <p>
                            Status:
                            <strong>
                                @Model.CVAnalysis.Education.EducationStatus
                            </strong>
                        </p>

                        @if (Model.CVAnalysis.Education.EducationFindings.Any())
                        {
                            <ul>

                                @foreach (var finding in Model.CVAnalysis.Education.EducationFindings)
                                {
                                    <li>
                                        @finding
                                    </li>
                                }

                            </ul>
                        }

                    </div>


                </div>


                <!-- CV QUALITY -->

                <div class="detail-grid">


                    <div class="detail-card">

                        <h3>
                            CV Strengths
                        </h3>

                        @if (Model.CVAnalysis.CVQuality.Strengths.Any())
                        {
                            <ul>

                                @foreach (var strength in Model.CVAnalysis.CVQuality.Strengths)
                                {
                                    <li>
                                        @strength
                                    </li>
                                }

                            </ul>
                        }
                        else
                        {
                            <p>
                                No specific CV strengths detected.
                            </p>
                        }

                    </div>


                    <div class="detail-card">

                        <h3>
                            CV Issues
                        </h3>

                        @if (Model.CVAnalysis.CVQuality.Issues.Any())
                        {
                            <ul>

                                @foreach (var issue in Model.CVAnalysis.CVQuality.Issues)
                                {
                                    <li>
                                        @issue
                                    </li>
                                }

                            </ul>
                        }
                        else
                        {
                            <p>
                                No major CV structure issues detected.
                            </p>
                        }

                    </div>


                </div>


                <!-- RECOMMENDATIONS -->
                @if (Model.CVAnalysis.Recommendations.Any())
                {
                    <div class="recommendations">

                        <h3>
                            Priority Improvements
                        </h3>

                        <ul>

                            @foreach (var recommendation in Model.CVAnalysis.Recommendations)
                            {
                                <li>
                                    @recommendation
                                </li>
                            }

                        </ul>

                    </div>
                }


            </div>
        }


    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const categorySelect =
                    document.getElementById(
                        "careerCategory");

                const roleSelect =
                    document.getElementById(
                        "careerRole");


                if (!categorySelect ||
                    !roleSelect) {

                    return;
                }


                const initialCategoryId =
                    parseInt(
                        categorySelect.value || "0");


                roleSelect.disabled =
                    initialCategoryId <= 0;


                categorySelect.addEventListener(
                    "change",
                    async function() {

                        const categoryId =
                            parseInt(
                                categorySelect.value
                                || "0");


                        roleSelect.innerHTML =
                            '<option value="0">' +
                            'Select target role' +
                            '</option>';


                        if (categoryId <= 0) {

                            roleSelect.disabled =
                                true;

                            return;
                        }


                        roleSelect.disabled =
                            true;


                        roleSelect.innerHTML =
                            '<option value="0">' +
                            'Loading roles...' +
                            '</option>';


                        try {

                            const response =
                                await fetch(
                                    "/CareerIntelligence/roles?categoryId="
                                    +
                                    encodeURIComponent(
                                        categoryId));


                            if (!response.ok) {

                                throw new Error(
                                    "Unable to load roles.");
                            }


                            const data =
                                await response.json();


                            roleSelect.innerHTML =
                                '<option value="0">' +
                                'Select target role' +
                                '</option>';


                            if (data.success &&
                                data.roles) {

                                data.roles.forEach(
                                    function(role) {

                                        const option =
                                            document.createElement(
                                                "option");


                                        option.value =
                                            role.careerRoleId;


                                        option.textContent =
                                            role.roleName;


                                        roleSelect.appendChild(
                                            option);

                                    });
                            }


                            roleSelect.disabled =
                                false;

                        }
                        catch (error) {

                            roleSelect.innerHTML =
                                '<option value="0">' +
                                'Unable to load roles' +
                                '</option>';


                            roleSelect.disabled =
                                true;
                        }

                    });

            });

    </script>

}