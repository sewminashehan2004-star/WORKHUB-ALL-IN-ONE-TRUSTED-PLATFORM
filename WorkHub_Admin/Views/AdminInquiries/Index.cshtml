@model WorkHub_Admin.Models.AdminInquiriesViewModel

@{
    Layout = null;
    ViewData["Title"] = "Inquiries";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        WorkHub Admin - Inquiries
    </title>

    <style>

            /* =========================================================
                   WORKHUB ADMIN INQUIRIES - THEME
                ========================================================== */

            :root {
                --orange: #FD5000;
                --orange-dark: #D94300;
                --orange-hover: #E84900;
                --orange-soft: #FFF4EE;
                --orange-border: #FFD7C4;
                --dark: #101828;
                --heading: #1D2939;
                --text: #475467;
                --muted: #667085;
                --light-text: #98A2B3;
                --border: #E4E7EC;
                --border-soft: #F0F2F5;
                --bg: #F7F8FA;
                --white: #FFFFFF;
                --green: #067647;
                --green-soft: #ECFDF3;
                --yellow: #B54708;
                --yellow-soft: #FFFAEB;
                --red: #B42318;
                --red-soft: #FEF3F2;
                --shadow-sm: 0 2px 8px rgba(16, 24, 40, 0.04);
                --shadow-md: 0 8px 28px rgba(16, 24, 40, 0.07);
                --shadow-hover: 0 12px 35px rgba(16, 24, 40, 0.10);
            }

            /* =========================================================
                   RESET
                ========================================================== */

            * {
                box-sizing: border-box;
            }

            html {
                font-size: 16px;
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                font-size: 16px;
                line-height: 1.6;
                background: linear-gradient(180deg, #FFFFFF 0px, var(--bg) 260px);
                color: var(--dark);
                -webkit-font-smoothing: antialiased;
            }

            button,
            input,
            select,
            textarea {
                font: inherit;
            }

            a {
                color: inherit;
            }

            /* =========================================================
                   PAGE
                ========================================================== */

            .page {
                min-height: 100vh;
            }

            /* =========================================================
                   TOP BAR
                ========================================================== */

            .topbar {
                position: sticky;
                top: 0;
                z-index: 1000;
                min-height: 82px;
                padding: 0 36px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                border-bottom: 1px solid var(--border-soft);
                background: rgba(255, 255, 255, 0.97);
                box-shadow: 0 2px 14px rgba(16, 24, 40, 0.05);
                backdrop-filter: blur(12px);
            }

            /* =========================================================
                   BRAND
                ========================================================== */

            .brand {
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .logo {
                width: 46px;
                height: 46px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border-radius: 13px;
                background: linear-gradient(135deg, #FF6A21, var(--orange));
                color: #FFFFFF;
                font-size: 21px;
                font-weight: 950;
                box-shadow: 0 6px 18px rgba(253, 80, 0, 0.23);
            }

            .brand strong {
                display: block;
                color: var(--dark);
                font-size: 20px;
                line-height: 1.2;
                font-weight: 900;
                letter-spacing: -0.4px;
            }

            .brand span {
                display: block;
                margin-top: 3px;
                color: var(--muted);
                font-size: 12px;
                line-height: 1.3;
                font-weight: 600;
            }

            /* =========================================================
                   DASHBOARD BUTTON
                ========================================================== */

            .dashboard-link {
                min-height: 44px;
                padding: 0 17px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--border);
                border-radius: 9px;
                background: #FFFFFF;
                color: var(--text);
                font-size: 14px;
                font-weight: 750;
                text-decoration: none;
                box-shadow: 0 1px 3px rgba(16, 24, 40, 0.03);
                transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
            }

                .dashboard-link:hover {
                    color: var(--orange);
                    border-color: var(--orange-border);
                    background: var(--orange-soft);
                    transform: translateY(-1px);
                }

            /* =========================================================
                   CONTENT
                ========================================================== */

            .content {
                width: calc(100% - 50px);
                max-width: 1350px;
                margin: 0 auto;
                padding: 42px 0 90px;
            }

            /* =========================================================
                   PAGE HEADER
                ========================================================== */

            .header {
                margin-bottom: 30px;
            }

                .header > span {
                    display: block;
                    margin-bottom: 7px;
                    color: var(--orange);
                    font-size: 12px;
                    font-weight: 900;
                    letter-spacing: 1.4px;
                    text-transform: uppercase;
                }

                .header h1 {
                    margin: 0 0 10px;
                    color: var(--dark);
                    font-size: clamp(34px, 4vw, 44px);
                    line-height: 1.15;
                    font-weight: 900;
                    letter-spacing: -1.2px;
                }

                .header p {
                    max-width: 720px;
                    margin: 0;
                    color: var(--muted);
                    font-size: 16px;
                    line-height: 1.7;
                }

            /* =========================================================
                   MESSAGE ALERT
                ========================================================== */

            .message {
                margin-bottom: 20px;
                padding: 14px 17px;
                border-radius: 10px;
                font-size: 14px;
                font-weight: 700;
            }

            .success {
                border: 1px solid #ABEFC6;
                background: var(--green-soft);
                color: var(--green);
            }

            .error {
                border: 1px solid #FECDCA;
                background: var(--red-soft);
                color: var(--red);
            }

            /* =========================================================
                   STATS
                ========================================================== */

            .stats {
                margin-bottom: 28px;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 18px;
            }

            .stat {
                position: relative;
                overflow: hidden;
                min-height: 120px;
                padding: 24px;
                border: 1px solid var(--border);
                border-radius: 15px;
                background: #FFFFFF;
                box-shadow: var(--shadow-sm);
                transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            }

                .stat:hover {
                    transform: translateY(-3px);
                    border-color: var(--orange-border);
                    box-shadow: var(--shadow-hover);
                }

                .stat::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 4px;
                    height: 100%;
                    background: var(--orange);
                }

                .stat strong {
                    display: block;
                    margin-bottom: 6px;
                    color: var(--dark);
                    font-size: 32px;
                    line-height: 1.1;
                    font-weight: 900;
                    letter-spacing: -0.7px;
                }

                .stat span {
                    color: var(--muted);
                    font-size: 14px;
                    font-weight: 700;
                }

            /* =========================================================
                   SEARCH / FILTER TOOLBAR
                ========================================================== */

            .toolbar {
                margin-bottom: 18px;
                padding: 16px;
                display: flex;
                align-items: center;
                gap: 12px;
                border: 1px solid var(--border);
                border-radius: 13px;
                background: #FFFFFF;
                box-shadow: var(--shadow-sm);
            }

            .search {
                flex: 1;
                min-height: 48px;
                padding: 0 15px;
                border: 1px solid #D0D5DD;
                border-radius: 9px;
                background: #FFFFFF;
                color: var(--dark);
                font-size: 14px;
                outline: none;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .search::placeholder {
                    color: var(--light-text);
                }

                .search:focus {
                    border-color: var(--orange);
                    box-shadow: 0 0 0 4px rgba(253, 80, 0, 0.10);
                }

            .filter {
                min-width: 170px;
                min-height: 48px;
                padding: 0 14px;
                border: 1px solid #D0D5DD;
                border-radius: 9px;
                outline: none;
                background: #FFFFFF;
                color: var(--text);
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

                .filter:focus {
                    border-color: var(--orange);
                    box-shadow: 0 0 0 4px rgba(253, 80, 0, 0.10);
                }

            /* =========================================================
                   INQUIRY PANEL
                ========================================================== */

            .panel {
                overflow: hidden;
                border: 1px solid var(--border);
                border-radius: 15px;
                background: #FFFFFF;
                box-shadow: var(--shadow-md);
            }

            /* =========================================================
                   INQUIRY ROW
                ========================================================== */

            .row {
                min-height: 105px;
                padding: 20px 22px;
                display: grid;
                grid-template-columns: 58px minmax(0, 1fr) auto;
                gap: 18px;
                align-items: center;
                border-bottom: 1px solid var(--border-soft);
                transition: background 0.2s ease;
            }

                .row:hover {
                    background: #FFFAF7;
                }

                .row:last-child {
                    border-bottom: none;
                }

            /* =========================================================
                   AVATAR
                ========================================================== */

            .avatar {
                width: 52px;
                height: 52px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border-radius: 13px;
                background: var(--orange-soft);
                color: var(--orange-dark);
                font-size: 18px;
                font-weight: 900;
                border: 1px solid var(--orange-border);
            }

            /* =========================================================
                   INFO
                ========================================================== */

            .info {
                min-width: 0;
            }

            .info-top {
                margin-bottom: 6px;
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 8px;
            }

            .info h3 {
                margin: 0;
                color: var(--dark);
                font-size: 16px;
                line-height: 1.35;
                font-weight: 850;
            }

            /* =========================================================
                   TOPIC
                ========================================================== */

            .topic {
                display: inline-flex;
                align-items: center;
                min-height: 27px;
                padding: 4px 10px;
                border-radius: 999px;
                background: #F2F4F7;
                color: #475467;
                font-size: 11px;
                font-weight: 750;
            }

            /* =========================================================
                   STATUS
                ========================================================== */

            .status {
                display: inline-flex;
                align-items: center;
                min-height: 27px;
                padding: 4px 10px;
                border-radius: 999px;
                font-size: 10px;
                font-weight: 850;
                letter-spacing: 0.25px;
                text-transform: uppercase;
            }

            .status-new {
                border: 1px solid #FEDF89;
                background: var(--yellow-soft);
                color: var(--yellow);
            }

            .status-replied {
                border: 1px solid #ABEFC6;
                background: var(--green-soft);
                color: var(--green);
            }

            /* =========================================================
                   EMAIL
                ========================================================== */

            .email {
                margin-bottom: 5px;
                color: #475467;
                font-size: 13px;
                font-weight: 650;
            }

            /* =========================================================
                   MESSAGE PREVIEW
                ========================================================== */

            .preview {
                max-width: 900px;
                margin-bottom: 6px;
                color: var(--muted);
                font-size: 14px;
                line-height: 1.6;
            }

            /* =========================================================
                   DATE
                ========================================================== */

            .date {
                color: var(--light-text);
                font-size: 12px;
                font-weight: 500;
            }

            /* =========================================================
                   OPEN BUTTON
                ========================================================== */

            .open-button {
                min-width: 125px;
                min-height: 42px;
                padding: 0 16px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 9px;
                background: var(--orange);
                color: #FFFFFF;
                font-size: 13px;
                font-weight: 800;
                text-decoration: none;
                box-shadow: 0 4px 12px rgba(253, 80, 0, 0.20);
                transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
            }

                .open-button:hover {
                    background: var(--orange-dark);
                    color: #FFFFFF;
                    transform: translateY(-2px);
                    box-shadow: 0 7px 18px rgba(253, 80, 0, 0.28);
                }

                .open-button:active {
                    transform: translateY(0);
                }

            /* =========================================================
                   EMPTY STATE
                ========================================================== */

            .empty {
                padding: 65px 20px;
                text-align: center;
                color: var(--muted);
                font-size: 15px;
                font-weight: 600;
            }

            /* =========================================================
                   TEXT SELECTION
                ========================================================== */

            ::selection {
                background: rgba(253, 80, 0, 0.18);
                color: var(--dark);
            }

            /* =========================================================
                   TABLET
                ========================================================== */

            @@media (max-width: 900px) {

                .topbar {
                    padding: 0 22px;
                }

                .content {
                    width: calc(100% - 30px);
                    padding-top: 30px;
                }

                .stats {
                    gap: 12px;
                }

                .stat {
                    padding: 20px;
                }

                    .stat strong {
                        font-size: 28px;
                    }

                .row {
                    grid-template-columns: 52px minmax(0, 1fr) auto;
                    padding: 18px;
                }
            }

            /* =========================================================
                   MOBILE
                ========================================================== */

            @@media (max-width: 700px) {

                .topbar {
                    position: relative;
                    min-height: auto;
                    padding: 15px 16px;
                    align-items: flex-start;
                }

                .logo {
                    width: 42px;
                    height: 42px;
                    font-size: 19px;
                }

                .brand strong {
                    font-size: 18px;
                }

                .brand span {
                    font-size: 11px;
                }

                .dashboard-link {
                    min-height: 40px;
                    padding: 0 11px;
                    font-size: 12px;
                }

                .content {
                    width: calc(100% - 22px);
                    padding: 25px 0 60px;
                }

                .header {
                    margin-bottom: 22px;
                }

                    .header h1 {
                        font-size: 30px;
                    }

                    .header p {
                        font-size: 14px;
                    }

                .stats {
                    grid-template-columns: 1fr;
                }

                .stat {
                    min-height: 100px;
                }

                .toolbar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search,
                .filter {
                    width: 100%;
                }

                .row {
                    grid-template-columns: 48px minmax(0, 1fr);
                    gap: 13px;
                    padding: 17px;
                }

                .avatar {
                    width: 47px;
                    height: 47px;
                    font-size: 17px;
                }

                .info h3 {
                    font-size: 15px;
                }

                .preview {
                    font-size: 13px;
                }

                .open-button {
                    grid-column: 1 / -1;
                    width: 100%;
                    min-height: 44px;
                    margin-top: 3px;
                    font-size: 14px;
                }
            }

            /* =========================================================
                   VERY SMALL MOBILE
                ========================================================== */

            @@media (max-width: 480px) {

                .topbar {
                    gap: 10px;
                }

                .brand {
                    gap: 9px;
                }

                .dashboard-link {
                    padding: 0 9px;
                }

                .header h1 {
                    font-size: 27px;
                }

                .stat strong {
                    font-size: 27px;
                }

                .row {
                    padding: 15px;
                }
            }

    </style>
   

</head>

<body>

   
    <div class="page">

        <header class="topbar">

            <div class="brand">

                <div class="logo">
                    W
                </div>

                <div>

                    <strong>
                        WorkHub
                    </strong>

                    <span>
                        Administration · Inquiries
                    </span>

                </div>

            </div>

            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="dashboard-link">

                ← Dashboard

            </a>

        </header>

        <main class="content">

            <div class="header">

                <span>
                    Customer Support
                </span>

                <h1>
                    Contact Inquiries
                </h1>

                <p>
                    Review messages submitted through
                    the WorkHub Contact page and reply
                    to customers.
                </p>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="message success">
                    ✓ @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="message error">
                    @Model.ErrorMessage
                </div>
            }

            <div class="stats">

                <div class="stat">

                    <strong>
                        @Model.TotalCount
                    </strong>

                    <span>
                        Total Inquiries
                    </span>

                </div>

                <div class="stat">

                    <strong>
                        @Model.NewCount
                    </strong>

                    <span>
                        New / Waiting
                    </span>

                </div>

                <div class="stat">

                    <strong>
                        @Model.RepliedCount
                    </strong>

                    <span>
                        Replied
                    </span>

                </div>

            </div>

            <div class="toolbar">

                <input type="text"
                       id="inquirySearch"
                       class="search"
                       placeholder="Search name, email, topic or message..." />

                <select id="statusFilter"
                        class="filter">

                    <option value="">
                        All Statuses
                    </option>

                    <option value="new">
                        New
                    </option>

                    <option value="replied">
                        Replied
                    </option>

                </select>

            </div>

            <div class="panel"
                 id="inquiryList">

                @if (Model.Inquiries != null && Model.Inquiries.Any())
                {
                    @foreach (var inquiry in Model.Inquiries)
                    {
                        var initial =
                            string.IsNullOrWhiteSpace(inquiry.Name)
                                ? "?"
                                : inquiry.Name
                                    .Substring(0, 1)
                                    .ToUpperInvariant();

                        <div class="row inquiry-row"
                             data-status="@inquiry.Status.ToLowerInvariant()"
                             data-search="@($"{inquiry.Name} {inquiry.Email} {inquiry.InquiryType} {inquiry.Subject} {inquiry.Message}".ToLowerInvariant())">

                            <div class="avatar">
                                @initial
                            </div>

                            <div class="info">

                                <div class="info-top">

                                    <h3>
                                        @inquiry.Name
                                    </h3>

                                    <span class="topic">
                                        @inquiry.InquiryType
                                    </span>

                                    @if (string.Equals(
                                        inquiry.Status,
                                        "Replied",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status status-replied">
                                            Replied
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-new">
                                            New
                                        </span>
                                    }

                                </div>

                                <div class="email">
                                    @inquiry.Email
                                </div>

                                @if (!string.IsNullOrWhiteSpace(inquiry.Subject))
                                {
                                    <div class="preview">
                                        <strong>@inquiry.Subject</strong>
                                    </div>
                                }

                                <div class="preview">
                                    @inquiry.ShortMessage
                                </div>

                                <div class="date">
                                    @inquiry.CreatedDateText
                                </div>

                            </div>

                            <a asp-controller="AdminInquiries"
                               asp-action="Details"
                               asp-route-id="@inquiry.InquiryId"
                               class="open-button">

                                Open Inquiry

                            </a>

                        </div>
                    }
                }
                else
                {
                    <div class="empty">
                        No contact inquiries found.
                    </div>
                }

            </div>

        </main>

    </div>

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function() {

                    const search =
                        document.getElementById(
                            "inquirySearch"
                        );

                    const filter =
                        document.getElementById(
                            "statusFilter"
                        );

                    const rows =
                        document.querySelectorAll(
                            ".inquiry-row"
                        );

                    function applyFilters() {

                        const searchValue =
                            (
                                search?.value
                                ||
                                ""
                            )
                                .trim()
                                .toLowerCase();

                        const statusValue =
                            (
                                filter?.value
                                ||
                                ""
                            )
                                .toLowerCase();

                        rows.forEach(
                            function(row) {

                                const rowSearch =
                                    row.dataset.search
                                    ||
                                    "";

                                const rowStatus =
                                    row.dataset.status
                                    ||
                                    "";

                                const matchesSearch =
                                    !searchValue
                                    ||
                                    rowSearch.includes(
                                        searchValue);

                                const matchesStatus =
                                    !statusValue
                                    ||
                                    rowStatus ===
                                    statusValue;

                                row.style.display =
                                    matchesSearch &&
                                        matchesStatus
                                        ? "grid"
                                        : "none";
                            }
                        );
                    }

                    search?.addEventListener(
                        "input",
                        applyFilters
                    );

                    filter?.addEventListener(
                        "change",
                        applyFilters
                    );

                }
            );

    </script>
   

</body>

</html>
