                                <circle cx="12" cy="12" r="9" />

                            </svg>

                        </span>

                        <span>@Model.ErrorMessage</span>

                    </div>
                }


                <form asp-controller="Contact"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="contact-form-grid">

                        <!-- NAME -->

                        <div class="contact-field">

                            <label asp-for="FullName">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="contact-input"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="FullName"
                                  class="contact-validation">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="contact-field">

                            <label asp-for="Email">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="contact-input"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="contact-validation">
                            </span>

                        </div>


                        <!-- TOPIC -->

                        <div class="contact-field full">

                            <label asp-for="Topic">
                                What do you need help with?
                            </label>

                            <select asp-for="Topic"
                                    class="contact-select">

                                <option value="">
                                    Select a topic
                                </option>

                                <option value="Jobs & Applications">
                                    Jobs & Applications
                                </option>

                                <option value="Company Account">
                                    Company / Employer Account
                                </option>

                                <option value="Services">
                                    Services
                                </option>

                                <option value="Marketplace">
                                    Marketplace
                                </option>

                                <option value="Account & Profile">
                                    Account & Profile
                                </option>

                                <option value="Technical Support">
                                    Technical Problem
                                </option>

                                <option value="General Question">
                                    General Question
                                </option>

                            </select>

                            <span asp-validation-for="Topic"
                                  class="contact-validation">
                            </span>

                        </div>


                        <!-- MESSAGE -->

                        <div class="contact-field full">

                            <label asp-for="Message">
                                Message
                            </label>

                            <textarea asp-for="Message"
                                      class="contact-textarea"
                                      placeholder="Describe your question or issue..."></textarea>

                            <span asp-validation-for="Message"
                                  class="contact-validation">
                            </span>

                        </div>

                    </div>


                    <button type="submit"
                            class="contact-submit">

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m22 2-7 20-4-9-9-4Z" />
                            <path d="M22 2 11 13" />
                        </svg>

