                        <path d="M8 11h.01" />
                        <path d="M12 11h.01" />
                        <path d="M16 11h.01" />
                    </svg>
                </span>

                Contact WorkHub

            </span>

            <h1>
                How can we
                <span>help you?</span>
            </h1>

            <p>
                Send your question or support request
                directly to the WorkHub team.
            </p>

        </div>

    </div>


    <div class="contact-container">

        <div class="contact-main">

            <!-- =====================================
             FORM
        ====================================== -->

            <div class="contact-panel">

                <div class="contact-panel-heading">

                    <div class="contact-title-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                            <path d="m22 6-10 7L2 6" />
                        </svg>
                    </div>

                    <div>
                        <h2>Send a Message</h2>
                        <p class="contact-panel-description">
                            Complete the form below and your
                            inquiry will be submitted to WorkHub.
                        </p>
                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="contact-success">

                        <span class="contact-message-icon">

                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m5 12 4 4L19 6" />
                            </svg>

                        </span>

                        <span>@Model.SuccessMessage</span>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
