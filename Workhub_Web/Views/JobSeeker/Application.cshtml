                                                @cv.FileName
                                            </div>


                                            <div class="cv-meta">

                                                @cv.FileTypeText
                                                ·
                                                @cv.FileSizeText

                                                <br />

                                                Uploaded:
                                                @cv.UploadedDateText

                                            </div>


                                            @if (cv.IsPrimary)
                                            {
                                                <span class="primary-badge">

                                                    ✓ PRIMARY CV

                                                </span>
                                            }


