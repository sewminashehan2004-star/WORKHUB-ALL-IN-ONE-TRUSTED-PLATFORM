@model Workhub_Web.Models.MarketplaceChatViewModel
@{ ViewData["Title"] = "Marketplace Chat"; }
<style>
.chat-page{min-height:calc(100vh - 80px);padding:38px 0 75px;background:#f8fafc}.chat-shell{width:min(900px,calc(100% - 30px));margin:auto}.chat-back{display:inline-block;margin-bottom:17px;color:#475569;font-size:13px;font-weight:850}.chat-card{overflow:hidden;background:#fff;border:1px solid #e2e8f0;border-radius:20px;box-shadow:0 18px 48px rgba(15,23,42,.08)}.chat-head{padding:20px 22px;display:flex;justify-content:space-between;align-items:center;gap:18px;border-bottom:1px solid #edf0f4;background:linear-gradient(135deg,#101827,#2a1720);color:#fff}.chat-head small{display:block;color:#ffb18e;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.chat-head h1{font-size:20px;margin:4px 0}.chat-head p{margin:0;color:#cbd5e1;font-size:11px}.chat-status{padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.12);font-size:10px;font-weight:900}.chat-stream{height:520px;overflow-y:auto;padding:22px;background:linear-gradient(180deg,#fbfcfe,#f8fafc)}.message{display:flex;margin-bottom:12px}.message.mine{justify-content:flex-end}.bubble{max-width:72%;padding:11px 13px;border-radius:15px 15px 15px 4px;background:#fff;border:1px solid #e2e8f0;box-shadow:0 4px 12px rgba(15,23,42,.04)}.mine .bubble{background:#fd5000;color:#fff;border-color:#fd5000;border-radius:15px 15px 4px 15px}.bubble p{margin:0;font-size:13px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}.bubble small{display:block;margin-top:5px;font-size:9px;color:#94a3b8}.mine .bubble small{color:#ffe3d6}.composer{display:grid;grid-template-columns:1fr auto;gap:10px;padding:16px;border-top:1px solid #edf0f4;background:#fff}.composer textarea{min-height:48px;max-height:130px;resize:vertical;padding:12px 13px;border:1px solid #cbd5e1;border-radius:11px;font:inherit;font-size:13px;outline:none}.composer textarea:focus{border-color:#fd5000;box-shadow:0 0 0 3px rgba(253,80,0,.09)}.send{min-width:110px;border:0;border-radius:11px;background:#fd5000;color:#fff;font-size:12px;font-weight:900;cursor:pointer}.closed{padding:16px;text-align:center;color:#64748b;font-size:12px}@@media(max-width:600px){.chat-stream{height:450px;padding:15px}.bubble{max-width:88%}.composer{grid-template-columns:1fr}.send{min-height:45px}.chat-head{align-items:flex-start;flex-direction:column}}
</style>
<section class="chat-page"><div class="chat-shell"><a class="chat-back" asp-action="Index">← All messages</a>@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="wh-alert danger">@Model.ErrorMessage</div>}<div class="chat-card"><header class="chat-head"><div><small>Marketplace conversation</small><h1>@Model.Conversation.Listing.Title</h1><p>$@Model.Conversation.Listing.Price.ToString("N0") • @Model.Conversation.Listing.ListingType @if(!string.IsNullOrWhiteSpace(Model.Conversation.Listing.Location)){<text> • @Model.Conversation.Listing.Location</text>}</p></div><span class="chat-status">@Model.Conversation.Status</span></header><div class="chat-stream" id="chatStream">@foreach(var message in Model.Messages){<div class="message @(message.IsMine ? "mine" : "theirs")"><div class="bubble"><p>@message.MessageText</p><small>@message.SentAt.ToLocalTime().ToString("dd MMM, h:mm tt")</small></div></div>}</div>@if(string.Equals(Model.Conversation.Status,"Open",StringComparison.OrdinalIgnoreCase)){<form asp-action="Send" asp-route-id="@Model.Conversation.MarketplaceConversationId" method="post" class="composer">@Html.AntiForgeryToken()<textarea name="message" maxlength="2000" placeholder="Write a message..." required></textarea><button class="send" type="submit">Send →</button></form>}else{<div class="closed">This conversation is closed.</div>}</div></div></section>
@section Scripts{<script>const stream=document.getElementById('chatStream');if(stream)stream.scrollTop=stream.scrollHeight;</script>}
