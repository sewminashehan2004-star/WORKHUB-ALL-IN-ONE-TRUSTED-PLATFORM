@{
    ViewData["Title"] = "About Us";
}

<style>

    :root {
        --about-orange: #FD5000;
        --about-orange-dark: #D94300;
        --about-orange-soft: #FFF3EC;
        --about-orange-pale: #FFF8F4;
        --about-dark: #0F172A;
        --about-dark-2: #1E293B;
        --about-text: #334155;
        --about-muted: #64748B;
        --about-border: #E2E8F0;
        --about-light: #F8FAFC;
        --about-white: #FFFFFF;
        --about-green: #16A34A;
    }


    * {
        box-sizing: border-box;
    }


    /* =========================================================
           PAGE
        ========================================================= */

    .about-page {
        min-height: 100vh;
        background: radial-gradient( circle at 10% 15%, rgba(253,80,0,.035), transparent 25% ), #F8FAFC;
        overflow: hidden;
    }


    .about-container {
        width: calc(100% - 40px);
        max-width: 1200px;
        margin: 0 auto;
    }


    /* =========================================================
           ICONS
        ========================================================= */

    .about-icon {
        width: 21px;
        height: 21px;
        display: block;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .about-icon-sm {
        width: 17px;
        height: 17px;
    }

    .about-icon-lg {
        width: 26px;
        height: 26px;
    }


    /* =========================================================
           HERO
        ========================================================= */

    .about-hero {
        position: relative;
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        overflow: hidden;
        text-align: center;
        color: #FFFFFF;
        background: radial-gradient( circle at 82% 20%, rgba(253,80,0,.42), transparent 28% ), radial-gradient( circle at 10% 90%, rgba(253,80,0,.13), transparent 30% ), radial-gradient( circle at 55% 100%, rgba(255,255,255,.05), transparent 35% ), linear-gradient( 125deg, #090F1C, #111827 52%, #28150D );
    }


        .about-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .28;
            background-image: linear-gradient( rgba(255,255,255,.035) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.035) 1px, transparent 1px );
            background-size: 55px 55px;
            mask-image: linear-gradient( to bottom, black, transparent 90% );
        }


        .about-hero::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            right: -250px;
            bottom: -310px;
            border-radius: 50%;
            border: 1px solid rgba(253,80,0,.25);
            box-shadow: 0 0 0 45px rgba(253,80,0,.025), 0 0 0 90px rgba(253,80,0,.018), 0 0 0 135px rgba(253,80,0,.012);
        }


    .about-hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
        animation: aboutFadeUp .7s ease both;
    }


    .about-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        padding: 8px 14px;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 999px;
        background: rgba(255,255,255,.07);
        backdrop-filter: blur(10px);
        color: #FDBA74;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }


        .about-label::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--about-orange);
            box-shadow: 0 0 12px rgba(253,80,0,.9);
        }


    .about-hero h1 {
        max-width: 900px;
        margin: 0 auto 20px;
        color: #FFFFFF;
        font-size: clamp(42px, 6vw, 67px);
        font-weight: 950;
        line-height: 1.04;
        letter-spacing: -2.5px;
    }


        .about-hero h1::first-line {
            color: #FFFFFF;
        }


    .about-hero p {
        max-width: 730px;
        margin: 0 auto;
        color: #CBD5E1;
        font-size: 15px;
        line-height: 1.8;
    }


    /* =========================================================
           COMMON SECTIONS
        ========================================================= */

    .about-section {
        padding: 85px 0;
    }


    .about-section-light {
        background: linear-gradient( 180deg, #F8FAFC, #F1F5F9 );
    }


    .about-small-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 11px;
        color: var(--about-orange);
        font-size: 9px;
        font-weight: 950;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }


        .about-small-label::before {
            content: "";
            width: 17px;
            height: 1px;
            background: var(--about-orange);
        }


    .about-title {
        margin: 0 0 18px;
        color: var(--about-dark);
        font-size: clamp(30px, 4vw, 39px);
        font-weight: 950;
        line-height: 1.15;
        letter-spacing: -1px;
    }


    .about-text {
        color: var(--about-muted);
        font-size: 14px;
        line-height: 1.85;
    }


    /* =========================================================
           INTRO
        ========================================================= */

    .about-intro-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
        gap: 60px;
        align-items: center;
    }


    .about-intro-card {
        position: relative;
        padding: 34px;
        border: 1px solid #FED7C2;
        border-radius: 21px;
        background: radial-gradient( circle at 100% 0%, rgba(253,80,0,.08), transparent 35% ), linear-gradient( 145deg, #FFF8F4, #FFFFFF );
        box-shadow: 0 20px 50px rgba(15,23,42,.07);
        overflow: hidden;
    }


        .about-intro-card::before {
            content: "";
            position: absolute;
            left: 30px;
            right: 30px;
            top: 0;
            height: 3px;
            background: linear-gradient( 90deg, var(--about-orange), #FF9A72 );
            box-shadow: 0 0 15px rgba(253,80,0,.35);
        }


        .about-intro-card h3 {
            margin: 0 0 13px;
            color: var(--about-dark);
            font-size: 23px;
            font-weight: 900;
        }


        .about-intro-card p {
            margin: 0;
            color: var(--about-muted);
            font-size: 13px;
            line-height: 1.75;
        }


    /* =========================================================
           STATS
        ========================================================= */

    .about-stat-grid {
        margin-top: 25px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }


    .about-stat {
        position: relative;
        padding: 17px;
        border: 1px solid #F1F5F9;
        border-radius: 13px;
        background: #FFFFFF;
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }


        .about-stat:hover {
            transform: translateY(-3px);
            border-color: #FED7C2;
            box-shadow: 0 10px 25px rgba(253,80,0,.06);
        }


        .about-stat strong {
            display: block;
            margin-bottom: 5px;
            color: var(--about-orange);
            font-size: 21px;
            font-weight: 950;
        }


        .about-stat span {
            color: var(--about-muted);
            font-size: 10px;
            line-height: 1.4;
        }


    /* =========================================================
           MISSION / VISION
        ========================================================= */

    .about-two-column {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }


    .about-info-card {
        position: relative;
        padding: 34px;
        border: 1px solid var(--about-border);
        border-radius: 19px;
        background: #FFFFFF;
        box-shadow: 0 8px 28px rgba(15,23,42,.04);
        overflow: hidden;
        transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
    }


        .about-info-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--about-orange), transparent );
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s ease;
        }


        .about-info-card:hover {
            transform: translateY(-6px);
            border-color: #FED7C2;
            box-shadow: 0 20px 45px rgba(15,23,42,.08);
        }


            .about-info-card:hover::before {
                transform: scaleX(1);
            }


    .about-info-icon {
        width: 56px;
        height: 56px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #FED7C2;
        border-radius: 15px;
        background: var(--about-orange-soft);
        color: var(--about-orange);
        box-shadow: 0 8px 20px rgba(253,80,0,.08);
    }


    .about-info-card h3 {
        margin: 0 0 11px;
        color: var(--about-dark);
        font-size: 23px;
        font-weight: 900;
    }


    .about-info-card p {
        margin: 0;
        color: var(--about-muted);
        font-size: 13px;
        line-height: 1.8;
    }


    /* =========================================================
           FEATURES
        ========================================================= */

    .about-services-header {
        max-width: 720px;
        margin: 0 auto 45px;
        text-align: center;
    }


        .about-services-header .about-small-label {
            justify-content: center;
        }


            .about-services-header .about-small-label::before {
                display: none;
            }


    .about-feature-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }


    .about-feature-card {
        position: relative;
        padding: 28px 25px;
        border: 1px solid var(--about-border);
        border-radius: 17px;
        background: #FFFFFF;
        overflow: hidden;
        transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
    }


        .about-feature-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--about-orange), #FF9A72 );
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s ease;
        }


        .about-feature-card:hover {
            transform: translateY(-7px);
            border-color: #FED7C2;
            box-shadow: 0 20px 40px rgba(15,23,42,.08);
        }


            .about-feature-card:hover::before {
                transform: scaleX(1);
            }


    .about-feature-icon {
        width: 52px;
        height: 52px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #FED7C2;
        border-radius: 14px;
        background: var(--about-orange-soft);
        color: var(--about-orange);
        transition: transform .25s ease, background .25s ease;
    }


    .about-feature-card:hover .about-feature-icon {
        transform: scale(1.06);
        background: #FFE8DC;
    }


    .about-feature-card h3 {
        margin: 0 0 9px;
        color: var(--about-dark);
        font-size: 18px;
        font-weight: 900;
    }


    .about-feature-card p {
        margin: 0;
        color: var(--about-muted);
        font-size: 12px;
        line-height: 1.75;
    }


    /* =========================================================
           WHY WORKHUB
        ========================================================= */

    .why-workhub-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }


    .why-item {
        position: relative;
        padding: 21px;
        display: flex;
        gap: 14px;
        border: 1px solid var(--about-border);
        border-radius: 15px;
        background: #FFFFFF;
        transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
    }


        .why-item:hover {
            transform: translateY(-3px);
            border-color: #FED7C2;
            box-shadow: 0 12px 28px rgba(15,23,42,.06);
        }


    .why-check {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #BBF7D0;
        border-radius: 11px;
        background: #F0FDF4;
        color: var(--about-green);
    }


    .why-item h4 {
        margin: 0 0 5px;
        color: var(--about-dark);
        font-size: 15px;
        font-weight: 900;
    }


    .why-item p {
        margin: 0;
        color: var(--about-muted);
        font-size: 11px;
        line-height: 1.65;
    }


    /* =========================================================
           HOW IT WORKS
        ========================================================= */

    .about-steps {
        position: relative;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 17px;
    }


    .about-step {
        position: relative;
        padding: 28px 21px;
        border: 1px solid var(--about-border);
        border-radius: 17px;
        background: #FFFFFF;
        text-align: center;
        box-shadow: 0 7px 24px rgba(15,23,42,.035);
        transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }


        .about-step:hover {
            transform: translateY(-6px);
            border-color: #FED7C2;
            box-shadow: 0 18px 38px rgba(15,23,42,.08);
        }


    .step-number {
        width: 49px;
        height: 49px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #FED7C2;
        border-radius: 14px;
        background: linear-gradient( 145deg, var(--about-orange), var(--about-orange-dark) );
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 950;
        box-shadow: 0 9px 22px rgba(253,80,0,.22);
    }


    .about-step h3 {
        margin: 0 0 8px;
        color: var(--about-dark);
        font-size: 16px;
        font-weight: 900;
    }


    .about-step p {
        margin: 0;
        color: var(--about-muted);
        font-size: 11px;
        line-height: 1.7;
    }


    /* =========================================================
           CTA
        ========================================================= */

    .about-cta {
        position: relative;
        padding: 85px 25px;
        overflow: hidden;
        background: radial-gradient( circle at 85% 20%, rgba(253,80,0,.28), transparent 28% ), radial-gradient( circle at 10% 100%, rgba(253,80,0,.10), transparent 30% ), linear-gradient( 120deg, #090F1C, #111827 55%, #24140E );
        text-align: center;
        color: #FFFFFF;
    }


        .about-cta::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .2;
            background-image: linear-gradient( rgba(255,255,255,.03) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.03) 1px, transparent 1px );
            background-size: 50px 50px;
        }


    .about-cta-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
        margin: 0 auto;
    }


    .about-cta-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        color: #FDBA74;
        font-size: 9px;
        font-weight: 950;
        letter-spacing: 1.4px;
        text-transform: uppercase;
    }


        .about-cta-label::before {
            content: "";
            width: 18px;
            height: 1px;
            background: var(--about-orange);
        }


    .about-cta h2 {
        margin: 0 0 14px;
        color: #FFFFFF;
        font-size: clamp(30px, 5vw, 43px);
        font-weight: 950;
        line-height: 1.15;
        letter-spacing: -1px;
    }


    .about-cta p {
        max-width: 650px;
        margin: 0 auto 28px;
        color: #CBD5E1;
        font-size: 13px;
        line-height: 1.75;
    }


    .about-cta-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }


    .about-primary-button,
    .about-secondary-button {
        min-width: 170px;
        padding: 13px 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 900;
        text-decoration: none;
        transition: transform .25s ease, background .25s ease, border-color .25s ease, box-shadow .25s ease;
    }


    .about-primary-button {
        border: 1px solid var(--about-orange);
        background: var(--about-orange);
        color: #FFFFFF;
    }


        .about-primary-button:hover {
            background: var(--about-orange-dark);
            border-color: var(--about-orange-dark);
            color: #FFFFFF;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(253,80,0,.28);
        }


    .about-secondary-button {
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.06);
        color: #FFFFFF;
        backdrop-filter: blur(10px);
    }


        .about-secondary-button:hover {
            background: rgba(255,255,255,.12);
            border-color: rgba(255,255,255,.4);
            color: #FFFFFF;
            transform: translateY(-3px);
        }


    /* =========================================================
           ANIMATION
        ========================================================= */

    @@keyframes aboutFadeUp {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 950px) {

        .about-intro-grid {
            grid-template-columns: 1fr;
        }

        .about-feature-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .about-steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 680px) {

        .about-container {
            width: calc(100% - 28px);
        }

        .about-hero {
            min-height: 440px;
            padding: 65px 18px;
        }

            .about-hero h1 {
                font-size: 41px;
                letter-spacing: -1.4px;
            }

            .about-hero p {
                font-size: 13px;
            }

        .about-section {
            padding: 62px 0;
        }

        .about-title {
            font-size: 31px;
        }

        .about-two-column,
        .about-feature-grid,
        .why-workhub-grid,
        .about-steps {
            grid-template-columns: 1fr;
        }

        .about-stat-grid {
            grid-template-columns: 1fr;
        }

        .about-intro-card,
        .about-info-card {
            padding: 27px;
        }

        .about-cta {
            padding: 65px 20px;
        }

        .about-cta-buttons {
            flex-direction: column;
        }

        .about-primary-button,
        .about-secondary-button {
            width: 100%;
        }
    }


    @@media (max-width: 430px) {

        .about-hero h1 {
            font-size: 35px;
        }

        .about-hero p {
            font-size: 12px;
        }

        .about-feature-card {
            padding: 24px 21px;
        }

        .about-cta h2 {
            font-size: 30px;
        }
    }
</style>


<div class="about-page">


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="about-hero">

        <div class="about-hero-content">

            <span class="about-label">
                About WorkHub
            </span>

            <h1>
                Connecting People,
                Skills and Opportunities
            </h1>

            <p>
                WorkHub is an integrated digital platform
                designed to connect job seekers, employers,
                service providers, customers and marketplace
                users through one convenient system.
            </p>

        </div>

    </section>


    <!-- =====================================================
         INTRODUCTION
    ====================================================== -->

    <section class="about-section">

        <div class="about-container">

            <div class="about-intro-grid">


                <!-- LEFT -->

                <div>

                    <span class="about-small-label">
                        Who We Are
                    </span>

                    <h2 class="about-title">
                        One Platform for Work,
                        Services and Marketplace
                    </h2>

                    <p class="about-text">
                        WorkHub brings several important
                        opportunities together in one platform.
                        Users can search for jobs, connect with
                        professional service providers and explore
                        marketplace products available for sale
                        or rent.
                    </p>

                    <br />

                    <p class="about-text">
                        Registered users can also create different
                        profiles depending on their needs. A user
                        can become a job seeker, service provider
                        or marketplace seller while employers can
                        create company profiles and manage job
                        opportunities.
                    </p>

                </div>


                <!-- RIGHT CARD -->

                <div class="about-intro-card">

                    <h3>
                        What WorkHub Connects
                    </h3>

                    <p>
                        WorkHub provides a common digital
                        environment where different users can
                        discover opportunities and interact with
                        relevant services.
                    </p>


                    <div class="about-stat-grid">


                        <!-- JOBS -->

                        <div class="about-stat">

                            <strong>
                                Jobs
                            </strong>

                            <span>
                                Job seekers and employers
                            </span>

                        </div>


                        <!-- SERVICES -->

                        <div class="about-stat">

                            <strong>
                                Services
                            </strong>

                            <span>
                                Customers and professionals
                            </span>

                        </div>


                        <!-- MARKET -->

                        <div class="about-stat">

                            <strong>
                                Market
                            </strong>

                            <span>
                                Buyers, renters and sellers
                            </span>

                        </div>


                        <!-- SMART -->

                        <div class="about-stat">

                            <strong>
                                Smart
                            </strong>

                            <span>
                                CV-to-job matching
                            </span>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         MISSION / VISION
    ====================================================== -->

    <section class="about-section about-section-light">

        <div class="about-container">

            <div class="about-two-column">


                <!-- MISSION -->

                <div class="about-info-card">

                    <div class="about-info-icon">

                        <svg class="about-icon about-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <circle cx="12"
                                    cy="12"
                                    r="9"></circle>

                            <circle cx="12"
                                    cy="12"
                                    r="5"></circle>

                            <circle cx="12"
                                    cy="12"
                                    r="1.5"></circle>

                        </svg>

                    </div>

                    <h3>
                        Our Mission
                    </h3>

                    <p>
                        Our mission is to provide an accessible
                        and practical platform that allows people
                        to discover employment opportunities,
                        promote professional services and
                        participate in a trusted digital
                        marketplace.
                    </p>

                </div>


                <!-- VISION -->

                <div class="about-info-card">

                    <div class="about-info-icon">

                        <svg class="about-icon about-icon-lg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z"></path>

                            <circle cx="12"
                                    cy="12"
                                    r="2.5"></circle>

                            <path d="M12 3v2"></path>
                            <path d="M19 5l-1.5 1.5"></path>

                        </svg>

                    </div>

                    <h3>
                        Our Vision
                    </h3>

