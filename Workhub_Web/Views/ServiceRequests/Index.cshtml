@model Workhub_Web.Models.ServiceRequestDashboardViewModel

@{
ViewData["Title"] = "My Service Requests";
}

<style>
    :root {
        --wh-orange: #ff5a1f;
        --wh-orange-dark: #e8470d;
        --wh-orange-light: #fff1ea;
        --wh-orange-soft: #fff8f4;

        --wh-dark: #111827;
        --wh-dark-2: #1f2937;
        --wh-text: #334155;
        --wh-muted: #64748b;
        --wh-light-text: #94a3b8;

        --wh-border: #e5e7eb;
        --wh-bg: #f8fafc;
        --wh-white: #ffffff;

        --wh-green: #16a34a;
        --wh-green-light: #f0fdf4;

        --wh-red: #dc2626;
        --wh-red-light: #fef2f2;

        --wh-shadow: 0 18px 45px rgba(15, 23, 42, .08);
        --wh-shadow-hover: 0 25px 60px rgba(255, 90, 31, .14);
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .request-page {
        min-height: 100vh;

        background:
            radial-gradient(
                circle at 8% 8%,
                rgba(255, 90, 31, .06),
                transparent 25%
            ),
            radial-gradient(
                circle at 92% 45%,
                rgba(255, 90, 31, .045),
                transparent 28%
            ),
            var(--wh-bg);

        color: var(--wh-text);

        padding-bottom: 80px;

        overflow-x: hidden;
    }


    .request-shell {
        width: min(
            1180px,
            calc(100% - 40px)
        );

        margin: 0 auto;
    }


    /* =========================================================
       ICONS
       ========================================================= */

    .wh-icon {
        width: 18px;
        height: 18px;

        flex: 0 0 auto;

        stroke: currentColor;

        fill: none;

        stroke-width: 2;

        stroke-linecap: round;

        stroke-linejoin: round;
    }


    .wh-icon-sm {
        width: 15px;
        height: 15px;
    }


    .wh-icon-lg {
        width: 26px;
        height: 26px;
    }


    .wh-icon-xl {
        width: 40px;
        height: 40px;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .request-hero {
        position: relative;

        min-height: 330px;

        display: flex;

        align-items: center;

        overflow: hidden;

        background:
            radial-gradient(
                circle at 82% 28%,
                rgba(255, 90, 31, .30),
                transparent 28%
            ),
            radial-gradient(
                circle at 12% 85%,
                rgba(255, 90, 31, .13),
                transparent 28%
            ),
            linear-gradient(
                115deg,
                #0f172a 0%,
                #171717 48%,
                #301509 100%
            );

        border-radius:
            0 0 30px 30px;
    }


    .request-hero::before {
        content: "";

        position: absolute;

        width: 560px;
        height: 560px;

        right: -230px;
        top: -300px;

        border-radius: 50%;

        border:
            1px solid
            rgba(255,90,31,.25);

        box-shadow:
            0 0 0 35px rgba(255,90,31,.035),
            0 0 0 70px rgba(255,90,31,.025);
    }


    .request-hero::after {
        content: "";

        position: absolute;

        width: 300px;
        height: 300px;

        left: -170px;
        bottom: -210px;

        border-radius: 50%;

        background:
            rgba(255,90,31,.11);

        filter: blur(3px);
    }


    .request-hero-grid {
        position: absolute;

        inset: 0;

        opacity: .06;

        background-image:
            linear-gradient(
                rgba(255,255,255,.5) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255,255,255,.5) 1px,
                transparent 1px
            );

        background-size:
            48px 48px;

        mask-image:
            linear-gradient(
                to bottom,
                black,
                transparent
            );
    }


    .request-hero-inner {
        position: relative;

        z-index: 5;

        width: min(
            1180px,
            calc(100% - 40px)
        );

        margin: 0 auto;

        padding: 70px 0;
    }


    .request-hero-content {
        max-width: 720px;
    }


    .request-eyebrow {
        display: inline-flex;

        align-items: center;

        gap: 9px;

        padding:
            8px 14px;

        border:
            1px solid
            rgba(255,255,255,.14);

        background:
            rgba(255,255,255,.07);

        backdrop-filter:
            blur(14px);

        border-radius:
            999px;

        color:
            #fff;

        font-size:
            11px;

        font-weight:
            900;

        text-transform:
            uppercase;

        letter-spacing:
            .07em;

        margin-bottom:
            18px;
    }


    .request-eyebrow-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background:
            var(--wh-orange);

        box-shadow:
            0 0 16px
            rgba(255,90,31,.8);
    }


    .request-hero h1 {
        margin: 0;

        color:
            #fff;

        font-size:
            clamp(
                38px,
                5.5vw,
                62px
            );

        line-height:
            1.04;

        font-weight:
            900;

        letter-spacing:
            -2.2px;
    }


    .request-hero h1 span {
        color:
            var(--wh-orange);
    }


    .request-hero p {
        max-width:
            650px;

        margin:
            18px 0 0;

        color:
            rgba(255,255,255,.70);

        font-size:
            16px;

        line-height:
            1.75;
    }


    /* =========================================================
       HERO BUTTON
       ========================================================= */

    .request-hero-button {
        position: absolute;

        z-index: 7;

        right: max(
            30px,
            calc((100vw - 1180px) / 2)
        );

        bottom: 48px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 9px;

        min-height: 48px;

        padding:
            0 17px;

        border-radius:
            13px;

        background:
            #fff;

        color:
            var(--wh-dark);

        text-decoration:
            none;

        font-size:
            12px;

        font-weight:
            900;

        box-shadow:
            0 12px 30px
            rgba(0,0,0,.18);

        transition:
            .25s ease;
    }


    .request-hero-button:hover {
        transform:
            translateY(-3px);

        color:
            var(--wh-orange-dark);

        box-shadow:
            0 18px 35px
            rgba(0,0,0,.25);
    }


    /* =========================================================
       ALERTS
       ========================================================= */

    .request-alert {
        display: flex;

        align-items: center;

        gap: 10px;

        margin-top:
            24px;

        padding:
            15px 18px;

        border-radius:
            15px;

        font-size:
            13px;

        font-weight:
            700;
    }


    .request-alert.success {
        background:
            var(--wh-green-light);

        border:
            1px solid
            #bbf7d0;

        color:
            #166534;
    }


    .request-alert.danger {
        background:
            var(--wh-red-light);

        border:
            1px solid
            #fecaca;

        color:
            #991b1b;
    }


    /* =========================================================
       PANEL
       ========================================================= */

    .request-panel {
        position: relative;

        margin-top:
            28px;

        padding:
            27px;

        background:
            #fff;

        border:
            1px solid
            var(--wh-border);

        border-radius:
            23px;

        box-shadow:
            var(--wh-shadow);
    }


    .request-panel::before {
        content: "";

        position: absolute;

        top: 0;

        left: 12%;

        right: 12%;

        height: 3px;

        border-radius:
            0 0 999px 999px;

        background:
            linear-gradient(
                90deg,
                transparent,
                var(--wh-orange),
                transparent
            );
    }


    .request-panel-heading {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        margin-bottom:
            24px;
    }


    .request-kicker {
        display: flex;

        align-items: center;

        gap: 8px;

        color:
            var(--wh-orange);

        font-size:
            11px;

        font-weight:
            900;

        text-transform:
            uppercase;

        letter-spacing:
            .08em;

        margin-bottom:
            8px;
    }


    .request-kicker::before {
        content: "";

        width: 24px;
        height: 3px;

        border-radius:
            999px;

        background:
            var(--wh-orange);
    }


    .request-panel-heading h2 {
        margin: 0;

        color:
            var(--wh-dark);

        font-size:
            26px;

        font-weight:
            900;

        letter-spacing:
            -.7px;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .request-form {
        display: grid;

        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );

        gap:
            17px;
    }


    .request-field {
        min-width:
            0;
    }


    .request-field.full {
        grid-column:
            1 / -1;
    }


    .request-field label {
        display: block;

        margin:
            0 0 7px 3px;

        color:
            var(--wh-muted);

        font-size:
            11px;

        font-weight:
            900;

        text-transform:
            uppercase;

        letter-spacing:
            .06em;
    }


    .request-input,
    .request-select,
    .request-textarea {
        width: 100%;

        border:
            1px solid
            var(--wh-border);

        border-radius:
            13px;

        background:
            #fff;

        color:
            var(--wh-dark);

        outline:
            none;

        font-size:
            14px;

        font-weight:
            600;

        transition:
            .25s ease;

        box-sizing:
            border-box;
    }


    .request-input,
    .request-select {
        height:
            52px;

        padding:
            0 14px;
    }


    .request-textarea {
        min-height:
            120px;

        resize:
            vertical;

        padding:
            14px;
    }


    .request-input::placeholder,
    .request-textarea::placeholder {
        color:
            #a3afbd;
    }


    .request-input:focus,
    .request-select:focus,
    .request-textarea:focus {
        border-color:
            var(--wh-orange);

        box-shadow:
            0 0 0 4px
            rgba(255,90,31,.09);
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .request-button {
        min-height:
            48px;

        padding:
            0 18px;

        border:
            0;

        border-radius:
            12px;

        display:
            inline-flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            8px;

        font-size:
            12px;

        font-weight:
            900;

        cursor:
            pointer;

        transition:
            .25s ease;
    }


    .request-button.primary {
        background:
            linear-gradient(
                135deg,
                var(--wh-orange),
                var(--wh-orange-dark)
            );

        color:
            #fff;

        box-shadow:
            0 10px 24px
            rgba(255,90,31,.22);
    }


    .request-button.primary:hover {
        transform:
            translateY(-2px);

        box-shadow:
            0 15px 30px
            rgba(255,90,31,.30);
    }


    .request-button.ghost {
        background:
            #fff;

        color:
            var(--wh-dark);

        border:
            1px solid
            var(--wh-border);
    }


    .request-button.ghost:hover {
        background:
            var(--wh-orange-soft);

        color:
            var(--wh-orange-dark);

        border-color:
            rgba(255,90,31,.30);
    }


    .request-button.small {
        min-height:
            38px;

        padding:
            0 13px;

        font-size:
            11px;
    }


    .request-form-submit {
        grid-column:
            1 / -1;
    }


    /* =========================================================
       REQUEST SECTION
       ========================================================= */

    .requests-section {
        margin-top:
            58px;
    }


    .requests-heading {
        display:
            flex;

        align-items:
            flex-end;

        justify-content:
            space-between;

        gap:
            20px;

        margin-bottom:
            25px;
    }


    .requests-heading h2 {
        margin:
            0;

        color:
            var(--wh-dark);

        font-size:
            31px;

        font-weight:
            900;

        letter-spacing:
            -1px;
    }


    .request-count {
        display:
            inline-flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            7px;

        min-width:
            42px;

        height:
            38px;

        padding:
            0 13px;

        border-radius:
            999px;

        background:
            var(--wh-orange-light);

        border:
            1px solid
            rgba(255,90,31,.12);

        color:
            var(--wh-orange-dark);

        font-size:
            12px;

        font-weight:
            900;
    }


    /* =========================================================
       EMPTY
       ========================================================= */

    .requests-empty {
        padding:
            65px 25px;

        text-align:
            center;

        background:
            #fff;

        border:
            1px solid
            var(--wh-border);

        border-radius:
            23px;

        box-shadow:
            var(--wh-shadow);
    }


    .requests-empty-icon {
        width:
            82px;

        height:
            82px;

        margin:
            0 auto 20px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        border-radius:
            23px;

        background:
            var(--wh-orange-light);

        color:
            var(--wh-orange);
    }


    .requests-empty h3 {
        margin:
            0;

        color:
            var(--wh-dark);

        font-size:
            24px;

        font-weight:
            900;
    }


    .requests-empty p {
        margin:
            9px auto 0;

        color:
            var(--wh-muted);

        font-size:
            14px;
    }


    /* =========================================================
       REQUEST CARD
       ========================================================= */

    .request-list {
        display:
            grid;

        gap:
            22px;
    }


    .request-card {
        position:
            relative;

        padding:
            25px;

        background:
            #fff;

        border:
            1px solid
            var(--wh-border);

        border-radius:
            23px;

        box-shadow:
            var(--wh-shadow);

        transition:
            .3s ease;

        overflow:
            hidden;
    }


    .request-card::before {
        content:
            "";

        position:
            absolute;

        top:
            0;

        left:
            10%;

        right:
            10%;

        height:
            3px;

        background:
            linear-gradient(
                90deg,
                transparent,
                var(--wh-orange),
                transparent
            );

        transform:
            scaleX(0);

        transition:
            .3s ease;
    }


    .request-card:hover {
        transform:
            translateY(-5px);

        border-color:
            rgba(255,90,31,.24);

        box-shadow:
            var(--wh-shadow-hover);
    }


    .request-card:hover::before {
        transform:
            scaleX(1);
    }


    /* =========================================================
       REQUEST HEADER
       ========================================================= */

    .request-header {
        display:
            flex;

        align-items:
            flex-start;

        justify-content:
            space-between;

        gap:
            20px;
    }


    .request-header-main {
        min-width:
            0;
    }


    .request-meta {
        display:
            flex;

        align-items:
            center;

        flex-wrap:
            wrap;

        gap:
            8px;

        margin-bottom:
            9px;
    }


    .request-meta span {
        display:
            inline-flex;

        align-items:
            center;

        padding:
            6px 9px;

        border-radius:
            999px;

        background:
            #f8fafc;

        color:
            var(--wh-muted);

        font-size:
            10px;

        font-weight:
            800;

        border:
            1px solid
            #eef2f7;
    }


    .request-meta span:first-child {
        background:
            var(--wh-orange-light);

        color:
            var(--wh-orange-dark);

        border-color:
            rgba(255,90,31,.10);
    }


    .request-title {
        margin:
            0;

        color:
            var(--wh-dark);

        font-size:
            22px;

        line-height:
            1.3;

        font-weight:
            900;

        letter-spacing:
            -.5px;
    }


    .request-description {
        margin:
            9px 0 0;

        color:
            var(--wh-muted);

        font-size:
            13px;

        line-height:
            1.7;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .request-status {
        flex:
            0 0 auto;

        display:
            inline-flex;

        align-items:
            center;

        gap:
            7px;

        padding:
            8px 12px;

        border-radius:
            999px;

        background:
            var(--wh-orange-light);

        color:
            var(--wh-orange-dark);

        border:
            1px solid
            rgba(255,90,31,.13);

        font-size:
            10px;

        font-weight:
            900;

        text-transform:
            uppercase;

        letter-spacing:
            .04em;
    }


    .request-status::before {
        content:
            "";

        width:
            7px;

        height:
            7px;

        border-radius:
            50%;

        background:
            currentColor;
    }


    /* =========================================================
       DETAIL STRIP
       ========================================================= */

    .request-details {
        display:
            grid;

        grid-template-columns:
            repeat(
                4,
                minmax(0,1fr)
            );

        gap:
            10px;

        margin-top:
            22px;

        padding:
            15px;

        border:
            1px solid
            #f1f5f9;

        border-radius:
            15px;

        background:
            #fafafa;
    }


    .request-detail {
        display:
            flex;

        align-items:
            center;

        gap:
            9px;

        min-width:
            0;

        color:
            var(--wh-muted);

        font-size:
            11px;

        font-weight:
            800;
    }


    .request-detail-icon {
        width:
            32px;

        height:
            32px;

        flex:
            0 0 32px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        border-radius:
            10px;

        background:
            var(--wh-orange-light);

        color:
            var(--wh-orange);
    }


    .request-detail-text {
        min-width:
            0;

        overflow:
            hidden;

        text-overflow:
            ellipsis;

        white-space:
            nowrap;
    }


    /* =========================================================
       REQUEST ACTIONS
       ========================================================= */

    .request-actions {
        display:
            flex;

        align-items:
            center;

        justify-content:
            flex-end;

        gap:
            10px;

        margin-top:
            17px;
    }


    .request-cancel {
        border:
            0;

        background:
            transparent;

        color:
            var(--wh-red);

        font-size:
            11px;

        font-weight:
            900;

        cursor:
            pointer;

        padding:
            8px;

        transition:
            .2s ease;
    }


    .request-cancel:hover {
        color:
            #991b1b;

        text-decoration:
            underline;
    }


    /* =========================================================
       OFFERS
       ========================================================= */

    .offers-section {
        margin-top:
            24px;

        padding-top:
            22px;

        border-top:
            1px solid
            #eef2f7;
    }


    .offers-heading {
        display:
            flex;

        align-items:
            center;

        gap:
            9px;

        margin-bottom:
            14px;
    }


    .offers-heading-icon {
        width:
            34px;

        height:
            34px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        border-radius:
            10px;

        background:
            var(--wh-orange-light);

        color:
            var(--wh-orange);
    }


    .offers-heading h4 {
        margin:
            0;

        color:
            var(--wh-dark);

        font-size:
            15px;

        font-weight:
            900;
    }


    .offer-list {
        display:
            grid;

        gap:
            11px;
    }


    .offer-row {
        display:
            grid;

        grid-template-columns:
            minmax(0,1fr)
            auto
            auto;

        align-items:
            center;

        gap:
            18px;

        padding:
            16px;

        background:
            #fafafa;

        border:
            1px solid
            #eef2f7;

        border-radius:
            15px;

        transition:
            .25s ease;
    }


    .offer-row:hover {
        background:
            var(--wh-orange-soft);

        border-color:
            rgba(255,90,31,.15);
    }


    .offer-provider {
        min-width:
            0;
    }


    .offer-provider strong {
        display:
            block;

        color:
            var(--wh-dark);

        font-size:
            13px;

        font-weight:
            900;
    }


    .offer-provider-info {
        display:
            block;

        margin-top:
            4px;

        color:
            var(--wh-light-text);

        font-size:
            10px;

        font-weight:
            700;
    }


    .offer-message {
        margin:
            8px 0 0;

        color:
            var(--wh-muted);

        font-size:
            12px;

        line-height:
            1.55;
    }


    .offer-price {
        color:
            var(--wh-dark);

        font-size:
            19px;

        font-weight:
            900;

        white-space:
            nowrap;
    }


    .offer-status {
        display:
            inline-flex;

        align-items:
            center;

        justify-content:
            center;

        padding:
            7px 10px;

        border-radius:
            999px;

        background:
            #f1f5f9;

        color:
            #475569;

        font-size:
            9px;

        font-weight:
            900;

        text-transform:
            uppercase;

        letter-spacing:
            .04em;

        white-space:
            nowrap;
    }


    .offer-actions {
        grid-column:
            1 / -1;

        display:
            flex;

        align-items:
            center;

        gap:
            8px;

        padding-top:
            3px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 900px) {

        .request-hero-button {
            position:
                static;

            margin-top:
                28px;
        }


        .request-hero-inner {
            padding:
                60px 0;
        }


        .request-details {
            grid-template-columns:
                repeat(
                    2,
                    minmax(0,1fr)
                );
        }


        .offer-row {
            grid-template-columns:
                minmax(0,1fr)
                auto;
        }


        .offer-status {
            grid-column:
                2;
        }


        .offer-actions {
            grid-column:
                1 / -1;
        }
    }


    @@media (max-width: 700px) {

        .request-shell {
            width:
                calc(100% - 28px);
        }


        .request-hero {
            min-height:
                440px;

            border-radius:
                0 0 24px 24px;
        }


        .request-hero-inner {
            width:
                calc(100% - 28px);

            padding:
                55px 0;
        }


        .request-hero h1 {
            font-size:
                40px;

            letter-spacing:
                -1.7px;
        }


        .request-hero p {
            font-size:
                14px;
        }


        .request-form {
            grid-template-columns:
                1fr;
        }


        .request-field.full,
        .request-form-submit {
            grid-column:
                auto;
        }


        .request-panel {
            padding:
                20px;

            border-radius:
                20px;
        }


        .request-panel-heading h2 {
            font-size:
                23px;
        }


        .requests-section {
            margin-top:
                45px;
        }


        .requests-heading {
            align-items:
                flex-start;

            flex-direction:
                column;
        }


        .requests-heading h2 {
            font-size:
                27px;
        }


        .request-header {
            flex-direction:
                column;
        }


        .request-status {
            align-self:
                flex-start;
        }


        .request-details {
            grid-template-columns:
                1fr;

            padding:
                12px;
        }


        .request-card {
            padding:
                20px;

            border-radius:
                20px;
        }


        .request-actions {
            justify-content:
                flex-start;
        }


        .offer-row {
            grid-template-columns:
                1fr;
        }


        .offer-status {
            grid-column:
                auto;

            justify-self:
                flex-start;
        }


        .offer-actions {
            grid-column:
                auto;
        }


        .offer-price {
            font-size:
                18px;
        }
    }


    @@media (max-width: 420px) {

        .request-hero h1 {
            font-size:
                36px;
        }


        .request-button {
            width:
                100%;
        }


        .offer-actions {
            flex-direction:
                column;

            align-items:
                stretch;
        }
    }
</style>

<div class="request-page">


<!-- =====================================================
     HERO
     ====================================================== -->

<section class="request-hero">

    <div class="request-hero-grid"></div>

    <div class="request-hero-inner">

        <div class="request-hero-content">

            <div class="request-eyebrow">

                <span class="request-eyebrow-dot"></span>

                Customer Workspace

            </div>


            <h1>
                Find the right
                <span>professional.</span>
            </h1>


            <p>
                Post what you need, compare provider offers,
                and choose the professional who is right
                for your job.
            </p>


            <a asp-controller="Services"
               asp-action="Index"
               class="request-hero-button">

                <svg class="wh-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.2 2.2-2.7-.6-.6-2.7z"></path>

                    <path d="m14 10 4 4"></path>

                </svg>

                Browse Providers

                <svg class="wh-icon wh-icon-sm"
                     viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M5 12h14"></path>
                    <path d="m13 6 6 6-6 6"></path>

                </svg>

            </a>

        </div>

    </div>

</section>


<div class="request-shell">


    <!-- =================================================
         ALERTS
         ================================================== -->

    @if (TempData["RequestSuccess"] is string success)
    {
        <div class="request-alert success">

            <svg class="wh-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">

                <circle cx="12" cy="12" r="9"></circle>
                <path d="m8 12 3 3 5-6"></path>

            </svg>

            @success

        </div>
    }


    @if (TempData["RequestError"] is string error)
    {
        <div class="request-alert danger">

            <svg class="wh-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">

                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 8v4"></path>
                <path d="M12 16h.01"></path>

            </svg>

            @error

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="request-alert danger">

            <svg class="wh-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">

                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 8v4"></path>
                <path d="M12 16h.01"></path>

            </svg>

            @Model.ErrorMessage

        </div>
    }


    <!-- =================================================
         POST REQUEST
         ================================================== -->

    <section class="request-panel">

        <div class="request-panel-heading">

            <div>

                <div class="request-kicker">
                    Post a request
                </div>

                <h2>
                    What do you need help with?
                </h2>

            </div>

        </div>


        <form asp-action="Create"
              method="post"
              class="request-form">

            @Html.AntiForgeryToken()


            <!-- CATEGORY -->

            <div class="request-field">

                <label>
                    Service category
                </label>

                <select name="ServiceCategoryId"
                        class="request-select"
                        required>

                    <option value="">
                        Choose category
                    </option>

                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.ServiceCategoryId">
                            @c.CategoryName
                        </option>
                    }

                </select>

            </div>


            <!-- TITLE -->

            <div class="request-field">

                <label>
                    Request title
                </label>

                <input name="Title"
                       maxlength="150"
                       class="request-input"
                       placeholder="e.g. Fix leaking kitchen tap"
                       required />

            </div>


            <!-- LOCATION -->

            <div class="request-field">

                <label>
                    Location
                </label>

                <input name="Location"
                       maxlength="150"
                       class="request-input"
                       placeholder="Suburb or remote" />

            </div>


            <!-- BUDGET -->

            <div class="request-field">

                <label>
                    Budget
                </label>

                <input name="Budget"
                       type="number"
                       min="0"
                       step="0.01"
                       class="request-input"
                       placeholder="Optional" />

            </div>


            <!-- DATE -->

            <div class="request-field">

                <label>
                    Preferred date
                </label>

                <input name="PreferredDate"
                       type="datetime-local"
                       class="request-input" />

            </div>


            <!-- DESCRIPTION -->

            <div class="request-field full">

                <label>
                    Describe the work
                </label>

                <textarea name="Description"
                          rows="4"
                          maxlength="2000"
                          class="request-textarea"
                          placeholder="Explain what you need, what is broken, or what type of professional you are looking for..."
                          required></textarea>

            </div>


            <!-- SUBMIT -->

            <div class="request-form-submit">

                <button class="request-button primary"
                        type="submit">

                    <svg class="wh-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>

                    </svg>

                    Post Service Request

                </button>

            </div>

        </form>

    </section>


    <!-- =================================================
         REQUESTS
         ================================================== -->

    <section class="requests-section">


        <div class="requests-heading">

            <div>

                <div class="request-kicker">
                    Your requests
                </div>

                <h2>
                    Track quotes and jobs
                </h2>

            </div>


            <span class="request-count">

                <svg class="wh-icon wh-icon-sm"
                     viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M8 6h13"></path>
                    <path d="M8 12h13"></path>
                    <path d="M8 18h13"></path>

                    <path d="M3 6h.01"></path>
                    <path d="M3 12h.01"></path>
                    <path d="M3 18h.01"></path>

                </svg>

                @Model.Requests.Count

            </span>

        </div>


        @if (Model.Requests.Count == 0)
        {
            <div class="requests-empty">

                <div class="requests-empty-icon">

                    <svg class="wh-icon wh-icon-xl"
                         viewBox="0 0 24 24"
                         aria-hidden="true">

                        <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.2 2.2-2.7-.6-.6-2.7z"></path>

                        <path d="m14 10 4 4"></path>

                    </svg>

                </div>


                <h3>
                    No service requests yet
                </h3>


                <p>
                    Post your first request and let
                    professionals send you their offers.
                </p>

            </div>
        }
        else
        {

            <div class="request-list">

                @foreach (var request in Model.Requests)
                {
                    var offers =
                        Model.OffersByRequest.TryGetValue(
                            request.ServiceRequestId,
                            out var requestOffers
                        )
                        ? requestOffers
                        : new List<Workhub_Web.Models.ServiceRequestOfferViewModel>();


                    <article class="request-card">


                        <!-- REQUEST HEADER -->

                        <div class="request-header">

                            <div class="request-header-main">

                                <div class="request-meta">

                                    <span>
                                        @request.Category
                                    </span>

                                    <span>

                                        <svg class="wh-icon wh-icon-sm"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <rect x="3"
                                                  y="4"
                                                  width="18"
                                                  height="17"
                                                  rx="2"></rect>

                                            <path d="M16 2v4"></path>
                                            <path d="M8 2v4"></path>
                                            <path d="M3 10h18"></path>

                                        </svg>

                                        @request.CreatedAt
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")

                                    </span>

                                </div>


                                <h3 class="request-title">
                                    @request.Title
                                </h3>


                                <p class="request-description">
                                    @request.Description
                                </p>

                            </div>


                            <span class="request-status">
                                @request.Status
                            </span>

                        </div>


                        <!-- DETAILS -->

                        <div class="request-details">


                            <!-- LOCATION -->

                            <div class="request-detail">

                                <div class="request-detail-icon">

                                    <svg class="wh-icon wh-icon-sm"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>

                                        <circle cx="12"
                                                cy="10"
                                                r="2.5"></circle>

                                    </svg>

                                </div>

                                <span class="request-detail-text">
                                    @(request.Location ?? "Flexible")
                                </span>

                            </div>


                            <!-- BUDGET -->

                            <div class="request-detail">

                                <div class="request-detail-icon">

                                    <svg class="wh-icon wh-icon-sm"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <circle cx="12"
                                                cy="12"
                                                r="9"></circle>

                                        <path d="M12 7v10"></path>

                                        <path d="M15 9.5c-.6-1-1.5-1.5-3-1.5-1.6 0-3 .8-3 2s1.1 1.8 3 2c1.9.2 3 .9 3 2.2s-1.2 2.3-3 2.3c-1.5 0-2.6-.5-3.2-1.5"></path>

                                    </svg>

                                </div>

                                <span class="request-detail-text">

                                    @(request.Budget.HasValue
                                        ? "$" + request.Budget.Value.ToString("0.00")
                                        : "Open budget")

                                </span>

                            </div>


                            <!-- DATE -->

                            <div class="request-detail">

                                <div class="request-detail-icon">

                                    <svg class="wh-icon wh-icon-sm"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <rect x="3"
                                              y="4"
                                              width="18"
                                              height="17"
                                              rx="2"></rect>

                                        <path d="M16 2v4"></path>
                                        <path d="M8 2v4"></path>
                                        <path d="M3 10h18"></path>

                                    </svg>

                                </div>

                                <span class="request-detail-text">

                                    @(request.PreferredDate?.ToString("dd MMM yyyy")
                                        ?? "Flexible")

                                </span>

                            </div>


                            <!-- OFFERS -->

                            <div class="request-detail">

                                <div class="request-detail-icon">

                                    <svg class="wh-icon wh-icon-sm"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7A8.38 8.38 0 0 1 4 11.5a8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"></path>

                                    </svg>

                                </div>

                                <span class="request-detail-text">
                                    @request.OfferCount offer(s)
                                </span>

                            </div>

                        </div>


                        <!-- REQUEST ACTION -->

                        @if (request.Status == "Open")
                        {
                            <div class="request-actions">

                                <form asp-action="Cancel"
                                      asp-route-id="@request.ServiceRequestId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button class="request-cancel"
                                            type="submit">

                                        <svg class="wh-icon wh-icon-sm"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M3 6h18"></path>

                                            <path d="M8 6V4h8v2"></path>

                                            <path d="m19 6-1 14H6L5 6"></path>

                                        </svg>

                                        Cancel request

                                    </button>

                                </form>

                            </div>
                        }


                        <!-- COMPLETE -->

                        @if (request.Status == "Assigned")
                        {
                            <div class="request-actions">

                                <form asp-action="Complete"
                                      asp-route-id="@request.ServiceRequestId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button class="request-button primary small"
                                            type="submit">

                                        <svg class="wh-icon wh-icon-sm"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9"></circle>

                                            <path d="m8 12 3 3 5-6"></path>

                                        </svg>

                                        Mark Work Completed

                                    </button>

                                </form>

                            </div>
                        }


                        <!-- =================================================
                             OFFERS
                             ================================================== -->

                        @if (offers.Count > 0)
                        {
                            <div class="offers-section">


                                <div class="offers-heading">

                                    <div class="offers-heading-icon">

                                        <svg class="wh-icon"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"></path>

                                        </svg>

                                    </div>

                                    <h4>
                                        Provider Offers
                                    </h4>

                                </div>


                                <div class="offer-list">

                                    @foreach (var offer in offers)
                                    {
                                        <div class="offer-row">


                                                <!-- PROVIDER -->

                                                <div class="offer-provider">

                                                    <strong>
                                                        @(offer.Provider.DisplayName ?? "Service provider")
                                                    </strong>

                                                    <span class="offer-provider-info">

                                                        @(offer.Provider.YearsOfExperience > 0
                                                            ? offer.Provider.YearsOfExperience + " yr experience"
                                                            : "Service provider")

                                                        ·

                                                        @(offer.Provider.Location ?? "Flexible")

                                                        ·

                                                        @offer.Provider.VerificationStatus

                                                    </span>

                                                    <p class="offer-message">
                                                        @offer.Message
                                                    </p>

                                                </div>


                                            <!-- PRICE -->

                                            <div class="offer-price">

                                                $@offer.OfferedPrice.ToString("0.00")

                                            </div>


                                            <!-- STATUS -->

                                            <span class="offer-status">
                                                @offer.Status
                                            </span>


                                            <!-- ACTIONS -->

                                            @if (
                                                request.Status == "Open"
                                                &&
                                                offer.Status == "Pending"
                                            )
                                            {
                                                <div class="offer-actions">


                                                    <!-- ACCEPT -->

                                                    <form asp-action="AcceptOffer"
                                                          asp-route-offerId="@offer.ServiceOfferId"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <button class="request-button primary small"
                                                                type="submit">

                                                            <svg class="wh-icon wh-icon-sm"
                                                                 viewBox="0 0 24 24"
                                                                 aria-hidden="true">

                                                                <path d="m5 12 4 4L19 6"></path>

                                                            </svg>

                                                            Accept

                                                        </button>

                                                    </form>


                                                    <!-- REJECT -->

                                                    <form asp-action="RejectOffer"
                                                          asp-route-offerId="@offer.ServiceOfferId"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <button class="request-button ghost small"
                                                                type="submit">

                                                            <svg class="wh-icon wh-icon-sm"
                                                                 viewBox="0 0 24 24"
                                                                 aria-hidden="true">

                                                                <path d="M18 6 6 18"></path>
                                                                <path d="m6 6 12 12"></path>

                                                            </svg>

                                                            Reject

                                                        </button>

                                                    </form>

                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </article>
                }

            </div>

        }

    </section>

</div>


</div>
