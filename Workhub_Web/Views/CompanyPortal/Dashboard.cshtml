@model Workhub_Web.Models.CompanyDashboardViewModel

@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "Company Dashboard";

    var profileImageUrl =
        ViewBag.CompanyProfileImageUrl
        ?.ToString()
        ?? "";

    var companyInitial =
        Model.CompanyProfileExists
        &&
        !string.IsNullOrWhiteSpace(
            Model.Company.CompanyName)
            ? Model.Company.CompanyName
                .Substring(0, 1)
                .ToUpperInvariant()
            : "C";


    // =============================================
    // REAL DASHBOARD COUNTS
    // =============================================

    var activeJobPosts =
        ViewBag.ActiveJobPosts is int activeCount
            ? activeCount
            : 0;


    var jobApplications =
        ViewBag.JobApplications is int applicationCount
            ? applicationCount
            : 0;
}


<style>

    :root {
        --dash-orange: #FD5000;
        --dash-orange-dark: #D94300;
        --dash-orange-light: #FF7A00;
        --dash-orange-soft: #FFF2EB;
        --dash-dark: #0F172A;
        --dash-dark-2: #1E293B;
        --dash-text: #64748B;
        --dash-text-dark: #334155;
        --dash-border: #E2E8F0;
        --dash-bg: #F8FAFC;
        --dash-green: #16A34A;
        --dash-green-soft: #F0FDF4;
        --dash-blue: #2563EB;
        --dash-blue-soft: #EFF6FF;
        --dash-purple: #7C3AED;
        --dash-purple-soft: #F5F3FF;
        --dash-red: #DC2626;
        --dash-red-dark: #B91C1C;
        --dash-red-soft: #FEF2F2;
        --dash-shadow: 0 12px 35px rgba(15, 23, 42, .07);
    }


    * {
        box-sizing: border-box;
    }


    /* =========================================
           GLOBAL SVG
        ========================================= */

    .dash-icon-svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }


    /* =========================================
           PAGE
        ========================================= */

    .company-dashboard-page {
        min-height: calc(100vh - 78px);
        padding: 48px 26px 95px;
        background: radial-gradient( circle at top right, rgba(253,80,0,.07), transparent 31% ), radial-gradient( circle at bottom left, rgba(253,80,0,.035), transparent 28% ), var(--dash-bg);
    }


    .company-dashboard-container {
        width: 100%;
        max-width: 1380px;
        margin: 0 auto;
    }


    /* =========================================
           PAGE HEADER
        ========================================= */

    .dashboard-page-header {
        margin-bottom: 32px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }


    .dashboard-eyebrow {
        margin-bottom: 10px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--dash-orange);
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }


        .dashboard-eyebrow svg {
            width: 17px;
            height: 17px;
        }


    .dashboard-page-header h1 {
        margin: 0 0 9px;
        color: var(--dash-dark);
        font-size: 42px;
        font-weight: 950;
        letter-spacing: -1px;
    }


    .dashboard-page-header p {
        margin: 0;
        color: var(--dash-text);
        font-size: 16px;
        line-height: 1.65;
    }


    /* =========================================
           MESSAGES
        ========================================= */

    .dashboard-message {
        margin-bottom: 22px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
    }


    .dashboard-message-success {
        border: 1px solid #BBF7D0;
        background: var(--dash-green-soft);
        color: #15803D;
    }


    .dashboard-message-error {
        border: 1px solid #FECACA;
        background: var(--dash-red-soft);
        color: var(--dash-red-dark);
    }


    /* =========================================
           COMPANY HERO
        ========================================= */

    .company-hero {
        position: relative;
        margin-bottom: 25px;
        overflow: hidden;
        padding: 35px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        border-radius: 23px;
        background: radial-gradient( circle at 88% 15%, rgba(253,80,0,.44), transparent 31% ), linear-gradient( 135deg, #0B1120, #172033 60%, #431407 );
        color: #FFFFFF;
        box-shadow: 0 20px 48px rgba(15,23,42,.18);
    }


        .company-hero::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 21%;
            top: -110px;
            border-radius: 50%;
            background: rgba(253,80,0,.10);
        }


        .company-hero::after {
            content: "";
            position: absolute;
            right: -85px;
            bottom: -120px;
            width: 270px;
            height: 270px;
            border-radius: 50%;
            border: 48px solid rgba(255,255,255,.025);
        }


    .company-hero-left {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 20px;
    }


    .hero-logo-shell {
        position: relative;
        width: 90px;
        height: 90px;
        flex-shrink: 0;
    }


    .hero-logo-fallback {
        width: 90px;
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 21px;
        background: linear-gradient( 135deg, var(--dash-orange), var(--dash-orange-light) );
        color: #FFFFFF;
        font-size: 34px;
        font-weight: 950;
        box-shadow: 0 12px 28px rgba(253,80,0,.31);
    }


    .hero-logo-image {
        position: absolute;
        inset: 0;
        width: 90px;
        height: 90px;
        display: block;
        border: 3px solid rgba(255,255,255,.30);
        border-radius: 21px;
        background: #FFFFFF;
        object-fit: cover;
    }


    .company-hero h2 {
        margin: 0 0 8px;
        color: #FFFFFF;
        font-size: 30px;
        font-weight: 950;
    }


    .company-hero p {
        margin: 0;
        color: #CBD5E1;
        font-size: 15px;
        line-height: 1.5;
    }


    .approved-badge {
        position: relative;
        z-index: 2;
        padding: 11px 15px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(134,239,172,.20);
        border-radius: 30px;
        background: rgba(22,163,74,.17);
        color: #BBF7D0;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }


    .approved-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22C55E;
        box-shadow: 0 0 0 4px rgba(34,197,94,.12);
    }


    /* =========================================
           STATS
        ========================================= */

    .company-stat-grid {
        margin-bottom: 25px;
        display: grid;
        grid-template-columns: repeat( 3, minmax(0,1fr) );
        gap: 18px;
    }


    .company-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 145px;
        padding: 23px;
        display: flex;
        align-items: center;
        gap: 17px;
        border: 1px solid var(--dash-border);
        border-radius: 16px;
        background: #FFFFFF;
        box-shadow: var(--dash-shadow);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }


        .company-stat-card:hover {
            transform: translateY(-4px);
            border-color: #FED7C5;
            box-shadow: 0 16px 34px rgba(15,23,42,.10);
        }


        .company-stat-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient( 180deg, var(--dash-orange), var(--dash-orange-light) );
        }


    .company-stat-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: var(--dash-orange-soft);
        color: var(--dash-orange-dark);
    }


        .company-stat-icon svg {
            width: 25px;
            height: 25px;
        }


    .company-stat-content {
        min-width: 0;
    }


    .company-stat-card strong {
        display: block;
        margin-bottom: 6px;
        color: var(--dash-dark);
        font-size: 31px;
        font-weight: 950;
        line-height: 1.1;
        overflow-wrap: anywhere;
    }


    .company-stat-card span {
        color: var(--dash-text);
        font-size: 13px;
        font-weight: 750;
    }


    /* =========================================
           MAIN GRID
        ========================================= */

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: minmax(0,1.35fr) minmax(350px,.65fr);
        gap: 24px;
        align-items: start;
    }


    /* =========================================
           DASHBOARD CARD
        ========================================= */

    .dashboard-card {
        margin-bottom: 24px;
        padding: 30px;
        border: 1px solid var(--dash-border);
        border-radius: 18px;
        background: #FFFFFF;
        box-shadow: var(--dash-shadow);
    }


    .dashboard-card-heading {
        margin-bottom: 25px;
        padding-bottom: 18px;
        display: flex;
        align-items: flex-start;
        gap: 13px;
        border-bottom: 1px solid #F1F5F9;
    }


    .dashboard-heading-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--dash-orange-soft);
        color: var(--dash-orange-dark);
    }


        .dashboard-heading-icon svg {
            width: 22px;
            height: 22px;
        }


    .dashboard-card-heading h3 {
        margin: 0 0 6px;
        color: var(--dash-dark);
        font-size: 21px;
        font-weight: 950;
    }


    .dashboard-card-heading p {
        margin: 0;
        color: var(--dash-text);
        font-size: 13px;
        line-height: 1.6;
    }


    /* =========================================
           FORM
        ========================================= */

    .company-form-grid {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0,1fr) );
        gap: 18px;
    }


    .company-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }


        .company-field.full {
            grid-column: 1 / -1;
        }


        .company-field label {
            color: var(--dash-text-dark);
            font-size: 13px;
            font-weight: 850;
        }


    .company-input,
    .company-textarea,
    .company-password-input {
        width: 100%;
        padding: 14px 15px;
        border: 1px solid #CBD5E1;
        border-radius: 10px;
        background: #FFFFFF;
        color: var(--dash-dark);
        font-size: 14px;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }


        .company-input:hover,
        .company-textarea:hover,
        .company-password-input:hover {
            border-color: #94A3B8;
        }


        .company-input:focus,
        .company-textarea:focus,
        .company-password-input:focus {
            border-color: var(--dash-orange);
            box-shadow: 0 0 0 4px rgba(253,80,0,.09);
        }


        .company-input[readonly] {
            background: #F8FAFC;
            color: #64748B;
            cursor: not-allowed;
        }


    .company-textarea {
        min-height: 145px;
        resize: vertical;
        line-height: 1.65;
    }


    /* =========================================
           PRIMARY BUTTON
        ========================================= */

    .primary-button {
        margin-top: 20px;
        min-height: 48px;
        padding: 0 19px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( 135deg, var(--dash-orange), var(--dash-orange-light) );
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 9px 20px rgba(253,80,0,.22);
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .primary-button svg {
            width: 18px;
            height: 18px;
        }


        .primary-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 13px 28px rgba(253,80,0,.30);
        }


        .primary-button:disabled {
            opacity: .65;
            cursor: not-allowed;
            transform: none;
        }


    /* =========================================
           PROFILE PICTURE
        ========================================= */

    .profile-picture-area {
        display: grid;
        grid-template-columns: 125px minmax(0,1fr);
        gap: 24px;
        align-items: center;
    }


    .profile-preview {
        position: relative;
        width: 112px;
        height: 112px;
    }


    .profile-preview-fallback {
        width: 112px;
        height: 112px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 26px;
        background: linear-gradient( 135deg, var(--dash-dark), #334155 );
        color: #FFFFFF;
        font-size: 37px;
        font-weight: 950;
        box-shadow: 0 12px 25px rgba(15,23,42,.13);
    }


    .profile-preview-image {
        position: absolute;
        inset: 0;
        width: 112px;
        height: 112px;
        border: 3px solid #FFE2D4;
        border-radius: 26px;
        background: #FFFFFF;
        object-fit: cover;
    }


    .profile-upload-content h4 {
        margin: 0 0 7px;
        color: var(--dash-dark);
        font-size: 17px;
        font-weight: 900;
    }


    .profile-upload-content p {
        margin: 0 0 15px;
        color: var(--dash-text);
        font-size: 13px;
        line-height: 1.6;
    }


    .profile-file-input {
        width: 100%;
        margin-bottom: 12px;
        padding: 11px;
        border: 1px dashed #CBD5E1;
        border-radius: 10px;
        background: #F8FAFC;
        color: #475569;
        font-size: 12px;
    }


    .picture-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }


    .picture-upload-button,
    .picture-remove-button {
        min-height: 42px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
    }


    .picture-upload-button {
        border: none;
        background: var(--dash-orange);
        color: #FFFFFF;
        box-shadow: 0 7px 16px rgba(253,80,0,.18);
    }


        .picture-upload-button:hover {
            background: var(--dash-orange-dark);
        }


    .picture-remove-button {
        border: 1px solid #FECACA;
        background: #FFFFFF;
        color: var(--dash-red);
    }


        .picture-remove-button:hover {
            border-color: var(--dash-red);
            background: var(--dash-red-soft);
        }


    /* =========================================
           RECRUITMENT
        ========================================= */

    .recruitment-grid {
        display: grid;
        gap: 13px;
    }


    .recruitment-card {
        position: relative;
        overflow: hidden;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        border: 1px solid #E2E8F0;
        border-radius: 13px;
        background: #F8FAFC;
        text-decoration: none;
        transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
    }


        .recruitment-card:hover {
            transform: translateY(-3px);
            border-color: #FDBA95;
            background: #FFF9F5;
            box-shadow: 0 10px 22px rgba(15,23,42,.06);
        }


    .recruitment-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--dash-orange-soft);
        color: var(--dash-orange-dark);
    }


        .recruitment-icon svg {
            width: 23px;
            height: 23px;
        }


    .recruitment-card strong {
        display: block;
        margin-bottom: 4px;
        color: var(--dash-dark);
        font-size: 15px;
        font-weight: 900;
    }


    .recruitment-card span {
        color: var(--dash-text);
        font-size: 12px;
        line-height: 1.5;
    }


    .recruitment-arrow {
        margin-left: auto;
        color: var(--dash-orange);
    }


        .recruitment-arrow svg {
            width: 18px;
            height: 18px;
        }


    /* =========================================
           ACCOUNT SUMMARY
        ========================================= */

    .account-summary {
        display: grid;
        gap: 11px;
    }


    .account-summary-row {
        padding: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid transparent;
        border-radius: 11px;
        background: #F8FAFC;
        transition: .2s ease;
    }


        .account-summary-row:hover {
            border-color: #FED7C5;
            background: #FFF9F5;
        }


    .account-summary-icon {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--dash-orange-dark);
        box-shadow: 0 4px 12px rgba(15,23,42,.05);
    }


        .account-summary-icon svg {
            width: 19px;
            height: 19px;
        }


    .account-summary-content {
        min-width: 0;
    }


    .account-summary-row span {
        display: block;
        margin-bottom: 4px;
        color: #94A3B8;
        font-size: 10px;
        font-weight: 850;
        letter-spacing: .4px;
        text-transform: uppercase;
    }


    .account-summary-row strong {
        display: block;
        color: var(--dash-text-dark);
        font-size: 13px;
        font-weight: 850;
        overflow-wrap: anywhere;
    }


    /* =========================================
           PASSWORD
        ========================================= */

    .password-grid {
        display: grid;
        gap: 16px;
    }


    .password-hint {
        margin-top: 11px;
        padding: 11px 13px;
        border-radius: 9px;
        background: #F8FAFC;
        color: #64748B;
        font-size: 11px;
        line-height: 1.55;
    }


    /* =========================================
           DANGER ZONE
        ========================================= */

    .danger-card {
        border-color: #FECACA;
        background: linear-gradient( 180deg, #FFFFFF, #FFF9F9 );
    }


        .danger-card
        .dashboard-card-heading {
            border-bottom-color: #FEE2E2;
        }


        .danger-card
        .dashboard-heading-icon {
            background: var(--dash-red-soft);
            color: var(--dash-red);
        }


        .danger-card
        .dashboard-card-heading h3 {
            color: var(--dash-red-dark);
        }


    .danger-warning {
        margin-bottom: 18px;
        padding: 15px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border: 1px solid #FECACA;
        border-radius: 10px;
        background: var(--dash-red-soft);
        color: #991B1B;
        font-size: 12px;
        line-height: 1.65;
    }


        .danger-warning svg {
            width: 19px;
            height: 19px;
            flex-shrink: 0;
            margin-top: 1px;
        }


    .danger-field {
        margin-bottom: 14px;
    }


        .danger-field label {
            display: block;
            margin-bottom: 7px;
            color: #7F1D1D;
            font-size: 12px;
            font-weight: 850;
        }


    .danger-input {
        width: 100%;
        min-height: 45px;
        padding: 0 13px;
        border: 1px solid #FCA5A5;
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--dash-dark);
        font-size: 13px;
        outline: none;
    }


        .danger-input:focus {
            border-color: var(--dash-red);
            box-shadow: 0 0 0 4px rgba(220,38,38,.08);
        }


    .delete-account-button {
        width: 100%;
        min-height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 10px;
        background: linear-gradient( 135deg, #DC2626, #B91C1C );
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(220,38,38,.18);
    }


        .delete-account-button svg {
            width: 18px;
            height: 18px;
        }


        .delete-account-button:hover {
            background: #B91C1C;
        }


        .delete-account-button:disabled {
            opacity: .65;
            cursor: not-allowed;
        }


    /* =========================================
           EMPTY
        ========================================= */

    .profile-not-found {
        padding: 60px 30px;
        border: 1px solid var(--dash-border);
        border-radius: 18px;
        background: #FFFFFF;
        text-align: center;
        box-shadow: var(--dash-shadow);
    }


    .profile-not-found-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: var(--dash-orange-soft);
        color: var(--dash-orange-dark);
    }


        .profile-not-found-icon svg {
            width: 32px;
            height: 32px;
        }


    .profile-not-found h2 {
        margin: 0 0 9px;
        color: var(--dash-dark);
        font-size: 23px;
        font-weight: 900;
    }


    .profile-not-found p {
        margin: 0;
        color: var(--dash-text);
        font-size: 14px;
    }


    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media (max-width: 980px) {

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }


        .company-stat-grid {
            grid-template-columns: repeat( 3, minmax(0,1fr) );
        }
    }


    @@media (max-width: 720px) {

        .company-stat-grid {
            grid-template-columns: 1fr;
        }


        .company-form-grid {
            grid-template-columns: 1fr;
        }


        .company-field.full {
            grid-column: auto;
        }


        .company-hero {
            align-items: flex-start;
            flex-direction: column;
        }


        .profile-picture-area {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 600px) {

        .company-dashboard-page {
            padding: 30px 14px 65px;
        }


        .dashboard-page-header h1 {
            font-size: 33px;
        }


        .dashboard-page-header p {
            font-size: 14px;
        }


        .dashboard-card {
            padding: 22px;
        }


        .company-hero {
            padding: 27px;
        }


        .company-hero-left {
            align-items: flex-start;
            flex-direction: column;
        }


        .company-hero h2 {
            font-size: 25px;
        }


        .company-stat-card {
            min-height: 125px;
        }
    }

</style>


<section class="company-dashboard-page">


    <div class="company-dashboard-container">


        <!-- =========================================
             HEADER
        ========================================= -->

        <div class="dashboard-page-header">


            <div>


                <span class="dashboard-eyebrow">


                    <svg viewBox="0 0 24 24"
                         class="dash-icon-svg">

                        <path d="M3 21h18" />

                        <path d="M6 21V7l6-4 6 4v14" />

                        <path d="M9 10h6" />

                        <path d="M9 14h6" />

                    </svg>


                    WorkHub Company Portal

                </span>


                <h1>
                    Company Dashboard
                </h1>


                <p>

                    Manage your company profile,
                    recruitment tools and account
                    settings from one workspace.

                </p>


            </div>


        </div>


        <!-- =========================================
             MESSAGES
        ========================================= -->
        @if (
                    !string.IsNullOrWhiteSpace(
                        Model.SuccessMessage))
        {
            <div class="dashboard-message dashboard-message-success">


                <svg viewBox="0 0 24 24"
                     class="dash-icon-svg">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <path d="m8 12 3 3 5-6" />

                </svg>


                @Model.SuccessMessage

            </div>
        }


        @if (
            !string.IsNullOrWhiteSpace(
                Model.ErrorMessage))
        {
            <div class="dashboard-message dashboard-message-error">


                <svg viewBox="0 0 24 24"
                     class="dash-icon-svg">

                    <circle cx="12"
                            cy="12"
                            r="9" />

                    <path d="M12 8v5" />

                    <path d="M12 17h.01" />

                </svg>


                @Model.ErrorMessage

            </div>
        }


        @if (Model.CompanyProfileExists)
        {

            <!-- =====================================
                 HERO
            ====================================== -->

            <div class="company-hero">


                <div class="company-hero-left">


                    <div class="hero-logo-shell">


                        <div class="hero-logo-fallback">

                            @companyInitial

                        </div>


                        @if (
                            !string.IsNullOrWhiteSpace(
                                profileImageUrl))
                        {
                            <img src="@profileImageUrl"
                                 class="hero-logo-image"
                                 alt="Company profile picture"
                                 onerror="this.style.display='none';" />
                        }


                    </div>


                    <div>


                        <h2>

                            @Model.Company.CompanyName

                        </h2>


                        <p>

                            @(string.IsNullOrWhiteSpace(
                                Model.Company.Industry)
                                ? "Company / Organization"
                                : Model.Company.Industry)

                        </p>


                    </div>


                </div>


                <div class="approved-badge">


                    <span class="approved-dot">
                    </span>


                    @Model.Company.VerificationStatus

                </div>


            </div>


            <!-- =====================================
                 DASHBOARD STATS
            ====================================== -->

            <div class="company-stat-grid">


                <!-- ACTIVE JOBS -->

                <div class="company-stat-card">


                    <div class="company-stat-icon">


                        <svg viewBox="0 0 24 24"
                             class="dash-icon-svg">

                            <rect x="3"
                                  y="7"
                                  width="18"
                                  height="13"
                                  rx="2" />

                            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                            <path d="M3 12h18" />

                        </svg>


                    </div>


                    <div class="company-stat-content">


                        <strong>

                            @activeJobPosts

                        </strong>


                        <span>

                            Active Job Posts

                        </span>


                    </div>


                </div>


                <!-- APPLICATIONS -->

                <div class="company-stat-card">


                    <div class="company-stat-icon">


                        <svg viewBox="0 0 24 24"
                             class="dash-icon-svg">

                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                            <circle cx="9"
                                    cy="7"
                                    r="4" />

                            <path d="M19 8v6" />

                            <path d="M22 11h-6" />

                        </svg>


                    </div>


                    <div class="company-stat-content">


                        <strong>

                            @jobApplications

                        </strong>


                        <span>

                            Job Applications

                        </span>


                    </div>


                </div>


                <!-- STATUS -->

                <div class="company-stat-card">


                    <div class="company-stat-icon">


                        <svg viewBox="0 0 24 24"
                             class="dash-icon-svg">

                            <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z" />

                            <path d="m9 12 2 2 4-5" />

                        </svg>


                    </div>


                    <div class="company-stat-content">


                        <strong style="font-size:22px;">

                            @Model.Company.VerificationStatus

                        </strong>


                        <span>

                            Company Status

                        </span>


                    </div>


                </div>


            </div>


            <!-- =====================================
                 MAIN GRID
            ====================================== -->

            <div class="dashboard-main-grid">


                <!-- =================================
                     LEFT COLUMN
                ================================== -->

                <div>


                    <!-- =================================
                         COMPANY PROFILE
                    ================================== -->

                    <div class="dashboard-card"
                         id="company-profile">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M3 21h18" />

                                    <path d="M6 21V7l6-4 6 4v14" />

                                    <path d="M9 10h6" />

                                    <path d="M9 14h6" />

                                </svg>


                            </div>


                            <div>


                                <h3>

                                    Company Profile

                                </h3>


                                <p>

                                    Update the public information
                                    displayed for your organization.

                                </p>


                            </div>


                        </div>


                        <form asp-controller="CompanyPortal"
                              asp-action="SaveProfile"
                              method="post">


                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   asp-for="Company.CompanyProfileId" />


                            <div class="company-form-grid">


                                <div class="company-field full">


                                    <label>
                                        Company / Organization Name
                                    </label>


                                    <input name="CompanyName"
                                           value="@Model.Company.CompanyName"
                                           class="company-input"
                                           required />


                                </div>


                                <div class="company-field">


                                    <label>
                                        Industry
                                    </label>


                                    <input name="Industry"
                                           value="@Model.Company.Industry"
                                           class="company-input"
                                           placeholder="Example: Information Technology" />


                                </div>


                                <div class="company-field">


                                    <label>
                                        Website
                                    </label>


                                    <input name="Website"
                                           value="@Model.Company.Website"
                                           class="company-input"
                                           placeholder="https://example.com" />


                                </div>


                                <div class="company-field full">


                                    <label>
                                        Business Address
                                    </label>


                                    <input name="Address"
                                           value="@Model.Company.Address"
                                           class="company-input"
                                           placeholder="Company address" />


                                </div>


                                <div class="company-field full">


                                    <label>
                                        Company Description
                                    </label>


                                    <textarea name="Description"
                                              class="company-textarea"
                                              placeholder="Tell candidates about your organization...">@Model.Company.Description</textarea>


                                </div>


                            </div>


                            <button type="submit"
                                    class="primary-button">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M5 4h12l2 2v14H5z" />

                                    <path d="M8 4v6h8V4" />

                                    <path d="M8 16h8" />

                                </svg>


                                Save Company Profile

                            </button>


                        </form>


                    </div>


                    <!-- =================================
                         PROFILE PICTURE
                    ================================== -->

                    <div class="dashboard-card"
                         id="profile-picture">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="16"
                                          rx="2" />

                                    <circle cx="8.5"
                                            cy="10"
                                            r="2" />

                                    <path d="m21 15-5-5L5 21" />

                                </svg>


                            </div>


                            <div>


                                <h3>

                                    Profile Picture

                                </h3>


                                <p>

                                    Add a company logo or profile
                                    picture for your WorkHub account.

                                </p>


                            </div>


                        </div>


                        <div class="profile-picture-area">


                            <div class="profile-preview">


                                <div class="profile-preview-fallback">

                                    @companyInitial

                                </div>


                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        profileImageUrl))
                                {
                                    <img src="@profileImageUrl"
                                         id="profilePreviewImage"
                                         class="profile-preview-image"
                                         alt="Profile picture"
                                         onerror="this.style.display='none';" />
                                }


                            </div>


                            <div class="profile-upload-content">


                                <h4>

                                    Company Logo / Picture

                                </h4>


                                <p>

                                    JPG, JPEG, PNG or WEBP.
                                    Maximum file size is 5 MB.

                                </p>


                                <form asp-controller="CompanyPortal"
                                      asp-action="UploadProfileImage"
                                      method="post"
                                      enctype="multipart/form-data"
                                      id="profileImageForm">


                                    @Html.AntiForgeryToken()


                                    <input type="file"
                                           name="profileImage"
                                           id="profileImageInput"
                                           class="profile-file-input"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           required />


                                    <div class="picture-action-row">


                                        <button type="submit"
                                                class="picture-upload-button"
                                                id="profileUploadButton">


                                            <svg viewBox="0 0 24 24"
                                                 class="dash-icon-svg">

                                                <path d="M12 16V4" />

                                                <path d="m7 9 5-5 5 5" />

                                                <path d="M5 20h14" />

                                            </svg>


                                            Upload Picture

                                        </button>


                                    </div>


                                </form>


                                <form asp-controller="CompanyPortal"
                                      asp-action="RemoveProfileImage"
                                      method="post"
                                      id="removeProfileImageForm"
                                      style="margin-top:9px;">


                                    @Html.AntiForgeryToken()


                                    <button type="submit"
                                            class="picture-remove-button">


                                        <svg viewBox="0 0 24 24"
                                             class="dash-icon-svg">

                                            <path d="M4 7h16" />

                                            <path d="M9 7V4h6v3" />

                                            <path d="M7 7l1 13h8l1-13" />

                                        </svg>


                                        Remove Picture

                                    </button>


                                </form>


                            </div>


                        </div>


                    </div>


                    <!-- =================================
                         ACCOUNT MANAGER
                    ================================== -->

                    <div class="dashboard-card"
                         id="account-name">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <circle cx="12"
                                            cy="8"
                                            r="4" />

                                    <path d="M4 21a8 8 0 0 1 16 0" />

                                </svg>


                            </div>


                            <div>


                                <h3>
                                    Account Manager
                                </h3>


                                <p>

                                    Update the name associated
                                    with this company account.

                                </p>


                            </div>


                        </div>


                        <form asp-controller="CompanyPortal"
                              asp-action="UpdateName"
                              method="post">


                            @Html.AntiForgeryToken()


                            <div class="company-form-grid">


                                <div class="company-field">


                                    <label>
                                        Account Manager Name
                                    </label>


                                    <input type="text"
                                           name="fullName"
                                           value="@Model.FullName"
                                           maxlength="150"
                                           class="company-input"
                                           required />


                                </div>


                                <div class="company-field">


                                    <label>
                                        Email Address
                                    </label>


                                    <input type="email"
                                           value="@Model.Email"
                                           class="company-input"
                                           readonly />


                                </div>


                            </div>


                            <button type="submit"
                                    class="primary-button">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M12 20h9" />

                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" />

                                </svg>


                                Update Name

                            </button>


                        </form>


                    </div>


                    <!-- =================================
                         CHANGE PASSWORD
                    ================================== -->

                    <div class="dashboard-card"
                         id="change-password">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <rect x="4"
                                          y="10"
                                          width="16"
                                          height="11"
                                          rx="2" />

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                    <circle cx="12"
                                            cy="15"
                                            r="1" />

                                </svg>


                            </div>


                            <div>


                                <h3>
                                    Change Password
                                </h3>


                                <p>

                                    Use your current password
                                    to create a new secure password.

                                </p>


                            </div>


                        </div>


                        <form asp-controller="CompanyPortal"
                              asp-action="ChangePassword"
                              method="post"
                              id="changePasswordForm">


                            @Html.AntiForgeryToken()


                            <div class="password-grid">


                                <div class="company-field">


                                    <label>
                                        Current Password
                                    </label>


                                    <input type="password"
                                           name="currentPassword"
                                           class="company-password-input"
                                           autocomplete="current-password"
                                           required />


                                </div>


                                <div class="company-field">


                                    <label>
                                        New Password
                                    </label>


                                    <input type="password"
                                           name="newPassword"
                                           id="newPassword"
                                           class="company-password-input"
                                           minlength="6"
                                           autocomplete="new-password"
                                           required />


                                </div>


                                <div class="company-field">


                                    <label>
                                        Confirm New Password
                                    </label>


                                    <input type="password"
                                           name="confirmPassword"
                                           id="confirmPassword"
                                           class="company-password-input"
                                           minlength="6"
                                           autocomplete="new-password"
                                           required />


                                </div>


                            </div>


                            <div class="password-hint">

                                Use at least 6 characters.
                                Your new password must be different
                                from your current password.

                            </div>


                            <button type="submit"
                                    class="primary-button"
                                    id="changePasswordButton">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M12 20h9" />

                                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" />

                                </svg>


                                Change Password

                            </button>


                        </form>


                    </div>


                </div>


                <!-- =================================
                     RIGHT COLUMN
                ================================== -->

                <div>


                    <!-- =================================
                         RECRUITMENT
                    ================================== -->

                    <div class="dashboard-card">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <rect x="3"
                                          y="7"
                                          width="18"
                                          height="13"
                                          rx="2" />

                                    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                                </svg>


                            </div>


                            <div>


                                <h3>
                                    Recruitment
                                </h3>


                                <p>

                                    Manage jobs and
                                    candidate applications.

                                </p>


                            </div>


                        </div>


                        <div class="recruitment-grid">


                            <!-- POST JOB -->

                            <a asp-controller="CompanyJobs"
                               asp-action="Create"
                               class="recruitment-card">


                                <div class="recruitment-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <rect x="3"
                                              y="7"
                                              width="18"
                                              height="13"
                                              rx="2" />

                                        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                                        <path d="M12 11v5" />

                                        <path d="M9.5 13.5h5" />

                                    </svg>


                                </div>


                                <div>


                                    <strong>
                                        Post New Job
                                    </strong>


                                    <span>

                                        Create and publish
                                        a new vacancy.

                                    </span>


                                </div>


                                <div class="recruitment-arrow">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <path d="M5 12h14" />

                                        <path d="m13 6 6 6-6 6" />

                                    </svg>


                                </div>


                            </a>


                            <!-- MY JOB POSTS -->

                            <a asp-controller="CompanyJobs"
                               asp-action="Index"
                               class="recruitment-card">


                                <div class="recruitment-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <rect x="3"
                                              y="7"
                                              width="18"
                                              height="13"
                                              rx="2" />

                                        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                                        <path d="M3 12h18" />

                                    </svg>


                                </div>


                                <div>


                                    <strong>
                                        My Job Posts
                                    </strong>


                                    <span>

                                        View, close and manage
                                        your published jobs.

                                    </span>


                                </div>


                                <div class="recruitment-arrow">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <path d="M5 12h14" />

                                        <path d="m13 6 6 6-6 6" />

                                    </svg>


                                </div>


                            </a>


                            <!-- APPLICATIONS -->

                            <a asp-controller="CompanyApplications"
                               asp-action="Index"
                               class="recruitment-card">


                                <div class="recruitment-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                                        <circle cx="9"
                                                cy="7"
                                                r="4" />

                                        <path d="M19 8v6" />

                                        <path d="M22 11h-6" />

                                    </svg>


                                </div>


                                <div>


                                    <strong>
                                        Applications
                                    </strong>


                                    <span>

                                        Review applicants and
                                        update recruitment status.

                                    </span>


                                </div>


                                <div class="recruitment-arrow">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <path d="M5 12h14" />

                                        <path d="m13 6 6 6-6 6" />

                                    </svg>


                                </div>


                            </a>


                        </div>


                    </div>


                    <!-- =================================
                         ACCOUNT SUMMARY
                    ================================== -->

                    <div class="dashboard-card">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M4 5h16v14H4z" />

                                    <path d="M8 9h8" />

                                    <path d="M8 13h5" />

                                </svg>


                            </div>


                            <div>


                                <h3>
                                    Account Summary
                                </h3>


                                <p>

                                    Current company
                                    account information.

                                </p>


                            </div>


                        </div>


                        <div class="account-summary">


                            <!-- MANAGER -->

                            <div class="account-summary-row">


                                <div class="account-summary-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <circle cx="12"
                                                cy="8"
                                                r="4" />

                                        <path d="M4 21a8 8 0 0 1 16 0" />

                                    </svg>


                                </div>


                                <div class="account-summary-content">


                                    <span>
                                        Account Manager
                                    </span>


                                    <strong>
                                        @Model.FullName
                                    </strong>


                                </div>


                            </div>


                            <!-- EMAIL -->

                            <div class="account-summary-row">


                                <div class="account-summary-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <rect x="3"
                                              y="5"
                                              width="18"
                                              height="14"
                                              rx="2" />

                                        <path d="m3 7 9 6 9-6" />

                                    </svg>


                                </div>


                                <div class="account-summary-content">


                                    <span>
                                        Email
                                    </span>


                                    <strong>
                                        @Model.Email
                                    </strong>


                                </div>


                            </div>


                            <!-- COMPANY -->

                            <div class="account-summary-row">


                                <div class="account-summary-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <path d="M3 21h18" />

                                        <path d="M6 21V7l6-4 6 4v14" />

                                        <path d="M9 10h6" />

                                    </svg>


                                </div>


                                <div class="account-summary-content">


                                    <span>
                                        Company
                                    </span>


                                    <strong>
                                        @Model.Company.CompanyName
                                    </strong>


                                </div>


                            </div>


                            <!-- VERIFICATION -->

                            <div class="account-summary-row">


                                <div class="account-summary-icon">


                                    <svg viewBox="0 0 24 24"
                                         class="dash-icon-svg">

                                        <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z" />

                                        <path d="m9 12 2 2 4-5" />

                                    </svg>


                                </div>


                                <div class="account-summary-content">


                                    <span>
                                        Verification
                                    </span>


                                    <strong>
                                        @Model.Company.VerificationStatus
                                    </strong>


                                </div>


                            </div>


                        </div>


                    </div>


                    <!-- =================================
                         DANGER ZONE
                    ================================== -->

                    <div class="dashboard-card danger-card"
                         id="danger-zone">


                        <div class="dashboard-card-heading">


                            <div class="dashboard-heading-icon">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M12 3 2 21h20z" />

                                    <path d="M12 9v5" />

                                    <path d="M12 18h.01" />

                                </svg>


                            </div>


                            <div>


                                <h3>
                                    Danger Zone
                                </h3>


                                <p>

                                    Permanently disable your
                                    WorkHub company account.

                                </p>


                            </div>


                        </div>


                        <div class="danger-warning">


                            <svg viewBox="0 0 24 24"
                                 class="dash-icon-svg">

                                <circle cx="12"
                                        cy="12"
                                        r="9" />

                                <path d="M12 8v5" />

                                <path d="M12 17h.01" />

                            </svg>


                            <div>

                                Deleting your company account will
                                disable company access and close
                                your active job posts.

                                This action should only be used
                                when you no longer need the account.

                            </div>


                        </div>


                        <form asp-controller="CompanyPortal"
                              asp-action="DeleteAccount"
                              method="post"
                              id="deleteAccountForm">


                            @Html.AntiForgeryToken()


                            <div class="danger-field">


                                <label>
                                    Current Password
                                </label>


                                <input type="password"
                                       name="password"
                                       class="danger-input"
                                       autocomplete="current-password"
                                       required />


                            </div>


                            <div class="danger-field">


                                <label>
                                    Type DELETE to confirm
                                </label>


                                <input type="text"
                                       name="confirmation"
                                       id="deleteConfirmation"
                                       class="danger-input"
                                       placeholder="DELETE"
                                       autocomplete="off"
                                       required />


                            </div>


                            <button type="submit"
                                    class="delete-account-button"
                                    id="deleteAccountButton">


                                <svg viewBox="0 0 24 24"
                                     class="dash-icon-svg">

                                    <path d="M4 7h16" />

                                    <path d="M9 7V4h6v3" />

                                    <path d="M7 7l1 13h8l1-13" />

                                </svg>


                                Delete Company Account

                            </button>


                        </form>


                    </div>


                </div>


            </div>

        }
        else
        {

            <div class="profile-not-found">


                <div class="profile-not-found-icon">


                    <svg viewBox="0 0 24 24"
                         class="dash-icon-svg">

                        <path d="M3 21h18" />

                        <path d="M6 21V7l6-4 6 4v14" />

                        <path d="M9 10h6" />

                    </svg>


                </div>


                <h2>

                    Company Profile Not Found

                </h2>


                <p>

                    Your company profile information
                    could not be loaded.

                </p>


            </div>

        }


    </div>


</section>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {


                // =================================
                // PROFILE IMAGE PREVIEW
                // =================================

                const imageInput =
                    document.getElementById(
                        "profileImageInput"
                    );


                const currentPreview =
                    document.getElementById(
                        "profilePreviewImage"
                    );


                if (imageInput) {
                    imageInput.addEventListener(
                        "change",
                        function() {
                            const file =
                                this.files
                                    &&
                                    this.files.length > 0
                                    ? this.files[0]
                                    : null;


                            if (!file) {
                                return;
                            }


                            const allowedTypes =
                                [
                                    "image/jpeg",
                                    "image/png",
                                    "image/webp"
                                ];


                            if (
                                !allowedTypes.includes(
                                    file.type
                                )
                            ) {
                                alert(
                                    "Please select a JPG, PNG or WEBP image."
                                );


                                this.value =
                                    "";


                                return;
                            }


                            const maxSize =
                                5
                                *
                                1024
                                *
                                1024;


                            if (
                                file.size
                                >
                                maxSize
                            ) {
                                alert(
                                    "Profile picture must be 5 MB or smaller."
                                );


                                this.value =
                                    "";


                                return;
                            }


                            const reader =
                                new FileReader();


                            reader.onload =
                                function(event) {
                                    if (
                                        currentPreview
                                    ) {
                                        currentPreview.src =
                                            event.target.result;


                                        currentPreview.style.display =
                                            "block";
                                    }
                                    else {
                                        const container =
                                            document.querySelector(
                                                ".profile-preview"
                                            );


                                        if (!container) {
                                            return;
                                        }


                                        const preview =
                                            document.createElement(
                                                "img"
                                            );


                                        preview.src =
                                            event.target.result;


                                        preview.className =
                                            "profile-preview-image";


                                        preview.alt =
                                            "Profile preview";


                                        container.appendChild(
                                            preview
                                        );
                                    }
                                };


                            reader.readAsDataURL(
                                file
                            );
                        }
                    );
                }


                // =================================
                // REMOVE PROFILE PICTURE
                // =================================

                const removeImageForm =
                    document.getElementById(
                        "removeProfileImageForm"
                    );


                if (removeImageForm) {
                    removeImageForm.addEventListener(
                        "submit",
                        function(event) {
                            const confirmed =
                                confirm(
                                    "Remove your current company profile picture?"
                                );


                            if (!confirmed) {
                                event.preventDefault();
                            }
                        }
                    );
                }


                // =================================
                // PASSWORD VALIDATION
                // =================================

                const changePasswordForm =
                    document.getElementById(
                        "changePasswordForm"
                    );


                const newPassword =
                    document.getElementById(
                        "newPassword"
                    );


                const confirmPassword =
                    document.getElementById(
                        "confirmPassword"
                    );


                const changePasswordButton =
                    document.getElementById(
                        "changePasswordButton"
                    );


                if (
                    changePasswordForm
                    &&
                    newPassword
                    &&
                    confirmPassword
                ) {
                    changePasswordForm.addEventListener(
                        "submit",
                        function(event) {
                            if (
                                newPassword.value
                                !==
                                confirmPassword.value
                            ) {
                                event.preventDefault();


                                alert(
                                    "New password and confirmation password do not match."
                                );


                                return;
                            }


                            if (
                                changePasswordButton
                            ) {
                                changePasswordButton.disabled =
                                    true;


                                changePasswordButton.textContent =
                                    "Changing Password...";
                            }
                        }
                    );
                }


                // =================================
                // DELETE ACCOUNT
                // =================================

                const deleteForm =
                    document.getElementById(
                        "deleteAccountForm"
                    );


                const deleteConfirmation =
                    document.getElementById(
                        "deleteConfirmation"
                    );


                const deleteButton =
                    document.getElementById(
                        "deleteAccountButton"
                    );


                if (
                    deleteForm
                    &&
                    deleteConfirmation
                ) {
                    deleteForm.addEventListener(
                        "submit",
                        function(event) {
                            if (
                                deleteConfirmation.value
                                    .trim()
                                    .toUpperCase()
                                !==
                                "DELETE"
                            ) {
                                event.preventDefault();


                                alert(
                                    "Type DELETE to confirm account deletion."
                                );


                                return;
                            }


                            const confirmed =
                                confirm(
                                    "Are you sure you want to delete this company account? Your active jobs will be closed."
                                );


                            if (!confirmed) {
                                event.preventDefault();


                                return;
                            }


                            if (deleteButton) {
                                deleteButton.disabled =
                                    true;


                                deleteButton.textContent =
                                    "Deleting Account...";
                            }
                        }
                    );
                }


            }
        );

    </script>
}